{
  // Cloudflare Workers with static assets: the site is fully static (dist/). The Worker in
  // worker/index.ts runs only for /api/* (reader counts of Precrease posts, M3a.3); every other
  // request is served straight from the assets without touching it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crease-pattern",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // Totals per post only (worker/migrations). Created once with `wrangler d1 create`; see
  // docs/decisions/0007-reader-counts.md for the setup steps.
  "d1_databases": [
    {
      "binding": "READERS",
      "database_name": "crease-pattern-readers",
      "database_id": "31f3993f-976e-4821-ba05-065ca8e6e6c2",
      "migrations_dir": "worker/migrations",
    },
  ],
  // At most 30 counted events per visitor and post per minute. The key holds the IP only inside
  // the rate limiter, in memory; it is never written anywhere.
  "ratelimits": [
    {
      "name": "READER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
