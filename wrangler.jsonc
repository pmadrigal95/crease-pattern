{
  // Cloudflare Workers with static assets: the site is fully static (dist/),
  // Workers only kicks in later for small APIs (newsletter, view counts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crease-pattern",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
