---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { copyFor } from '../../lib/copy';
import { localeStaticPaths } from '../../lib/i18n';
const copy = copyFor(Astro.currentLocale);

const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('src/content/pages/privacy.mdx is missing.');
const { Content } = await render(page);

/** This page in every language: "/" and "/es" (src/lib/i18n.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PageLayout title={page.data.title} description={page.data.description}>
  <div class="wrap">
    <header class="page-head" data-inspect="privacy#header">
      <p class="eyebrow">{page.data.title}</p>
      <h1>{copy.privacyPage.title}</h1>
    </header>
    <div class="prose body" data-inspect="privacy#body">
      <Content />
    </div>
  </div>
</PageLayout>

<style>
  .body {
    padding-bottom: var(--space-24);
  }
</style>
