---
/**
 * Case studies (M6): one card per case in this language, jobs first, then the earlier roles in a
 * few lines each. Adding a case is adding a file to src/content/cases; this page, the home page,
 * ⌘K and the sitemap follow.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import CaseCard from '../../../components/work/CaseCard.astro';
import EarlierWork from '../../../components/work/EarlierWork.astro';
import { copyFor } from '../../../i18n/dictionary';
import { langOf, localeStaticPaths } from '../../../i18n/routing';
import { caseHref, caseMeta, caseSlug, getCases } from '../../../lib/cases';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang);
const t = copy.cases.index;
const cases = await getCases(lang);

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PageLayout title={t.title} description={t.description}>
  <div class="wrap">
    <header class="page-head" data-inspect="index#work-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
    </header>
    <div class="cases" data-inspect="index#work-list">
      {cases.map((c) => (
        <CaseCard
          href={caseHref(caseSlug(c), lang)}
          meta={caseMeta(c, t)}
          title={c.data.company}
          summary={c.data.summary}
          link={t.read}
          plates={c.data.kind === 'project' ? 0 : c.data.plates.length + 1}
        />
      ))}
    </div>
    <EarlierWork exclude={cases.map((c) => c.data.company)} />
  </div>
</PageLayout>

<style>
  .cases {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    padding-bottom: var(--space-16);
  }
</style>
