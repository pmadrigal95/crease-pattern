---
import PrecreaseLayout from '../../../layouts/PrecreaseLayout.astro';
import FoldTitle from '../../../components/precrease/FoldTitle.astro';
import PostThumb from '../../../components/precrease/PostThumb.astro';
import PostPiece from '../../../components/precrease/PostPiece.astro';
import PostBranches from '../../../components/precrease/PostBranches.astro';
import TopicChips from '../../../components/precrease/TopicChips.astro';
import { copyFor, fill } from '../../../i18n/dictionary';
import { formatCount, formatDate } from '../../../lib/format';
import { creaseNumber, getPosts, postHref, postKind } from '../../../lib/precrease';
import { readingMinutes } from '../../../lib/reading';
import { LOCALES, langOf, localeStaticPaths } from '../../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(Astro.currentLocale);

const t = copy.precrease;
const posts = await getPosts(lang);
const [featured, ...rest] = posts;
// The collection in words (doc 41): its order said, and what it holds; never a rank.
const c = t.collection;
const topicsUsed = new Set(posts.flatMap((p) => p.entry.data.topics)).size;
const oldest = posts.map((p) => p.date).toSorted((a, b) => a.getTime() - b.getTime())[0];
// Not yet in this page's language: the original shows, marked as such.
const featuredLang = featured && featured.lang !== lang ? LOCALES[featured.lang].htmlLang : undefined;

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PrecreaseLayout title={t.name} description={t.description} home>
  <div class="wrap">
    {featured && (
      <div class="filters">
        <TopicChips posts={posts} />
        <p class="series">
          <b>{c.order}</b>
          <span>{formatCount(posts.length, { one: c.postsOne, many: c.posts }, lang)}</span>
          <span>{formatCount(topicsUsed, { one: c.topicsOne, many: c.topics }, lang)}</span>
          {oldest && <span>{fill(c.since, { date: formatDate(oldest, lang) })}</span>}
        </p>
      </div>
    )}
    {featured ? (
      <section class="featured fold-host" aria-labelledby="featured-title">
        <div class="text">
          <PostBranches topics={featured.entry.data.topics} />
          <p class="kicker">
            {creaseNumber(featured.number, lang)} · {postKind(featured.entry, lang)} ·{' '}
            {fill(t.minutes, { minutes: readingMinutes(featured.entry.body ?? '') })}
            {featuredLang && <> · {t.untranslated}</>}
          </p>
          <FoldTitle
            text={featured.entry.data.title}
            href={postHref(featured)}
            id="featured-title"
            lang={featuredLang}
            as="h2"
            unfold="hover"
          />
          <p class="lede" lang={featuredLang}>
            {featured.entry.data.description}
          </p>
          <p class="date">
            <time datetime={featured.date.toISOString()}>{formatDate(featured.date, lang)}</time>
          </p>
        </div>
        <a class="thumb" href={postHref(featured)} tabindex="-1" aria-hidden="true">
          <PostThumb slug={featured.key} format={featured.entry.data.format} />
        </a>
      </section>
    ) : (
      <section class="empty">
        <p>{t.empty}</p>
      </section>
    )}

    {rest.length > 0 && (
      <section class="latest" aria-labelledby="latest-title">
        <h2 id="latest-title" class="sr-only">
          {t.latestHeading}
        </h2>
        <ul class="collection">
          {rest.map((post) => (
            <PostPiece post={post} />
          ))}
        </ul>
        <p class="origin-note">{c.origin}</p>
      </section>
    )}
  </div>
</PrecreaseLayout>

<style>
  .filters {
    padding-top: var(--space-8);
  }
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: end;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-16);
    border-bottom: 1px solid var(--color-rule);
  }
  .featured :global(.fold-title) {
    font-size: clamp(2.6rem, 6.5vw, 5.5rem);
  }
  .kicker,
  .date {
    font: var(--type-caption);
    color: var(--color-mute);
    margin: 0 0 var(--space-4);
  }
  .lede {
    max-width: 52ch;
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--size-lg);
    color: var(--color-mute);
  }
  .thumb {
    display: block;
  }
  .series {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-4) 0 0;
    font: 500 var(--size-xs) var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .series b {
    font-weight: 600;
    color: var(--color-ink);
  }
  .featured :global(.post-branches) {
    margin-bottom: var(--space-3);
  }
  .latest {
    padding-bottom: var(--space-24);
  }
  .collection {
    display: grid;
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-ink);
  }
  /* Inspecting: why no picture here is a file. */
  .origin-note {
    display: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    border-radius: 8px;
    background: var(--color-ink);
    color: var(--color-bg);
    font: 500 12px / 1.5 var(--font-mono);
  }
  :global(.inspecting) .origin-note {
    display: block;
  }
  .empty {
    padding-block: var(--space-12) var(--space-24);
    max-width: 52ch;
  }
  .empty p {
    font-size: var(--size-lg);
    color: var(--color-mute);
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .thumb {
      max-width: 320px;
    }
  }
</style>
