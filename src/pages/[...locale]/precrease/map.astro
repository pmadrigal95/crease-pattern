---
/**
 * The whole topic tree: first as one folded sheet (TopicSheet.astro, doc 41), then as a list in
 * which each branch is a <details> element, so it opens and closes without JavaScript and with
 * the keyboard. Counts include every post below a branch.
 */
import PrecreaseLayout from '../../../layouts/PrecreaseLayout.astro';
import { topicsFor, type Topic } from '../../../lib/taxonomy';
import TopicBranch, { type Branch } from '../../../components/precrease/TopicBranch.astro';
import TopicSheet from '../../../components/precrease/TopicSheet.astro';
import { copyFor } from '../../../i18n/dictionary';
import { getPosts } from '../../../lib/precrease';
import { childrenOf, postsUnder } from '../../../lib/precrease-tree';
import { langOf, localeStaticPaths } from '../../../i18n/routing';
const copy = copyFor(Astro.currentLocale);
const topics = topicsFor(langOf(Astro.currentLocale));

const t = copy.precrease;
const posts = await getPosts(langOf(Astro.currentLocale));

const grow = (parent: string | undefined): (Branch & Topic)[] =>
  childrenOf(topics, parent).map((topic) => ({
    ...topic,
    count: postsUnder(topics, posts, topic.id).length,
    children: grow(topic.id),
  }));
const tree = grow(undefined);

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PrecreaseLayout title={`${t.map.title} · ${t.name}`} description={t.map.description}>
  <div class="wrap">
    <header class="head">
      <h1>{t.map.title}</h1>
      <p class="intro">{t.map.intro}</p>
    </header>
    <TopicSheet topics={tree} posts={posts.length} />
    <h2 class="list-title">{t.sheet.listTitle}</h2>
    <ul class="tree">
      {tree.map((root) => (
        <TopicBranch branch={root}>
          <p class="topic-intro">{root.intro}</p>
        </TopicBranch>
      ))}
    </ul>
  </div>
</PrecreaseLayout>

<style>
  .head {
    padding-block: var(--space-12) var(--space-8);
  }
  h1 {
    margin: 0;
    font: 600 clamp(2.4rem, 6vw, 4.5rem) / 1 var(--font-serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 56ch;
    margin: var(--space-4) 0 0;
    font-size: var(--size-lg);
    color: var(--color-mute);
  }
  .list-title {
    margin: 0 0 var(--space-4);
    font-size: var(--size-lg);
    font-weight: 600;
  }
  .tree {
    margin: 0;
    padding: var(--space-6) 0 var(--space-24);
    list-style: none;
    border-top: var(--stroke-heavy) solid var(--color-accent);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-8) var(--space-6);
  }
  .tree > :global(li) {
    border-left: var(--stroke-crease) dashed var(--color-accent-ui);
    padding-left: var(--space-4);
  }
  .topic-intro {
    margin: var(--space-2) 0 0;
    font-size: var(--size-sm);
    color: var(--color-mute);
  }
</style>
