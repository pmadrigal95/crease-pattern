---
/**
 * How to follow Precrease, for readers who have never used RSS: the "Subscribe" link lands here
 * instead of on the raw feed, which a browser shows as XML. The feed as a ticket in the step that
 * asks for it, what a reader receives, and every topic's own feed (doc 41). The newsletter joins
 * this page in M8, with the domain (decision 49).
 */
import PrecreaseLayout from '../../../layouts/PrecreaseLayout.astro';
import FeedTicket from '../../../components/precrease/FeedTicket.astro';
import FeedPreview from '../../../components/precrease/FeedPreview.astro';
import TopicFeeds from '../../../components/precrease/TopicFeeds.astro';
import { copyFor } from '../../../i18n/dictionary';
import { langOf, localeStaticPaths } from '../../../i18n/routing';
import { feedHref } from '../../../lib/precrease-feed';
const copy = copyFor(Astro.currentLocale);

const t = copy.precrease.subscribe;
const feed = new URL(feedHref(langOf(Astro.currentLocale)), Astro.site).href;

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PrecreaseLayout title={`${t.title} · ${copy.precrease.name}`} description={t.description}>
  <div class="wrap" data-inspect="subscribe#page">
    <div class="page">
      <h1>{t.heading}</h1>
      <p class="intro">{t.intro}</p>

      <h2>{t.howTitle}</h2>
      <ol class="steps">
        <li>{t.steps.reader}</li>
        <li>
          {t.steps.add}
          <FeedTicket feed={feed} />
        </li>
        <li>{t.steps.done}</li>
      </ol>

      <p class="note">{t.email}</p>
    </div>
    <div class="more">
      <FeedPreview />
      <TopicFeeds />
    </div>
  </div>
</PrecreaseLayout>

<style>
  .page {
    max-width: 64ch;
    padding-block: var(--space-12);
  }
  h1 {
    margin: 0;
    font: 600 clamp(2rem, 5vw, 3rem) / 1.05 var(--font-serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
  }
  .intro {
    margin: var(--space-6) 0 0;
    font-size: var(--size-lg);
    color: var(--color-mute);
  }
  h2 {
    margin: var(--space-12) 0 var(--space-4);
    font-size: var(--size-lg);
    font-weight: 600;
  }
  .steps {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-left: var(--space-6);
  }
  .more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
    padding-bottom: var(--space-24);
  }
  @media (max-width: 900px) {
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .note {
    margin: var(--space-12) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
    color: var(--color-mute);
  }
</style>
