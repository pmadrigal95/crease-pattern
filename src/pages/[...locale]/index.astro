---
import site from '../../../site.config';
import PageLayout from '../../layouts/PageLayout.astro';
import AltitudeProfile from '../../components/site/AltitudeProfile.astro';
import Byline from '../../components/site/Byline.astro';
import CopyText from '../../components/site/CopyText.astro';
import HeroFold from '../../components/site/HeroFold.astro';
import HomePrecrease from '../../components/site/HomePrecrease.astro';
import WorkReadout from '../../components/site/WorkReadout.astro';
import WorkModel from '../../components/site/WorkModel.astro';
import HomeCases from '../../components/work/HomeCases.astro';
import { getProfile } from '../../lib/profile';
import { copyFor, fill } from '../../i18n/dictionary';
import manifest from '../../generated/inspector.json';
import { langOf, localeStaticPaths, localize } from '../../i18n/routing';
import '../../styles/buttons-quiet.css';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang);

const profile = await getProfile(Astro.currentLocale);
const home = copy.home;
const work = home.work;
const commit = manifest.commit.slice(0, 7);

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PageLayout
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.role}. ${profile.summary}`}
  image="/og/home.png"
  standalone
>
  <section class="hero" aria-labelledby="hero-title" data-inspect="index#hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Byline />
        <h1 id="hero-title">{home.hero.title}</h1>
        <p class="sub">{profile.summary}</p>
        <p class="cta">
          <button
            class="inspect btn-primary"
            type="button"
            aria-keyshortcuts="Shift+I"
            title={`${home.hero.inspect} (${copy.inspector.shortcut})`}
            data-inspector-open
          >
            {home.hero.inspect}
          </button>
          <a class="action" href={localize('/changelog', lang)}>
            {home.hero.releases}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      </div>
      <HeroFold />
    </div>
  </section>

  <section class="sec" id="work" aria-labelledby="work-title" data-inspect="index#work">
    <div class="wrap">
      <div class="work-head">
        <div>
          <p class="eyebrow">{work.eyebrow}</p>
          <h2 id="work-title">{work.heading}</h2>
          <p class="lead">{work.intro}</p>
        </div>
        <WorkModel />
      </div>
      <WorkReadout />
      <div class="source">
        <p>{fill(work.source, { commit })}</p>
        <p class="actions">
          <a class="action" href={localize('/colophon', lang)}>
            {work.links.colophon}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="action" href={site.repository}>
            {work.links.repo}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      </div>
      <HomeCases />
    </div>
  </section>

  <section class="sec" id="changelog" aria-labelledby="changelog-title" data-inspect="index#changelog">
    <div class="wrap">
      <h2 id="changelog-title">{home.changelog.heading}</h2>
      <p class="lead">{home.changelog.intro}</p>
      <AltitudeProfile />
      <p class="actions">
        <a class="action" href={localize('/changelog', lang)}>
          {home.changelog.full}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
  </section>

  <HomePrecrease />

  <section class="sec close" id="contact" aria-labelledby="contact-title" data-inspect="index#contact">
    <div class="wrap">
      <h2 id="contact-title">{home.contact.heading}</h2>
      <p class="line">{home.contact.intro}</p>
      <CopyText
        value={profile.contact.email}
        href={`mailto:${profile.contact.email}`}
        copyLabel={home.contact.copy}
        copiedLabel={home.contact.copied}
        failedLabel={home.contact.copyFailed}
      />
    </div>
  </section>
</PageLayout>

<script>
  // Self-contained (ENGINEERING.md, "Browser scripts"). Turns on the hero's surface texture after
  // load, when the browser is idle.
  const showSurface = () => document.documentElement.setAttribute('data-surface', '');
  addEventListener('load', () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(showSurface, { timeout: 2000 })
      : setTimeout(showSurface, 300),
  );
</script>

<style>
  /* Each identity's surface behind the hero (design debt fix 4): contour lines, basalt joints or
     washi fibers. The tiles come from public/textures/ (scripts/build-textures.ts), are tinted with
     the identity's own color, and fade out before they reach the text so contrast never changes.
     Decoration only, so it waits: the script below turns it on once the page has loaded and the
     browser is idle, keeping its download and painting out of the first render. */
  .hero {
    position: relative;
    isolation: isolate;
    --surface-tile: url('/textures/contours.svg');
    --surface-strength: 0.16;
  }
  :global(:root[data-direction='basalt-glacier']) .hero {
    --surface-tile: url('/textures/basalt.svg');
    --surface-strength: 0.13;
  }
  :global(:root[data-direction='washi-asagi']) .hero {
    --surface-tile: url('/textures/washi.svg');
    --surface-strength: 0.2;
  }
  :global(:root[data-surface]) .hero::before {
    content: '';
    animation: surface-in var(--motion-stage) var(--motion-ease-out) both;
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent-ui);
    opacity: var(--surface-strength);
    pointer-events: none;
    mask-image: var(--surface-tile), linear-gradient(to left, #000 25%, transparent 70%);
    mask-size:
      600px 600px,
      100% 100%;
    mask-repeat: repeat, no-repeat;
    mask-composite: intersect;
  }

  @keyframes surface-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-surface]) .hero::before {
      animation: none;
    }
  }

  /* Hero: the thesis on the left, the fox that proves it on the right (decision 50). */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16);
  }
  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .sub {
    max-width: 34ch;
    margin: var(--space-8) 0 0;
    font-size: var(--size-lg);
    line-height: 1.4;
    color: var(--color-mute);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    margin: var(--space-8) 0 0;
  }
  .inspect {
    min-height: 50px;
    padding: 0 var(--space-6);
    font-size: var(--size-md);
  }

  .sec {
    border-top: 1px solid var(--color-rule);
  }
  .sec .wrap {
    padding-block: var(--space-16);
  }
  .sec h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.875rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-weight: 600;
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .lead {
    color: var(--color-mute);
    max-width: 60ch;
    margin: 0 0 var(--space-8);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0 0;
  }

  /* Work: this site as a measured exhibit. */
  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-4) var(--space-12);
    align-items: center;
  }
  .work-head h2 {
    margin: 0;
  }
  .work-head .lead {
    max-width: 46ch;
    margin: var(--space-6) 0 0;
  }
  .eyebrow {
    margin: 0 0 var(--space-3);
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  .source > p:first-child {
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .source .actions {
    margin: 0;
  }

  /* Contact: one line and the address, not a closing headline (design debt phase 4). The serif
     is the one HomePrecrease loads; a system serif stands in until it arrives. */
  .close h2 {
    margin: 0 0 var(--space-2);
    font: 500 var(--size-xs) var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-mute);
  }
  .close .line {
    max-width: 30ch;
    margin: 0 0 var(--space-6);
    font:
      400 clamp(1.625rem, 3vw, 2.25rem) / 1.25 'Newsreader Home',
      'Iowan Old Style',
      'Palatino Linotype',
      Georgia,
      serif;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .work-head {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero-grid {
      padding-block: var(--space-12);
    }
    .hero-grid :global(.hero-fold) {
      max-width: 300px;
    }
  }
</style>
