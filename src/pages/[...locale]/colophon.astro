---
/**
 * The colophon as the site's technical sheet (doc 40): a title block about the build, the
 * sections as numbered sheets (Sheet.astro, from the MDX), and beside them the plan of the page,
 * which follows the reading. While inspecting, every sheet turns over to show its back.
 */
import { render } from 'astro:content';
import { getPage } from '../../lib/pages';
import PageLayout from '../../layouts/PageLayout.astro';
import TitleBlock from '../../components/site/TitleBlock.astro';
import ColophonPlan from '../../components/colophon/ColophonPlan.astro';
import { copyFor } from '../../i18n/dictionary';
import { langOf, localeStaticPaths } from '../../i18n/routing';
import { buildFacts } from '../../lib/build-facts';
import { getProfile } from '../../lib/profile';
import { formatDate } from '../../lib/format';
import '../../styles/colophon.css';

const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang);
const t = copy.colophonPage.block;
const page = await getPage('colophon', Astro.currentLocale);
const { Content, headings } = await render(page);
const sheets = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const profile = await getProfile(lang);
const facts = buildFacts();

/** This page in every language (src/i18n/routing.ts). */
export const getStaticPaths = localeStaticPaths;
---

<PageLayout title={page.data.title} description={page.data.description} image="/og/colophon.png">
  <div class="wrap">
    <header class="sheet-head" data-inspect="colophon#header">
      <div>
        <p class="eyebrow">{page.data.title}</p>
        <h1>{copy.colophonPage.title}</h1>
      </div>
      <TitleBlock
        label={t.label}
        rows={[
          { label: t.project, value: 'crease-pattern' },
          { label: t.author, value: profile.name },
          { label: t.version, value: facts.version },
          { label: t.built, value: formatDate(new Date(), lang) },
          { label: t.pages, value: '—', metric: 'html-pages' },
          { label: t.sheets, value: String(sheets.length) },
          { label: t.licences, value: t.licencesValue, wide: true },
        ]}
      />
    </header>
    <div class="sheet-layout">
      <div class="prose sheets" data-inspect="colophon#body">
        <Content />
      </div>
      <ColophonPlan sheets={sheets} />
    </div>
  </div>
</PageLayout>

<script>
  // The plan follows the reading: the region of the sheet crossing the middle of the view is
  // filled. Progressive: without it the plan still links to every sheet.
  const regions = [...document.querySelectorAll<SVGAElement>('[data-plan]')];
  const sheets = [...document.querySelectorAll<HTMLElement>('[data-sheet]')];
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const i = sheets.indexOf(e.target as HTMLElement);
        regions.forEach((r, k) => r.classList.toggle('on', k === i));
      }),
    { rootMargin: '-40% 0px -55% 0px' },
  );
  sheets.forEach((s) => spy.observe(s));
</script>
