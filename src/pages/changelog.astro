---
import PageLayout from '../layouts/PageLayout.astro';
import ExpeditionMap from '../components/site/ExpeditionMap.astro';
import ReleaseNotes from '../components/site/ReleaseNotes.astro';
import { copy } from '../lib/copy';

const page = copy.changelogPage;
---

<PageLayout title={page.title} description={page.description}>
  <div class="wrap">
    <header class="page-head" data-inspect="changelog#header">
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </header>
    <div class="map">
      <ExpeditionMap />
    </div>
    <div class="body">
      <ReleaseNotes />
    </div>
  </div>
</PageLayout>

<style>
  .map {
    margin-bottom: var(--space-16);
  }
  .body {
    padding-bottom: var(--space-24);
    max-width: 960px;
  }
</style>
