---
import PageLayout from '../layouts/PageLayout.astro';
import ReleaseNotes from '../components/site/ReleaseNotes.astro';
import { career, yearsSince } from '../lib/career';
import { copy, fill } from '../lib/copy';

const t = copy.home.changelog;
const years = fill(t.years, { years: yearsSince(career.vueSince) });
---

<PageLayout title={copy.changelogPage.title} description={copy.changelogPage.description}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">{years}</p>
      <h1>{copy.changelogPage.title}</h1>
      <p>{t.intro}</p>
    </header>
    <div class="body">
      <ReleaseNotes />
    </div>
  </div>
</PageLayout>

<style>
  .body {
    padding-bottom: var(--space-24);
    max-width: 960px;
  }
</style>
