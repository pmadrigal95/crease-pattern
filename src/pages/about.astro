---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getProfile } from '../lib/profile';
import { career, yearsSince } from '../lib/career';
import { copy, fill } from '../lib/copy';
import FoldedPortrait from '../components/site/FoldedPortrait.astro';
import silhouette from '../assets/portrait/silhouette.png?url';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.mdx is missing.');
const { Content } = await render(page);
const profile = await getProfile();
const t = copy.about;
const list = new Intl.ListFormat('en', { type: 'conjunction' });

// The side column holds the folded portrait (decision 41) and the facts.
const facts = [
  { term: t.facts.location, value: profile.location },
  { term: t.facts.role, value: profile.role },
  { term: t.facts.training, value: profile.training },
  { term: t.facts.vue, value: fill(t.vueYears, { years: yearsSince(career.vueSince) }) },
  { term: t.facts.languages, value: list.format(profile.languages) },
];
---

<PageLayout title={page.data.title} description={page.data.description}>
  <!-- In dark themes the portrait can't paint until its silhouette mask arrives; CSS finds it late. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={silhouette}
    type="image/png"
    media="(prefers-color-scheme: dark)"
  />
  <div class="wrap">
    <header class="page-head" data-inspect="about#header">
      <p class="eyebrow">{page.data.title}</p>
      <h1>{t.title}</h1>
    </header>
    <div class="grid">
      <div class="side">
        <FoldedPortrait />
        <aside aria-label={t.factsLabel}>
          <dl class="facts">
            {facts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
      <div class="prose" data-inspect="about#story">
        <Content />
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-16);
    align-items: start;
    padding-bottom: var(--space-24);
  }
  /* The side column comes first in the source, so focus reaches the portrait before the text
     on phones, where it also appears first (WCAG 2.4.3). On wide screens it moves right. */
  .side {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 84px;
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
  }
  .facts {
    margin: 0;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    padding: var(--space-2) var(--space-6);
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-rule);
  }
  .facts div:first-child {
    border-top: 0;
  }
  dt {
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  @media (max-width: 880px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    .side,
    .prose {
      grid-column: auto;
      grid-row: auto;
    }
    .side {
      position: static;
    }
  }
</style>
