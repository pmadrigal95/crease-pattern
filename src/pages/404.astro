---
import PageLayout from '../layouts/PageLayout.astro';
import NotFoundMap from '../components/site/NotFoundMap.astro';
import { copy } from '../lib/copy';

const t = copy.notFound;
---

<PageLayout title={t.title} description={t.body}>
  <div class="wrap nf">
    <div>
      <header class="page-head">
        <p class="eyebrow">404</p>
        <h1>{t.title}</h1>
        <p>{t.body}</p>
        <p class="aside">{t.aside}</p>
      </header>
      <p class="back">
        <a href="/">{t.action}</a>
      </p>
    </div>
    <NotFoundMap />
  </div>
</PageLayout>

<style>
  /* The words on one side, the map they're about on the other (design debt phase 4). */
  .nf {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-12) var(--space-24);
  }
  .aside {
    margin-top: var(--space-2);
  }
  .back {
    margin: 0;
  }
  @media (max-width: 860px) {
    .nf {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .back a {
    font-weight: 600;
    color: var(--color-accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
