---
/**
 * Act 3 of Crease No. 003: the same unit makes a 6-unit cube, a 12-unit star and a 30-unit star
 * (src/lib/sonobe/geometry.ts). "Units designed" stays at 1 while "units folded" grows.
 *
 * All three are drawn at the same paper size: a unit's square face is the cube's face, and it
 * folds along its diagonal over an edge of the stars, so their edges are √2 longer. The models
 * really do grow.
 *
 * Without JavaScript the three models stand side by side, drawn at build time. With it, CSS under
 * html[data-js] shows one at a time from the first paint, and the script redraws it as it turns.
 */
import { copy, fill } from '../../lib/copy';
import { assembly, project, type UnitCount } from '../../lib/sonobe/geometry';

const t = copy.precrease.sonobe.scale;
const MODELS: UnitCount[] = [6, 12, 30];
/** Same paper for every model: the stars' edges are a face's diagonal, √2 times the cube's edge. */
const SIZE: Record<UnitCount, number> = { 6: 1, 12: Math.SQRT2, 30: Math.SQRT2 };
const START = 30;
const PITCH = 0.42;
const rad = (deg: number) => (deg * Math.PI) / 180;

const draw = (n: UnitCount) =>
  project(assembly(n), rad(START), PITCH).map((f) => ({
    unit: f.unit % 5,
    points: f.points.map(([x, y]) => `${(x * SIZE[n]).toFixed(3)},${(y * SIZE[n]).toFixed(3)}`).join(' '),
    shade: (0.55 + 0.45 * f.light).toFixed(2),
  }));
---

<figure
  class="scale"
  data-sonobe-scale
  data-sizes={JSON.stringify(SIZE)}
  data-pitch={PITCH}
  data-inspect="ScaleDemo"
>
  <div class="picker" role="group" aria-label={t.label}>
    {MODELS.map((n, i) => (
      <button type="button" data-pick={n} aria-pressed={i === 0 ? 'true' : 'false'}>
        {fill(t.model, { count: n })}
      </button>
    ))}
  </div>

  <div class="models">
    {MODELS.map((n, i) => (
      <figure class={i === 0 ? 'model current' : 'model'} data-model={n}>
        <svg viewBox="-1.8 -1.8 3.6 3.6" role="img" aria-label={fill(t.model, { count: n })}>
          <g data-facets>
            {draw(n).map((f) => (
              <polygon class={`u${f.unit}`} points={f.points} fill-opacity={f.shade} />
            ))}
          </g>
        </svg>
        <figcaption>{fill(t.model, { count: n })}</figcaption>
      </figure>
    ))}
  </div>

  <label class="turn">
    <span>{t.turn}</span>
    <input type="range" min="0" max="359" step="1" value={START} data-turn />
  </label>

  <dl class="counts">
    <div>
      <dt>{t.designed}</dt>
      <dd>1</dd>
    </div>
    <div>
      <dt>{t.folded}</dt>
      <dd data-folded>{MODELS[0]}</dd>
    </div>
  </dl>

  <figcaption class="caption">{t.caption}</figcaption>
</figure>

<style>
  .scale {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-family: var(--font-sans);
  }
  .models {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .model {
    margin: 0;
  }
  .model figcaption {
    font: var(--type-caption);
    color: var(--color-mute);
    text-align: center;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin: 0 auto;
  }
  /* :global because the script draws new polygons, which don't carry Astro's scoping attribute. */
  .scale :global(polygon) {
    stroke: var(--color-surface);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  /* Five paper colors from the identity, so neighbouring units read apart. */
  .scale :global(.u0) {
    fill: var(--color-accent-ui);
  }
  .scale :global(.u1) {
    fill: color-mix(in oklab, var(--color-accent-ui) 55%, var(--color-ink));
  }
  .scale :global(.u2) {
    fill: color-mix(in oklab, var(--color-accent-ui) 45%, var(--color-bg));
  }
  .scale :global(.u3) {
    fill: var(--color-ink);
  }
  .scale :global(.u4) {
    fill: color-mix(in oklab, var(--color-ink) 45%, var(--color-bg));
  }
  /* The controls and counts only mean something with JavaScript; without it the three models
     stand side by side with their captions. */
  .picker,
  .turn,
  .counts {
    display: none;
  }
  .picker {
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .picker button {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-ink);
    font: 600 var(--size-sm) var(--font-sans);
    cursor: pointer;
  }
  .picker button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .picker button:focus-visible,
  .turn input:focus-visible {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 2px;
  }
  .turn {
    gap: var(--space-2);
    font-size: var(--size-sm);
  }
  .turn input {
    width: 100%;
    accent-color: var(--color-accent-ui);
  }
  .counts {
    gap: var(--space-8);
    margin: 0;
  }
  .counts dt {
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .counts dd {
    margin: 0;
    font: 600 var(--size-xl) var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .caption {
    font: var(--type-caption);
    color: var(--color-mute);
  }

  /* With JavaScript: one model at a time, with its controls, from the first paint. */
  :global(html[data-js]) .picker {
    display: flex;
  }
  :global(html[data-js]) .turn {
    display: grid;
  }
  :global(html[data-js]) .counts {
    display: flex;
  }
  :global(html[data-js]) .models {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(html[data-js]) .model:not(.current) {
    display: none;
  }
  :global(html[data-js]) .model figcaption {
    display: none;
  }

  @media (max-width: 640px) {
    .models {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { assembly, project, type UnitCount } from '../../lib/sonobe/geometry';

  const SVG = 'http://www.w3.org/2000/svg';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sonobe-scale]')) {
    const sizes = JSON.parse(root.dataset.sizes ?? '{}') as Record<string, number>;
    const pitch = Number(root.dataset.pitch ?? 0.4);
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const models = [...root.querySelectorAll<HTMLElement>('[data-model]')];
    const turn = root.querySelector<HTMLInputElement>('[data-turn]')!;
    const folded = root.querySelector<HTMLElement>('[data-folded]')!;
    let units = Number(buttons[0]?.dataset.pick ?? 6) as UnitCount;

    const redraw = () => {
      const model = models.find((m) => Number(m.dataset.model) === units)!;
      const group = model.querySelector('[data-facets]')!;
      const size = sizes[units] ?? 1;
      const facets = project(assembly(units), (Number(turn.value) * Math.PI) / 180, pitch);
      group.replaceChildren(
        ...facets.map((f) => {
          const polygon = document.createElementNS(SVG, 'polygon');
          polygon.setAttribute('class', `u${f.unit % 5}`);
          polygon.setAttribute('points', f.points.map(([x, y]) => `${x * size},${y * size}`).join(' '));
          polygon.setAttribute('fill-opacity', (0.55 + 0.45 * f.light).toFixed(2));
          return polygon;
        }),
      );
    };

    for (const button of buttons)
      button.addEventListener('click', () => {
        units = Number(button.dataset.pick) as UnitCount;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        models.forEach((m) => m.classList.toggle('current', Number(m.dataset.model) === units));
        folded.textContent = String(units);
        redraw();
      });
    turn.addEventListener('input', redraw);
  }
</script>
