---
/**
 * Act 5 of Crease No. 003: make one unit "special, just for this place" and the 12-unit model no
 * longer closes (geometry.ts, displace). Beside it, this site's own example: FoldTitle's `unfold`
 * prop and the two places that use it, one value each, read from the code at build time.
 *
 * Both states are drawn at build time; the script only flips one attribute, so no geometry ships
 * to the browser. Without JavaScript both states show, captioned.
 */
import foldTitleSource from '../precrease/FoldTitle.astro?raw';
import usage from '../../generated/components.json';
import site from '../../../site.config';
import { copy } from '../../lib/copy';
import { assembly, displace, project } from '../../lib/sonobe/geometry';

const t = copy.precrease.sonobe.exception;
const YAW = 0.55;
const PITCH = 0.4;
const SIZE = Math.SQRT2;
const model = assembly(12);
// The special unit: the one facing the reader most directly, so its gap is easy to see.
const facing = project(model, YAW, PITCH);
const special = facing.reduce((best, f) => (f.light > best.light ? f : best), facing[0]!).unit;
const draw = (m: typeof model) =>
  project(m, YAW, PITCH).map((f) => ({
    special: f.unit === special,
    tone: f.unit % 4,
    points: f.points.map(([x, y]) => `${(x * SIZE).toFixed(3)},${(y * SIZE).toFixed(3)}`).join(' '),
    shade: (0.6 + 0.4 * f.light).toFixed(2),
  }));
const states = [
  { id: 'closed', facets: draw(model), caption: t.closedFigure },
  { id: 'open', facets: draw(displace(model, special, 0.22)), caption: t.openFigure },
];

// FoldTitle's prop, and the value each place that uses it picks (components.json records the
// string props each use passes; components never read pages directly, per the layer rule).
const propLine = /^\s*unfold\?:.*$/m.exec(foldTitleSource)?.[0].trim() ?? '';
type Use = { file: string; props?: Record<string, string[]> };
const foldTitle = usage.components.find((c) => c.name === 'FoldTitle');
const usages = ((foldTitle?.usedIn ?? []) as Use[])
  .filter((u) => u.props?.unfold)
  .map((u) => ({ file: u.file, line: u.props!.unfold!.map((v) => `unfold="${v}"`).join(' ') }))
  .sort((a, b) => a.line.localeCompare(b.line));
const fileHref = `${site.repository}/blob/main/src/components/precrease/FoldTitle.astro`;
---

<figure
  class="exception"
  data-exception
  data-special="false"
  data-strings={JSON.stringify({ closed: t.closed, open: t.open })}
  data-inspect="ExceptionUnit"
>
  <div class="layout">
    <div class="models">
      {states.map((s) => (
        <figure class={`state ${s.id}`}>
          <svg viewBox="-1.6 -1.6 3.2 3.2" role="img" aria-label={s.caption}>
            {s.facets.map((f) => (
              <polygon
                class={f.special ? 'special' : `t${f.tone}`}
                points={f.points}
                fill-opacity={f.shade}
              />
            ))}
          </svg>
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="side">
      <dl class="meter">
        <div>
          <dt>{t.variants}</dt>
          <dd>
            <span class="when-closed">1</span>
            <span class="when-open">2</span>
          </dd>
        </div>
        <div>
          <dt>{t.checks}</dt>
          <dd>
            <span class="when-closed">1</span>
            <span class="when-open">2</span>
          </dd>
        </div>
      </dl>
      <pre><code><span class="line">{propLine}</span>{usages.map((u) => (
        <span class="line usage">{u.line}<span class="where">  {u.file.split('/').pop()}</span></span>
      ))}</code></pre>
      <p class="note">
        {t.code} <a href={fileHref}>{t.file}</a>
      </p>
    </div>
  </div>

  <label class="toggle">
    <input type="checkbox" data-special-toggle />
    <span>{t.toggle}</span>
  </label>
  <p class="status" data-status aria-live="polite">
    {t.closed}
  </p>
</figure>

<style>
  .exception {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-family: var(--font-sans);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .models {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .state {
    margin: 0;
  }
  .state figcaption {
    font: var(--type-caption);
    color: var(--color-mute);
    text-align: center;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin: 0 auto;
  }
  polygon {
    stroke: var(--color-surface);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .t0 {
    fill: var(--color-ink);
  }
  .t1 {
    fill: color-mix(in oklab, var(--color-ink) 55%, var(--color-bg));
  }
  .t2 {
    fill: color-mix(in oklab, var(--color-ink) 75%, var(--color-bg));
  }
  .t3 {
    fill: color-mix(in oklab, var(--color-ink) 35%, var(--color-bg));
  }
  /* The special unit, in the accent, outlined so it reads as the odd one out. */
  .special {
    fill: var(--color-accent-ui);
    stroke: var(--color-ink);
    stroke-width: 1.5px;
    stroke-dasharray: 3 2;
  }
  .meter {
    display: flex;
    gap: var(--space-8);
    margin: 0 0 var(--space-4);
  }
  .meter dt {
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .meter dd {
    margin: 0;
    font: 600 var(--size-xl) var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  pre {
    overflow-x: auto;
    margin: 0;
    padding: var(--space-4);
    border-radius: 12px;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font: var(--size-sm) / 1.6 var(--font-mono);
  }
  .line {
    display: block;
  }
  .where {
    color: var(--color-mute);
  }
  .note {
    margin: var(--space-2) 0 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .note a {
    color: var(--color-ink);
  }
  .toggle,
  .status {
    display: none;
  }
  .toggle {
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--size-sm);
    cursor: pointer;
  }
  .toggle input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-accent-ui);
  }
  .toggle input:focus-visible {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 2px;
  }
  .status {
    margin: 0;
    font-size: var(--size-sm);
  }

  /* Without JavaScript both models show, captioned, and the meter reads "1 / 2" per state through
     the captions; with it, one model at a time and the meter follows the toggle. */
  .meter .when-open::before {
    content: ' → ';
    color: var(--color-mute);
  }
  :global(html[data-js]) .meter .when-open::before {
    content: none;
  }
  :global(html[data-js]) .toggle {
    display: inline-flex;
  }
  :global(html[data-js]) .status {
    display: block;
  }
  :global(html[data-js]) .models {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(html[data-js]) .state figcaption {
    display: none;
  }
  :global(html[data-js]) [data-special='false'] .state.open,
  :global(html[data-js]) [data-special='true'] .state.closed,
  :global(html[data-js]) [data-special='false'] .when-open,
  :global(html[data-js]) [data-special='true'] .when-closed {
    display: none;
  }

  @media (max-width: 640px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-exception]')) {
    const t = JSON.parse(root.dataset.strings ?? '{}') as { closed: string; open: string };
    const toggle = root.querySelector<HTMLInputElement>('[data-special-toggle]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    toggle.addEventListener('change', () => {
      root.dataset.special = String(toggle.checked);
      status.textContent = toggle.checked ? t.open : t.closed;
    });
  }
</script>
