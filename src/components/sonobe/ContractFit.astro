---
/**
 * Act 2 of Crease No. 003: two units join only when a tab goes into a pocket. A schematic, not a
 * folding diagram: the left unit's tab slides into the right unit's pocket and they lock. Give the
 * tab one more prop and it grows wider than the pocket's mouth, so it stops there.
 *
 * The same drawing appears three times: the live one, and two fixed ones ("fits" and "doesn't
 * fit") for readers without JavaScript. CSS under html[data-js] picks which show from the first
 * paint. The script only flips two attributes; the motion is a CSS transform, and reduced motion
 * turns it off.
 */
import { copy } from '../../lib/copy';

const t = copy.precrease.sonobe.contract;
const figures = [
  { kind: 'live', state: 'apart', extra: 'false', caption: '' },
  { kind: 'still', state: 'joined', extra: 'false', caption: t.fitsFigure },
  { kind: 'still', state: 'joined', extra: 'true', caption: t.noFitFigure },
];
---

<figure
  class="contract"
  data-contract
  data-strings={JSON.stringify({
    join: t.join,
    apart: t.apart,
    apartStatus: t.apartStatus,
    fits: t.fits,
    noFit: t.noFit,
  })}
  data-inspect="ContractFit"
>
  {figures.map((f) => (
    <figure class={`drawing ${f.kind}`} data-state={f.state} data-extra={f.extra}>
      <svg viewBox="0 0 10 4" role="img" aria-label={f.caption || t.label}>
        <g class="left">
          <polygon class="face" points="0.5,1 3,1 3,3 0.5,3" />
          <polygon class="tab narrow" points="3,1.3 3,2.7 4.4,2" />
          <polygon class="tab wide" points="3,0.75 3,3.25 4.4,2" />
        </g>
        <g class="right">
          <polygon class="face" points="5,1 8,1 8,3 5,3" />
          <polygon class="tab" points="8,1.3 8,2.7 9.4,2" />
          <line class="pocket" x1="5" y1="1.3" x2="5" y2="2.7" />
        </g>
      </svg>
      {f.caption && <figcaption>{f.caption}</figcaption>}
    </figure>
  ))}

  <div class="controls">
    <button type="button" data-join>
      {t.join}
    </button>
    <label class="extra">
      <input type="checkbox" data-extra-toggle />
      <span>{t.extra}</span>
    </label>
  </div>
  <p class="status" data-status aria-live="polite">
    {t.apartStatus}
  </p>
</figure>

<style>
  .contract {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-family: var(--font-sans);
  }
  .drawing {
    margin: 0;
  }
  .drawing figcaption {
    font: var(--type-caption);
    color: var(--color-mute);
  }
  svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
  }
  .face,
  .tab {
    stroke: var(--color-ink);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .face {
    fill: color-mix(in oklab, var(--color-accent-ui) 45%, var(--color-bg));
  }
  /* The right unit's face lies over the tab once it's in the pocket; slightly see-through so the
     tab still reads inside it. */
  .right .face {
    fill-opacity: 0.85;
  }
  .tab {
    fill: color-mix(in oklab, var(--color-accent-ui) 22%, var(--color-bg));
  }
  .pocket {
    stroke: var(--color-accent-ui);
    stroke-width: 4px;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }
  .wide,
  [data-extra='true'] .narrow {
    display: none;
  }
  [data-extra='true'] .wide {
    display: inline;
  }
  [data-extra='true'] .pocket {
    stroke: var(--color-mute);
    stroke-dasharray: 3 3;
  }
  .left {
    transition: transform var(--motion-stage) var(--motion-ease-out);
  }
  /* SVG user units: 2 brings the tab's base to the pocket's mouth, so the whole tab is inside. */
  [data-state='joined'] .left {
    transform: translateX(2px);
  }
  /* A wider tab gets only its tip past the mouth. */
  [data-state='joined'][data-extra='true'] .left {
    transform: translateX(0.8px);
  }

  .controls {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .controls button {
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-bg);
    font: 600 var(--size-sm) var(--font-sans);
    cursor: pointer;
  }
  .controls button:focus-visible,
  .extra input:focus-visible {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 2px;
  }
  .extra {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--size-sm);
    cursor: pointer;
  }
  .extra input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-accent-ui);
  }
  .status {
    display: none;
    margin: 0;
    font-size: var(--size-sm);
  }

  /* Without JavaScript: the two fixed drawings. With it: the live one and its controls. */
  .live {
    display: none;
  }
  :global(html[data-js]) .live {
    display: block;
  }
  :global(html[data-js]) .still {
    display: none;
  }
  :global(html[data-js]) .controls {
    display: flex;
  }
  :global(html[data-js]) .status {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .left {
      transition: none;
    }
  }
</style>

<script>
  type Strings = { join: string; apart: string; apartStatus: string; fits: string; noFit: string };

  for (const root of document.querySelectorAll<HTMLElement>('[data-contract]')) {
    const t = JSON.parse(root.dataset.strings ?? '{}') as Strings;
    const live = root.querySelector<HTMLElement>('.live')!;
    const join = root.querySelector<HTMLButtonElement>('[data-join]')!;
    const extra = root.querySelector<HTMLInputElement>('[data-extra-toggle]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    const render = () => {
      const joined = live.dataset.state === 'joined';
      live.dataset.extra = String(extra.checked);
      join.textContent = joined ? t.apart : t.join;
      status.textContent = !joined ? t.apartStatus : extra.checked ? t.noFit : t.fits;
    };
    join.addEventListener('click', () => {
      live.dataset.state = live.dataset.state === 'joined' ? 'apart' : 'joined';
      render();
    });
    extra.addEventListener('change', render);
  }
</script>
