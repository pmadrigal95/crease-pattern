---
/** Case figure "review" (CaseFigure.astro): a proposed change, the AI reviewer following the team's criteria, then the team's review. Wide and tall drawings. */
interface Props {
  labels: Record<string, string>;
  description: string;
}
const { labels, description } = Astro.props;
const l = (key: string): string => {
  const text = labels[key];
  if (text === undefined) throw new Error(`Case figure "review" needs the label "${key}"`);
  return text;
};
---

<svg class="dg wide" viewBox="0 0 480 250" role="img" aria-label={description}>
  <rect class="s-goal box" x="10" y="96" width="100" height="56" rx="6" />
  <text class="lbl" x="60" y="121" text-anchor="middle">
    {l('change')}
  </text>
  <text class="small" x="60" y="138" text-anchor="middle">
    {l('proposed')}
  </text>
  <path class="ln key" d="M110 124 H164 M158 118 L164 124 L158 130" />
  <rect class="box key fillkey" x="170" y="88" width="132" height="72" rx="6" />
  <text class="lbl" x="236" y="118" text-anchor="middle">
    {l('reviewer')}
  </text>
  <text class="small" x="236" y="136" text-anchor="middle">
    {l('first')}
  </text>
  <path class="box soft" d="M200 20 h64 l12 12 v40 h-76z" />
  <text x="238" y="52" text-anchor="middle">
    {l('criteria')}
  </text>
  <path class="ln soft valley" d="M236 72 V88" />
  <text class="small" x="290" y="42">
    {l('team')}
  </text>
  <path class="ln key" d="M302 124 H356 M350 118 L356 124 L350 130" />
  <rect class="s-result box" x="362" y="96" width="108" height="56" rx="6" />
  <text class="lbl" x="416" y="121" text-anchor="middle">
    {l('review')}
  </text>
  <text class="small" x="416" y="138" text-anchor="middle">
    {l('byTeam')}
  </text>
  <path class="s-result dim" d="M110 200 H356 M110 195 V205 M356 195 V205" />
  <text class="dimt" x="233" y="222" text-anchor="middle">
    {l('minutes')}
  </text>
</svg>
<svg class="dg tall" viewBox="0 0 320 330" role="img" aria-label={description}>
  <rect class="s-goal box" x="70" y="16" width="160" height="50" rx="6" />
  <text class="lbl" x="150" y="38" text-anchor="middle">
    {l('change')}
  </text>
  <text class="small" x="150" y="55" text-anchor="middle">
    {l('proposed')}
  </text>
  <path class="ln key" d="M150 66 V92 M144 86 L150 92 L156 86" />
  <rect class="box key fillkey" x="60" y="98" width="180" height="60" rx="6" />
  <text class="lbl" x="150" y="124" text-anchor="middle">
    {l('reviewer')}
  </text>
  <text class="small" x="150" y="142" text-anchor="middle">
    {l('first')}
  </text>
  <text class="small" x="150" y="182" text-anchor="middle">{`${l('criteria')} · ${l('team')}`}</text>
  <path class="ln key" d="M150 194 V222 M144 216 L150 222 L156 216" />
  <rect class="s-result box" x="70" y="228" width="160" height="50" rx="6" />
  <text class="lbl" x="150" y="250" text-anchor="middle">
    {l('review')}
  </text>
  <text class="small" x="150" y="267" text-anchor="middle">
    {l('byTeam')}
  </text>
  <path class="s-result dim" d="M270 41 V253 M265 41 H275 M265 253 H275" />
  <text class="dimt" x="292" y="147" text-anchor="middle" transform="rotate(-90 292 147)">
    {l('minutes')}
  </text>
</svg>
