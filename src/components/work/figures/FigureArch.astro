---
/** Case figure "arch" (CaseFigure.astro): the applications, their shared foundation, and one application cut into its three layers. Wide and tall drawings. */
interface Props {
  labels: Record<string, string>;
  description: string;
}
const { labels, description } = Astro.props;
const l = (key: string): string => {
  const text = labels[key];
  if (text === undefined) throw new Error(`Case figure "arch" needs the label "${key}"`);
  return text;
};
---

<svg class="dg wide" viewBox="0 0 640 330" role="img" aria-label={description}>
  {[20, 180, 340, 500].map((x) => (
    <>
      <rect class="s-goal box" x={x} y="24" width="120" height="48" rx="6" />
      <text class="lbl" x={x + 60} y="53" text-anchor="middle">
        {l('app')}
      </text>
    </>
  ))}
  <path class="ln key" d="M140 48 H180 M300 48 H340 M460 48 H500" />
  <path class="ln key" d="M80 72 V104 H560 V72 M240 72 V104 M400 72 V104 M320 104 V116" />
  <rect class="box key fillkey" x="200" y="116" width="240" height="44" rx="6" />
  <text class="lbl" x="320" y="143" text-anchor="middle">
    {l('shared')}
  </text>
  <text class="dimt" x="320" y="16" text-anchor="middle">
    {l('talk')}
  </text>
  <text class="small" x="20" y="198">
    {l('inside')}
  </text>
  <rect class="s-result box" x="20" y="206" width="400" height="34" rx="6" />
  <text x="220" y="228" text-anchor="middle">
    {l('ui')}
  </text>
  <rect class="s-result box" x="20" y="246" width="400" height="34" rx="6" />
  <text x="220" y="268" text-anchor="middle">
    {l('rules')}
  </text>
  <rect class="s-result box" x="20" y="286" width="400" height="34" rx="6" />
  <text x="220" y="308" text-anchor="middle">
    {l('data')}
  </text>
  <path class="s-result dim" d="M440 206 V320 M435 206 H445 M435 320 H445" />
  <text class="dimt" x="452" y="268">
    {l('pattern')}
  </text>
</svg>
<svg class="dg tall" viewBox="0 0 320 390" role="img" aria-label={description}>
  <text class="dimt" x="160" y="14" text-anchor="middle">
    {l('talk')}
  </text>
  {[
    [20, 24],
    [170, 24],
    [20, 80],
    [170, 80],
  ].map(([x, y]) => (
    <>
      <rect class="s-goal box" x={x} y={y} width="130" height="40" rx="6" />
      <text class="lbl" x={(x ?? 0) + 65} y={(y ?? 0) + 25} text-anchor="middle">
        {l('app')}
      </text>
    </>
  ))}
  <path
    class="ln key"
    d="M150 44 H170 M150 100 H170 M85 64 V80 M235 64 V80 M85 120 V140 H235 V120 M160 140 V152"
  />
  <rect class="box key fillkey" x="60" y="152" width="200" height="40" rx="6" />
  <text class="lbl" x="160" y="177" text-anchor="middle">
    {l('shared')}
  </text>
  <text class="small" x="20" y="228">
    {l('inside')}
  </text>
  <rect class="s-result box" x="20" y="236" width="280" height="32" rx="6" />
  <text x="160" y="257" text-anchor="middle">
    {l('ui')}
  </text>
  <rect class="s-result box" x="20" y="274" width="280" height="32" rx="6" />
  <text x="160" y="295" text-anchor="middle">
    {l('rules')}
  </text>
  <rect class="s-result box" x="20" y="312" width="280" height="32" rx="6" />
  <text x="160" y="333" text-anchor="middle">
    {l('data')}
  </text>
  <path class="s-result dim" d="M20 362 H300 M20 357 V367 M300 357 V367" />
  <text class="dimt" x="160" y="382" text-anchor="middle">
    {l('pattern')}
  </text>
</svg>
