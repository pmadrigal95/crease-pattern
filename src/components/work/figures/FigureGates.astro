---
/** Case figure "gates" (CaseFigure.astro): a change through the site's checks, all read from one source, before it publishes itself; a failed check keeps it out. Wide and tall drawings. */
interface Props {
  labels: Record<string, string>;
  description: string;
}
const { labels, description } = Astro.props;
const l = (key: string): string => {
  const text = labels[key];
  if (text === undefined) throw new Error(`Case figure "gates" needs the label "${key}"`);
  return text;
};
const checks = ['tests', 'a11y', 'perf', 'weight'].map(l);
---

<svg class="dg wide" viewBox="0 0 480 300" role="img" aria-label={description}>
  <rect class="s-goal box" x="10" y="104" width="96" height="56" rx="6" />
  <text class="lbl" x="58" y="137" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M106 132 H150 M144 126 L150 132 L144 138" />
  {[56, 96, 136, 176].map((y, i) => (
    <>
      <rect class="box key" x="156" y={y} width="130" height="32" rx="6" />
      <text x="221" y={y + 21} text-anchor="middle">
        {checks[i]}
      </text>
    </>
  ))}
  <path class="dim" d="M156 36 H286 M156 31 V41 M286 31 V41" />
  <text class="dimt" x="221" y="24" text-anchor="middle">
    {l('source')}
  </text>
  <path class="ln key" d="M286 132 H322 M316 126 L322 132 L316 138" />
  <rect class="s-result box key fillkey" x="328" y="100" width="140" height="64" rx="6" />
  <text class="lbl" x="398" y="127" text-anchor="middle">
    {l('publish')}
  </text>
  <text class="small" x="398" y="145" text-anchor="middle">
    {l('auto')}
  </text>
  <path class="s-result ln soft valley" d="M221 208 C 221 258, 58 258, 58 164" />
  <text class="small" x="140" y="286" text-anchor="middle">
    {l('blocked')}
  </text>
</svg>
<svg class="dg tall" viewBox="0 0 320 380" role="img" aria-label={description}>
  <rect class="s-goal box" x="100" y="10" width="120" height="40" rx="6" />
  <text class="lbl" x="160" y="35" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M160 50 V78 M154 72 L160 78 L166 72" />
  <text class="dimt" x="172" y="68">
    {l('source')}
  </text>
  {[84, 118, 152, 186].map((y, i) => (
    <>
      <rect class="box key" x="60" y={y} width="200" height="28" rx="6" />
      <text x="160" y={y + 19} text-anchor="middle">
        {checks[i]}
      </text>
    </>
  ))}
  <path class="ln key" d="M160 214 V242 M154 236 L160 242 L166 236" />
  <rect class="s-result box key fillkey" x="80" y="248" width="160" height="52" rx="6" />
  <text class="lbl" x="160" y="271" text-anchor="middle">
    {l('publish')}
  </text>
  <text class="small" x="160" y="289" text-anchor="middle">
    {l('auto')}
  </text>
  <path class="s-result ln soft valley" d="M60 200 C 24 200, 24 30, 100 30" />
  <text class="small" x="160" y="340" text-anchor="middle">
    {l('blocked')}
  </text>
</svg>
