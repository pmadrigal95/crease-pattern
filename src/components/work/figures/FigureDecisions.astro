---
/** Case figure "decisions" (CaseFigure.astro): written decisions, a change, and the two levels it passes: rules enforced, AI suggesting. Wide and tall drawings. */
interface Props {
  labels: Record<string, string>;
  description: string;
}
const { labels, description } = Astro.props;
const l = (key: string): string => {
  const text = labels[key];
  if (text === undefined) throw new Error(`Case figure "decisions" needs the label "${key}"`);
  return text;
};
---

<svg class="dg wide" viewBox="0 0 480 250" role="img" aria-label={description}>
  <path class="box" d="M14 70 h72 l14 14 v96 h-86z" />
  <text class="lbl" x="57" y="120" text-anchor="middle">
    {l('decisions')}
  </text>
  <text class="small" x="57" y="138" text-anchor="middle">
    {l('written')}
  </text>
  <path class="ln soft" d="M100 125 H150" />
  <rect class="box" x="156" y="98" width="104" height="54" rx="6" />
  <text class="lbl" x="208" y="130" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M260 112 C 300 112, 300 70, 330 70" />
  <path class="ln soft valley" d="M260 138 C 300 138, 300 186, 330 186" />
  <rect class="box key fillkey" x="332" y="44" width="138" height="52" rx="6" />
  <text class="lbl" x="401" y="66" text-anchor="middle">
    {l('rules')}
  </text>
  <text class="small" x="401" y="83" text-anchor="middle">
    {l('enforced')}
  </text>
  <rect class="box soft" x="332" y="160" width="138" height="52" rx="6" />
  <text class="lbl" x="401" y="182" text-anchor="middle">
    {l('ai')}
  </text>
  <text class="small" x="401" y="199" text-anchor="middle">
    {l('suggests')}
  </text>
  <text class="dimt" x="400" y="238" text-anchor="middle">
    {l('levels')}
  </text>
</svg>
<svg class="dg tall" viewBox="0 0 320 300" role="img" aria-label={description}>
  <path class="box" d="M110 16 h86 l14 14 v60 h-100z" />
  <text class="lbl" x="160" y="52" text-anchor="middle">
    {l('decisions')}
  </text>
  <text class="small" x="160" y="70" text-anchor="middle">
    {l('written')}
  </text>
  <path class="ln soft" d="M160 90 V108" />
  <rect class="box" x="100" y="108" width="120" height="44" rx="6" />
  <text class="lbl" x="160" y="135" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M160 152 V170 H70 V190" />
  <path class="ln soft valley" d="M160 170 H250 V190" />
  <rect class="box key fillkey" x="10" y="190" width="120" height="54" rx="6" />
  <text class="lbl" x="70" y="213" text-anchor="middle">
    {l('rules')}
  </text>
  <text class="small" x="70" y="231" text-anchor="middle">
    {l('enforced')}
  </text>
  <rect class="box soft" x="190" y="190" width="120" height="54" rx="6" />
  <text class="lbl" x="250" y="213" text-anchor="middle">
    {l('ai')}
  </text>
  <text class="small" x="250" y="231" text-anchor="middle">
    {l('suggests')}
  </text>
  <text class="dimt" x="160" y="282" text-anchor="middle">
    {l('levels')}
  </text>
</svg>
