---
/** Case figure "deploy" (CaseFigure.astro): a change publishing itself through each application, adopted in stages with a way back. Wide and tall drawings. */
interface Props {
  labels: Record<string, string>;
  description: string;
}
const { labels, description } = Astro.props;
const l = (key: string): string => {
  const text = labels[key];
  if (text === undefined) throw new Error(`Case figure "deploy" needs the label "${key}"`);
  return text;
};
---

<svg class="dg wide" viewBox="0 0 480 300" role="img" aria-label={description}>
  <rect class="box" x="10" y="92" width="96" height="56" rx="6" />
  <text class="lbl" x="58" y="125" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M106 120 H150 M144 114 L150 120 L144 126" />
  {[40, 100, 160].map((y, i) => (
    <>
      <rect class="s-goal box" x="156" y={y} width="120" height="40" rx="6" />
      <text x="216" y={y + 25} text-anchor="middle">{`${l('app')} ${['1', '2', 'n'][i]}`}</text>
    </>
  ))}
  <path class="ln key" d="M276 120 H322 M316 114 L322 120 L316 126" />
  <rect class="box key fillkey" x="328" y="88" width="140" height="64" rx="6" />
  <text class="lbl" x="398" y="115" text-anchor="middle">
    {l('publish')}
  </text>
  <text class="small" x="398" y="133" text-anchor="middle">
    {l('auto')}
  </text>
  <path class="dim" d="M156 22 H276 M156 17 V27 M276 17 V27" />
  <text class="dimt" x="216" y="15" text-anchor="middle">
    {l('each')}
  </text>
  <path class="s-result ln soft valley" d="M60 262 H420" />
  <circle class="s-result dot" cx="80" cy="262" r="5" />
  <text class="small" x="80" y="288" text-anchor="middle">
    {l('pilot')}
  </text>
  <circle class="s-result dot soft" cx="250" cy="262" r="5" />
  <text class="small" x="250" y="288" text-anchor="middle">
    {l('oneByOne')}
  </text>
  <circle class="s-result dot soft" cx="420" cy="262" r="5" />
  <text class="small" x="420" y="288" text-anchor="middle">
    {l('all')}
  </text>
  <path class="s-result ln soft valley" d="M245 254 C 200 234, 130 234, 88 254" />
  <text class="small" x="166" y="228" text-anchor="middle">
    {l('back')}
  </text>
</svg>
<svg class="dg tall" viewBox="0 0 320 380" role="img" aria-label={description}>
  <text class="dimt" x="160" y="14" text-anchor="middle">
    {l('each')}
  </text>
  <rect class="box" x="100" y="24" width="120" height="40" rx="6" />
  <text class="lbl" x="160" y="49" text-anchor="middle">
    {l('change')}
  </text>
  <path class="ln key" d="M160 64 V84 M154 78 L160 84 L166 78" />
  {[90, 130, 170].map((y, i) => (
    <>
      <rect class="s-goal box" x="60" y={y} width="200" height="32" rx="6" />
      <text x="160" y={y + 21} text-anchor="middle">{`${l('app')} ${['1', '2', 'n'][i]}`}</text>
    </>
  ))}
  <path class="ln key" d="M160 202 V224 M154 218 L160 224 L166 218" />
  <rect class="box key fillkey" x="80" y="230" width="160" height="52" rx="6" />
  <text class="lbl" x="160" y="253" text-anchor="middle">
    {l('publish')}
  </text>
  <text class="small" x="160" y="271" text-anchor="middle">
    {l('auto')}
  </text>
  <path class="s-result ln soft valley" d="M30 340 H290" />
  <circle class="s-result dot" cx="40" cy="340" r="5" />
  <text class="small" x="40" y="364" text-anchor="middle">
    {l('pilot')}
  </text>
  <circle class="s-result dot soft" cx="160" cy="340" r="5" />
  <text class="small" x="160" y="364" text-anchor="middle">
    {l('oneByOne')}
  </text>
  <circle class="s-result dot soft" cx="280" cy="340" r="5" />
  <text class="small" x="280" y="364" text-anchor="middle">
    {l('all')}
  </text>
  <path class="s-result ln soft valley" d="M155 332 C 125 312, 75 312, 45 332" />
  <text class="small" x="100" y="306" text-anchor="middle">
    {l('back')}
  </text>
</svg>
