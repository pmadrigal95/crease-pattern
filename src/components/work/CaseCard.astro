---
/**
 * A case study's card (M6): in /work and on the home page. Editorial (portfolio-discovery/
 * 29-work-plan.md): the drawing large on top, the words under it. The drawing is the case's plates
 * seen from above, the lead one in accent, so every card says "a set of plates" without a picture;
 * for Pablo's own projects, a sheet with its crease. It folds when the card is hovered or focused:
 * the plates line up into one system, the sheet folds in half. The card takes the identity's
 * material, as the buttons do (src/styles/buttons.css).
 */
interface Props {
  href: string;
  meta: string;
  title: string;
  summary: string;
  link: string;
  /** How many plates the case has, the lead one first; 0 draws the site's own sheet instead (for Pablo's own projects). */
  plates: number;
  headingLevel?: 'h2' | 'h3';
}
const { href, meta, title, summary, link, plates, headingLevel: Heading = 'h2' } = Astro.props;
// The plates, from above: the lead one tall, the others alternately shorter (lined up on hover,
// every one as tall as the lead and on its baseline: CSS below).
const sheets = Array.from({ length: plates }, (_, i) => ({
  lead: i === 0,
  short: i > 0 && i % 2 === 1,
  x: 18 + i * 58,
  y: i === 0 ? 24 : 34 + (i % 2) * 14,
  height: i === 0 ? 92 : 72 - (i % 2) * 14,
}));
---

<a class="case-card" href={href} data-inspect="CaseCard">
  <svg class="thumb" viewBox="0 0 320 150" aria-hidden="true" focusable="false">
    {plates > 0 ? (
      sheets.map((s) => (
        <rect
          class:list={['sheet', { lead: s.lead, short: s.short }]}
          x={s.x}
          y={s.y}
          width="50"
          height={s.height}
          rx="3"
        />
      ))
    ) : (
      <>
        <path class="half" d="M40 128 L160 28 L160 128 Z" />
        <path class="half fold" d="M160 28 L280 128 L160 128 Z" />
      </>
    )}
  </svg>
  <div class="words">
    <p class="meta">{meta}</p>
    <Heading class="title">{title}</Heading>
    <p class="summary">{summary}</p>
    <span class="go">
      {link}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </span>
  </div>
</a>

<style>
  .case-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      transform var(--motion-base) var(--motion-ease-out),
      box-shadow var(--motion-base) var(--motion-ease-out);
  }
  .case-card:focus-visible {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 4px;
  }
  .thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    padding: 6% 10%;
    background: color-mix(in oklab, var(--color-accent-ui) 7%, var(--color-bg));
    border-bottom: 1px solid var(--color-rule);
  }
  .words {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-8) var(--space-8);
  }
  .meta {
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .summary {
    max-width: 40ch;
    margin: var(--space-1) 0 0;
    font-size: var(--size-md);
    color: var(--color-mute);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-4);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline 1px color-mix(in oklab, currentColor 40%, transparent);
    text-underline-offset: 5px;
  }
  .go .arrow {
    transition: translate var(--motion-base) var(--motion-ease-out);
  }

  /* The drawing. */
  .sheet {
    fill: var(--color-surface);
    stroke: var(--color-ink);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 520ms var(--motion-ease-out);
  }
  .sheet.lead {
    fill: color-mix(in oklab, var(--color-accent-ui) 14%, var(--color-surface));
    stroke: var(--color-accent-ui);
    stroke-width: 2;
  }
  .half {
    fill: color-mix(in oklab, var(--color-accent-ui) 6%, transparent);
    stroke: var(--color-mute);
    stroke-width: 1.5;
    stroke-dasharray: 10 4 2 4;
    transform-box: view-box;
    transform-origin: 160px 0;
    transition: transform 640ms var(--motion-ease-in-out);
  }
  .half.fold {
    fill: color-mix(in oklab, var(--color-accent-ui) 16%, transparent);
    stroke: var(--color-accent-ui);
  }

  /* Hovered or focused, the drawing folds: the plates line up on the lead's baseline (its bottom
     is 10 px lower) at its height (92 against 72, or 58 for the shorter ones), one after another;
     the sheet folds in half along its crease. */
  .case-card:is(:hover, :focus-visible) .sheet:not(.lead) {
    transform: translateY(10px) scaleY(1.278);
  }
  .case-card:is(:hover, :focus-visible) .sheet.short {
    transform: translateY(10px) scaleY(1.586);
  }
  .sheet:nth-child(3) {
    transition-delay: 45ms;
  }
  .sheet:nth-child(4) {
    transition-delay: 90ms;
  }
  .sheet:nth-child(5) {
    transition-delay: 135ms;
  }
  .case-card:is(:hover, :focus-visible) .half.fold {
    transform: scaleX(-1);
  }
  @media (hover: hover) {
    .case-card:hover .go .arrow {
      translate: 3px 0;
    }
  }

  /* The identity's material. Basalt & glacier, and the default: a plate that lifts. */
  .case-card {
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 1px 2px rgb(0 0 0 / 0.08),
      0 18px 36px -28px rgb(0 0 0 / 0.5);
  }
  @media (hover: hover) {
    .case-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--color-accent-ui) 50%, var(--color-rule)),
        0 4px 8px rgb(0 0 0 / 0.08),
        0 28px 48px -30px rgb(0 0 0 / 0.6);
    }
  }
  /* Washi & asagi: paper, with a crease down the middle of the drawing. */
  :global(:root[data-direction='washi-asagi']) .case-card {
    border-radius: 26px;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 20px 40px -32px rgb(0 0 0 / 0.6);
  }
  :global(:root[data-direction='washi-asagi']) .case-card:hover {
    transform: none;
  }
  :global(:root[data-direction='washi-asagi']) .thumb {
    background-image: linear-gradient(
      90deg,
      transparent calc(50% - 0.5px),
      color-mix(in oklab, var(--color-accent-ui) 35%, transparent) calc(50% - 0.5px) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }
  :global(:root[data-direction='washi-asagi']) .go {
    text-decoration-style: dashed;
  }
  /* Contour lines: a contour ring, and a second one on hover. */
  :global(:root[data-direction='contour-lines']) .case-card {
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-accent-ui) 45%, var(--color-rule));
  }
  :global(:root[data-direction='contour-lines']) .case-card:hover {
    transform: none;
    box-shadow:
      0 0 0 1px var(--color-accent-ui),
      0 0 0 6px var(--color-bg),
      0 0 0 7px color-mix(in oklab, var(--color-accent-ui) 30%, transparent);
  }
  :global(:root[data-direction='contour-lines']) .go {
    text-decoration-style: wavy;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card,
    .sheet,
    .half,
    .go .arrow {
      transition: none;
    }
  }
</style>
