---
/**
 * One plate of a case study (M6, direction D "plans + creases"): a sheet of plan paper with its
 * diagram drawn straight on the grid, three numbered notes (goal, approach, result, the result set
 * as the plate's conclusion) and one line naming the sheet. The lead plate spans the page, its
 * diagram above; the others alternate sides. The sheet arrives folded and unfolds as it comes into
 * view (the page's script); afterwards its crease lines stay faintly on the paper, valley dashed and
 * mountain dash-dot, like a sheet that was folded once. Without JavaScript, or with reduced motion,
 * it is simply open. The fold moves the sheet only, never the text's opacity, so a plate not yet
 * unfolded still reads at full contrast. Reading a note points at its part of the diagram
 * (data-step, case-figure.css); the legend is read once, above the plates ([slug].astro).
 */
import CaseFigure from './CaseFigure.astro';
import type { Case } from '../../lib/cases';
import { padNumber } from '../../lib/format';
import { fill } from '../../i18n/dictionary';

type Plate = Case['data']['plates'][number];
interface Props {
  plate: Plate;
  /** 1-based. */
  number: number;
  total: number;
  /** The diagram on the right instead of the left (every other plate after the lead). */
  flip: boolean;
  t: {
    lead: string;
    goal: string;
    approach: string;
    result: string;
    sheet: string;
  };
}
const { plate, number, total, flip, t } = Astro.props;
const steps = [
  { step: 'goal', label: t.goal, text: plate.goal },
  { step: 'approach', label: t.approach, text: plate.approach },
  { step: 'result', label: t.result, text: plate.result },
] as const;
---

<article
  class:list={['plate', { lead: plate.lead, flip }]}
  id={plate.id}
  aria-labelledby={`t-${plate.id}`}
  data-plate
  data-inspect="CasePlate"
>
  <svg class="creases" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="v" d="M0 50 H100 M100 0 L50 50 L100 100" />
    <path class="m" d="M0 0 L50 50 L0 100 M50 0 V100" />
  </svg>
  <div class="body">
    <div class="fig">
      <CaseFigure
        kind={plate.figure}
        labels={plate.labels}
        description={`${plate.title}. ${plate.practice}.`}
      />
    </div>
    <div class="text">
      <div class="title">
        <p class="sheet">
          {plate.lead && <span class="lead-tag">{t.lead}</span>}
          <span>
            {fill(t.sheet, { n: padNumber(number, 2), total: padNumber(total, 2) })} · {plate.practice}
          </span>
        </p>
        <h2 id={`t-${plate.id}`}>{plate.title}</h2>
      </div>
      <ol class="notes">
        {steps.map((s, i) => (
          <li class={s.step} data-step={s.step}>
            <span class="n" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <span class="k">{s.label}</span>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</article>

<style>
  .plate {
    position: relative;
    padding: var(--space-12) 40px;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(color-mix(in oklab, var(--color-rule) 45%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--color-rule) 45%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    /* Jumping from the local index leaves the plate below it, not under it. */
    scroll-margin-top: calc(var(--sticky-offset) + 64px);
  }
  .plate.lead {
    border: 1.5px solid var(--color-ink);
  }
  .creases {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .creases path {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .creases .v {
    stroke: var(--color-mute);
    stroke-dasharray: 6 5;
    opacity: 0.22;
  }
  .creases .m {
    stroke: var(--color-accent-ui);
    stroke-dasharray: 10 4 2 4;
    opacity: 0.28;
  }
  .body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .flip .fig {
    order: 2;
  }
  /* The lead plate spans the page: its diagram large above, the title and notes side by side below. */
  .lead .body {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .lead .fig {
    width: min(100%, 860px);
    margin-inline: auto;
  }
  .lead .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--space-12);
    align-items: start;
  }
  /* The diagram is drawn on the plate's own grid, not on a card laid over it. */
  .fig {
    min-width: 0;
  }
  .sheet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-3);
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .lead-tag {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-bg);
    font: 500 var(--size-xs) var(--font-mono);
  }
  h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.625rem, 2.6vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .lead h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .notes {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-2);
  }
  .notes p {
    margin: 0;
  }
  .n {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-rule);
    display: grid;
    place-items: center;
    font: 500 11px var(--font-mono);
    color: var(--color-mute);
    transition: border-color 200ms var(--motion-ease-out);
  }
  .notes li:hover .n {
    border-color: var(--color-accent-ui);
  }
  .k {
    display: block;
    margin-bottom: 2px;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  /* The result is the plate's conclusion: larger, on a rule of the accent. */
  .notes .result {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-accent-ui);
  }
  .result p {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .result .k {
    color: var(--color-accent);
  }
  .result .n {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  /* The fold: only when the page's script says the plate may move (JavaScript on, motion allowed). */
  :global(.plates.will-unfold) .plate {
    transform-origin: 50% 0;
    /* Only the sheet moves: its text keeps full contrast while it is still folded. */
    transform: perspective(1400px) rotateX(12deg);
    transition: transform var(--motion-stage) var(--motion-ease-out);
  }
  :global(.plates.will-unfold) .plate.unfolded {
    transform: none;
  }
  :global(.plates.will-unfold) .creases {
    opacity: 0;
    transition: opacity 800ms 500ms;
  }
  :global(.plates.will-unfold) .unfolded .creases {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .plate {
      padding: 20px;
      border-radius: 10px;
    }
    .body,
    .lead .body,
    .lead .text {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .flip .fig {
      order: 0;
    }
  }
</style>
