---
/**
 * One plate of a case study (M6, direction D "plans + creases"): a sheet of plan paper with its
 * diagram, three numbered notes (goal, approach, result, the result weighted most) and a title
 * block. The sheet arrives folded and unfolds as it comes into view (the page's script); afterwards
 * its crease lines stay faintly on the paper, valley dashed and mountain dash-dot, like a sheet
 * that was folded once. Without JavaScript, or with reduced motion, it is simply open. The fold
 * moves the sheet only, never the text's opacity, so a plate not yet unfolded still reads at full
 * contrast.
 */
import CaseFigure from './CaseFigure.astro';
import type { Case } from '../../lib/cases';
import { padNumber } from '../../lib/format';

type Plate = Case['data']['plates'][number];
interface Props {
  plate: Plate;
  /** 1-based. */
  number: number;
  total: number;
  company: string;
  t: {
    lead: string;
    goal: string;
    approach: string;
    result: string;
    project: string;
    plate: string;
    author: string;
    practice: string;
    valley: string;
    mountain: string;
    built: string;
  };
  author: string;
}
const { plate, number, total, company, t, author } = Astro.props;
---

<article
  class:list={['plate', { lead: plate.lead }]}
  id={plate.id}
  aria-labelledby={`t-${plate.id}`}
  data-plate
  data-inspect="CasePlate"
>
  <svg class="creases" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="v" d="M0 50 H100 M100 0 L50 50 L100 100" />
    <path class="m" d="M0 0 L50 50 L0 100 M50 0 V100" />
  </svg>
  <div class="body">
    <div class="fig">
      <CaseFigure
        kind={plate.figure}
        labels={plate.labels}
        description={`${plate.title}. ${plate.practice}.`}
      />
    </div>
    <div class="text">
      {plate.lead && <p class="lead-tag">{t.lead}</p>}
      <h2 id={`t-${plate.id}`}>{plate.title}</h2>
      <ol class="notes">
        <li>
          <span class="n" aria-hidden="true">
            1
          </span>
          <div>
            <span class="k">{t.goal}</span>
            {plate.goal}
          </div>
        </li>
        <li>
          <span class="n" aria-hidden="true">
            2
          </span>
          <div>
            <span class="k">{t.approach}</span>
            {plate.approach}
          </div>
        </li>
        <li class="result">
          <span class="n" aria-hidden="true">
            3
          </span>
          <div>
            <span class="k">{t.result}</span>
            {plate.result}
          </div>
        </li>
      </ol>
      <div class="cajetin">
        <dl>
          <div class="project">
            <dt>{t.project}</dt>
            <dd>
              {company} · {plate.short}
            </dd>
          </div>
          <div>
            <dt>{t.plate}</dt>
            <dd>
              {padNumber(number, 2)} / {padNumber(total, 2)}
            </dd>
          </div>
          <div>
            <dt>{t.author}</dt>
            <dd>{author}</dd>
          </div>
          <div class="practice">
            <dt>{t.practice}</dt>
            <dd>{plate.practice}</dd>
          </div>
        </dl>
        <p class="legend" aria-hidden="true">
          <span class="v">{t.valley}</span>
          <span class="m">{t.mountain}</span>
          <span class="k">{t.built}</span>
        </p>
      </div>
    </div>
  </div>
</article>

<style>
  .plate {
    position: relative;
    padding: var(--space-12) 40px;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(color-mix(in oklab, var(--color-rule) 45%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--color-rule) 45%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    /* Jumping from the local index leaves the plate below it, not under it. */
    scroll-margin-top: calc(var(--sticky-offset) + 64px);
  }
  .plate.lead {
    border: 1.5px solid var(--color-ink);
  }
  .creases {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .creases path {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .creases .v {
    stroke: var(--color-mute);
    stroke-dasharray: 6 5;
    opacity: 0.22;
  }
  .creases .m {
    stroke: var(--color-accent-ui);
    stroke-dasharray: 10 4 2 4;
    opacity: 0.28;
  }
  .body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .lead .body {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }
  .fig {
    padding: 20px;
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .lead-tag {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-bg);
    font: 500 var(--size-xs) var(--font-mono);
  }
  h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.625rem, 2.6vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .lead h2 {
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
  }
  .notes {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-2);
  }
  .n {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-rule);
    display: grid;
    place-items: center;
    font: 500 11px var(--font-mono);
    color: var(--color-mute);
  }
  .k {
    display: block;
    margin-bottom: 2px;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .result div {
    font-weight: 500;
  }
  .result .n {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }
  .cajetin {
    margin: var(--space-6) 0 0 auto;
    width: min(420px, 100%);
    border: 1px solid color-mix(in oklab, var(--color-ink) 35%, transparent);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-surface);
    font: 11px var(--font-mono);
  }
  .cajetin dl {
    display: grid;
    grid-template-columns: 1fr auto auto;
    margin: 0;
  }
  .cajetin dl > div {
    padding: 6px 10px;
    border-left: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
  }
  .cajetin dl > div:first-child {
    border-left: 0;
  }
  .cajetin dt {
    color: var(--color-mute);
    font-size: 9.5px;
  }
  .cajetin dd {
    margin: 0;
  }
  .cajetin .practice {
    grid-column: 1 / -1;
    border-left: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    padding: 6px 10px;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
    color: var(--color-mute);
  }
  .legend span::before {
    content: '';
    display: inline-block;
    width: 22px;
    margin-right: 6px;
    vertical-align: middle;
    border-top: 1.5px dashed var(--color-mute);
  }
  .legend .m::before {
    border-top-style: dotted;
    border-color: var(--color-accent-ui);
  }
  .legend .k::before {
    border-top: 2px solid var(--color-accent-ui);
  }

  /* The fold: only when the page's script says the plate may move (JavaScript on, motion allowed). */
  :global(.plates.will-unfold) .plate {
    transform-origin: 50% 0;
    /* Only the sheet moves: its text keeps full contrast while it is still folded. */
    transform: perspective(1400px) rotateX(12deg);
    transition: transform var(--motion-stage) var(--motion-ease-out);
  }
  :global(.plates.will-unfold) .plate.unfolded {
    transform: none;
  }
  :global(.plates.will-unfold) .creases {
    opacity: 0;
    transition: opacity 800ms 500ms;
  }
  :global(.plates.will-unfold) .unfolded .creases {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .plate {
      padding: 20px;
      border-radius: 10px;
    }
    .body,
    .lead .body {
      grid-template-columns: 1fr;
    }
    .cajetin dl {
      grid-template-columns: 1fr auto;
    }
    .cajetin .project {
      grid-column: 1 / -1;
      border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
    }
    .cajetin dl > div:nth-child(2) {
      border-left: 0;
    }
  }
</style>
