---
/**
 * One post in a Precrease list: its thumbnail, title and what kind of post it is, in words. No post
 * number here: a list can be filtered, and a lone number would read like a rank, a series part or a
 * book's chapter. The number ("Crease No. 003") lives in the post's own header, labelled.
 */
import PostThumb from './PostThumb.astro';
import { copyFor, fill } from '../../i18n/dictionary';
import { formatDate } from '../../lib/format';
import { postHref, postKind, type PostSummary } from '../../lib/precrease';
import { readingMinutes } from '../../lib/reading';
import { LOCALES, langOf } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(Astro.currentLocale);

interface Props {
  post: PostSummary;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: Heading = 'h2' } = Astro.props;
const { data } = post.entry;
const t = copy.precrease;
// A post with no edition in this page's language yet shows its original, marked as such.
const otherLang = post.lang === lang ? undefined : LOCALES[post.lang].htmlLang;
---

<article class="post-card" data-inspect="PostCard">
  <a href={postHref(post)} class="link">
    <PostThumb slug={post.key} format={data.format} />
    <Heading class="title" lang={otherLang}>
      {data.title}
    </Heading>
  </a>
  <p class="meta">
    <span>{postKind(post.entry, lang)}</span>
    {data.book && (
      <span>
        <cite>{data.book.title}</cite>
        {data.book.chapter && <> · {fill(t.chapter, { chapter: data.book.chapter })}</>}
      </span>
    )}
    {otherLang && <span>{t.untranslated}</span>}
    <span>{fill(t.minutes, { minutes: readingMinutes(post.entry.body ?? '') })}</span>
    {data.draft && <span class="draft">{t.draft}</span>}
    {!data.draft && !post.live && (
      <span class="draft">{fill(t.scheduled, { date: formatDate(data.date, lang) })}</span>
    )}
  </p>
</article>

<style>
  .post-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .link {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }
  .title {
    margin: 0;
    font: 500 var(--size-xl) / 1.2 var(--font-serif);
    font-variation-settings: 'opsz' 36;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .link:hover .title,
  .link:focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent-ui);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .draft {
    color: var(--color-accent);
  }
</style>
