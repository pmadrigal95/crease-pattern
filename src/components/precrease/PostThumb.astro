---
/** A post's generated thumbnail (src/lib/thumbnail.ts). Decorative: the title names the post. */
import { formats, type Format } from '../../config/precrease';
import { thumbnail } from '../../lib/thumbnail';

interface Props {
  slug: string;
  format: Format;
}
const { slug, format } = Astro.props;
const { viewBox, shapes } = thumbnail(slug, formats[format].family);
---

<span class="post-thumb" data-format={format}>
  <svg viewBox={viewBox} aria-hidden="true" focusable="false" set:html={shapes} />
</span>

<style>
  .post-thumb {
    display: block;
    aspect-ratio: 1;
    background: var(--color-surface);
    color: var(--color-accent);
    border: 1px solid var(--color-rule);
  }
  .post-thumb svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Dog-ear posts keep a folded corner: the format's own sign. */
  .post-thumb[data-format='dog-ear'] {
    clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 0 100%);
    position: relative;
  }
</style>
