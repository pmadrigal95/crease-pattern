---
/**
 * What a reader app receives from the feed (doc 41): the three newest posts as it would show them,
 * built from the same fields the feed carries (src/lib/precrease-feed.ts). While inspecting, the
 * newest one's XML stands beside it, its values marked: the item behind the card.
 */
import site from '../../../site.config';
import { copyFor } from '../../i18n/dictionary';
import { langOf } from '../../i18n/routing';
import { formatDate } from '../../lib/format';
import { feedItem, feedPosts } from '../../lib/precrease-feed';

const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang).precrease;
const items = (await feedPosts(lang)).slice(0, 3).map((post) => ({ post, item: feedItem(post, lang) }));
const first = items[0]?.item;
const fields = first
  ? [
      ['title', first.title],
      ['link', new URL(first.link, site.url).href],
      ['description', first.description],
      ['pubDate', first.pubDate.toUTCString()],
    ]
  : [];
---

<section class="preview" aria-labelledby="preview-title" data-inspect="FeedPreview">
  <h2 id="preview-title">{copy.feeds.previewTitle}</h2>
  <p class="k">{copy.feeds.previewNote}</p>
  <ul class="reader">
    {items.map(({ post, item }) => (
      <li>
        <span class="src">{copy.name}</span>
        <b>{item.title}</b>
        <p>{item.description}</p>
        <time datetime={post.date.toISOString()}>{formatDate(post.date, lang)}</time>
      </li>
    ))}
  </ul>
  {first && (
    <div class="xml" role="group" aria-label={copy.feeds.xml}>
      <code>&lt;item&gt;</code>
      {fields.map(([tag, value]) => (
        <code class="field">
          &lt;{tag}&gt;<mark>{value}</mark>&lt;/{tag}&gt;
        </code>
      ))}
      <code>&lt;/item&gt;</code>
    </div>
  )}
</section>

<style>
  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-lg);
    font-weight: 600;
  }
  .k {
    margin: 0 0 var(--space-4);
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .reader {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface);
  }
  li {
    display: grid;
    gap: 4px;
    padding: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  li:first-child {
    border-top: 0;
  }
  .src {
    font: 500 11px var(--font-mono);
    color: var(--color-accent);
  }
  b {
    font: 600 var(--size-md) / 1.3 var(--font-sans);
  }
  li p {
    margin: 0;
    font-size: var(--size-sm);
    color: var(--color-mute);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .xml {
    display: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-4);
    border-radius: 10px;
    background: var(--color-ink);
    color: var(--color-bg);
    font: 500 11px / 1.55 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .xml code {
    display: block;
    font: inherit;
  }
  .xml .field {
    padding-left: 2ch;
  }
  mark {
    padding: 0 2px;
    border-radius: 3px;
    background: color-mix(in oklab, var(--color-accent-ui) 45%, transparent);
    color: inherit;
  }
  :global(.inspecting) .xml {
    display: block;
  }
  :global(.inspecting) li:first-child {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: -2px;
  }
</style>
