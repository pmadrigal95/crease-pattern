---
/**
 * The "This helped" icon (PostReaders.astro): a page whose top-right corner folds down, the
 * site's gesture. Hovering the button lifts the corner; pressing it folds it down for good. The
 * states follow the button around it (.helped and its aria-pressed).
 */
---

<span class="corner" aria-hidden="true">
  <span class="page"></span>
  <span class="edge"></span>
  <span class="flap"></span>
</span>

<style>
  .corner {
    position: relative;
    flex: none;
    width: 16px;
    height: 20px;
  }
  .page,
  .edge {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    transition: clip-path var(--fold) var(--motion-ease-out);
  }
  .page {
    background: currentColor;
    opacity: 0.18;
  }
  .edge {
    border: 1.6px solid currentColor;
  }
  .flap {
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    background: linear-gradient(225deg, transparent 50%, currentColor 50%);
    transition:
      width var(--fold) var(--motion-ease-out),
      height var(--fold) var(--motion-ease-out);
  }
  @media (hover: hover) {
    :global(.helped:hover:not([aria-pressed='true'])) :is(.page, .edge) {
      clip-path: polygon(0 0, 78% 0, 100% 18%, 100% 100%, 0 100%);
    }
    :global(.helped:hover:not([aria-pressed='true'])) .flap {
      width: 22%;
      height: 18%;
    }
  }
  :global(.helped[aria-pressed='true']) :is(.page, .edge) {
    clip-path: polygon(0 0, 50% 0, 100% 40%, 100% 100%, 0 100%);
  }
  :global(.helped[aria-pressed='true']) .page {
    opacity: 0.35;
  }
  :global(.helped[aria-pressed='true']) .flap {
    width: 50%;
    height: 40%;
  }
</style>
