---
/**
 * The site's mark: the origami figure of the visitor's identity (src/lib/origami/marks.ts), drawn
 * from the symbols in OrigamiSprite. Every figure is here; src/styles/origami.css shows the one
 * that matches `data-direction` and the theme. While inspecting, the figure gives way to its crease
 * pattern: the interface, then the architecture.
 */
import { MODEL_IDS } from '../../lib/origami/models';
import { VIEWBOX } from '../../lib/origami/marks';

interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  class="origami origami-mark"
  width={size}
  height={size}
  viewBox={VIEWBOX}
  aria-hidden="true"
  focusable="false"
>
  <g class="o-flat">
    {MODEL_IDS.map((id) => (
      <use class={`o-model o-${id}`} href={`#origami-${id}-flat`} />
    ))}
  </g>
  <g class="o-folded">
    {MODEL_IDS.map((id) => (
      <use class={`o-model o-${id}`} href={`#origami-${id}`} />
    ))}
  </g>
</svg>
