---
/**
 * The 3D relief of /changelog's map (ExpeditionMap.astro): the career's places as paper models of
 * their real terrain (changelog3d.ts, geometry and data in src/lib/relief.ts), on a wide screen
 * whose device can run it (src/lib/scene3d-support.ts), loaded as the map approaches. This is its
 * readout, its names (links to each release, as the map's pins are) and its slider, hidden until
 * the scene is built; then the map's drawing gives way to it.
 */
import { careerFor, climbs, places } from '../../lib/career';
import { copyFor, fill } from '../../i18n/dictionary';
import { formatNumber } from '../../lib/format';
import { langOf } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(Astro.currentLocale);

const t = copy.changelogPage.map;
const elevation = (m: number) => fill(copy.home.changelog.elevation, { elevation: formatNumber(m, lang) });
const career = careerFor(lang);
const spans = new Map(climbs(career).map((c, i, all) => [c.major, { c, current: i === all.length - 1 }]));
const themes = new Map(career.releases.map((r) => [r.major, r.theme]));
const data = places(career);
const years = (major: number) => {
  const { c, current } = spans.get(major)!;
  return `${Math.floor(c.start)} – ${current ? copy.home.changelog.present : Math.floor(c.end)}`;
};
---

<div class="relief" data-relief hidden>
  <div class="readout">
    {data.map((p) => (
      <div
        class:list={['head', { away: !spans.get(p.major)!.current }]}
        data-era={p.major}
        data-said={`v${p.major} ${p.codename}, ${elevation(p.elevationM)}, ${years(p.major)}`}
      >
        <p class="tag">
          v{p.major} · {p.codename}
        </p>
        <p class="alt">{elevation(p.elevationM)}</p>
        <p class="theme">
          {themes.get(p.major)} · {years(p.major)}
        </p>
      </div>
    ))}
  </div>
  <div class="relief-stage" data-relief-stage>
    <nav class="names" aria-label={t.label}>
      {data.map((p) => (
        <a
          href={`#release-${p.major}`}
          class:list={{ on: spans.get(p.major)!.current }}
          data-name={p.major}
          aria-label={fill(t.pin, {
            major: p.major,
            codename: p.codename,
            elevation: elevation(p.elevationM),
            years: years(p.major),
          })}
        >
          {p.codename}
        </a>
      ))}
    </nav>
  </div>
  <div class="bar">
    <input
      type="range"
      min="0"
      max="1000"
      step="5"
      value="1000"
      aria-label={t.relief.route}
      data-relief-range
    />
    <span class="hint">{t.relief.hint}</span>
  </div>
  <p class="sr-only" aria-live="polite" data-relief-live></p>
</div>

<script>
  // Brings the 3D relief up (changelog3d.ts) as the map approaches, on a wide screen whose device
  // can run it. Anything that fails leaves the drawing, a complete map on its own.
  for (const relief of document.querySelectorAll<HTMLElement>('[data-relief]')) {
    const figure = relief.closest('figure')!;
    const wide = matchMedia('(min-width: 720px)');
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting || !wide.matches) return;
        near.disconnect();
        void import('../../lib/scene3d-support')
          .then(({ canRun3D, detectDevice }) =>
            canRun3D(detectDevice()) ? import('./changelog3d').then((m) => m.mountRelief(figure)) : undefined,
          )
          .catch(() => undefined);
      },
      { rootMargin: '200px 0px' },
    );
    near.observe(figure);
  }
</script>

<style>
  /* A readout of the place the flag is on, the models, the slider. */
  .relief {
    padding: var(--space-6) var(--space-6) var(--space-4);
  }
  .readout {
    display: grid;
  }
  .head {
    grid-area: 1 / 1;
    transition: opacity 0.2s ease-out;
  }
  .head.away {
    visibility: hidden;
    opacity: 0;
  }
  .head p {
    margin: 0;
  }
  .tag {
    font: 600 var(--size-xs) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .head .alt {
    margin-top: var(--space-2);
    font: 600 clamp(2.5rem, 5vw, 4rem) / 1 var(--font-sans);
    letter-spacing: -0.04em;
  }
  .head .theme {
    margin-top: var(--space-2);
    color: var(--color-mute);
  }
  .relief-stage {
    position: relative;
    margin-top: var(--space-4);
    height: clamp(320px, 42vw, 500px);
    border-radius: calc(var(--radius-panel) - 4px);
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    cursor: grab;
    touch-action: pan-y;
  }
  .relief-stage:active {
    cursor: grabbing;
  }
  .names {
    position: absolute;
    inset: auto 0 var(--space-3);
    z-index: 1;
    display: flex;
    justify-content: space-between;
    padding: 0 var(--space-6);
  }
  .names a {
    font: 500 var(--size-sm) var(--font-sans);
    color: var(--color-mute);
    text-decoration: none;
  }
  .names a.on {
    font-weight: 700;
    color: var(--color-ink);
  }
  .names a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-ui);
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .bar input {
    width: 100%;
    accent-color: var(--color-accent-ui);
  }
  .hint {
    font: 500 var(--size-xs) / 1.4 var(--font-mono);
    color: var(--color-mute);
  }
</style>
