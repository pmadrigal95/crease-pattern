---
/**
 * The home hero's figure: the site's thesis made visible. The origami figure of the visitor's
 * identity is the interface; unfolded, it becomes the crease pattern that makes it, the
 * architecture (decision 50). Which figure shows is src/styles/origami.css's call.
 *
 * One value drives it, the fold `--t` from 0 (the folded figure) to 1 (its crease pattern):
 * - the pointer hovering or dragging across the figure, or the slider below it (arrow keys);
 * - opening the Inspector, which unfolds every figure on the page (`.inspecting` on the root);
 * - a first visit, where the sheet folds into the figure once (`.intro`).
 *
 * Without JavaScript the figure stays folded and the Inspector still unfolds it. This SVG is also
 * the first frame of the 3D scene (src/components/inspector/scene3d.ts), which takes over this same
 * square when it loads and folds the same geometry for real.
 */
import { MODEL_IDS, models } from '../../lib/origami/models';
import { spriteHref } from '../../lib/origami/sprite';
import { VIEWBOX } from '../../lib/origami/marks';
import { copyFor } from '../../i18n/dictionary';
const copy = copyFor(Astro.currentLocale);

const t = copy.home.hero.fold;
const strings = JSON.stringify({ folded: t.folded, unfolded: t.unfolded });
// Each figure's real numbers, from the geometry the scene folds: one hinge per facet but the first.
const card = MODEL_IDS.map((id) => ({ id, facets: models[id].fold.faces.length }));
---

<figure class="hero-fold" data-hero-fold data-strings={strings} data-inspect="HeroFold">
  <div class="stage" data-stage>
    <svg class="origami" viewBox={VIEWBOX} aria-hidden="true" focusable="false">
      <g class="flat">
        {MODEL_IDS.map((id) => (
          <use class={`o-model o-${id}`} href={spriteHref(id, true)} />
        ))}
      </g>
      <g class="folded">
        {MODEL_IDS.map((id) => (
          <use class={`o-model o-${id}`} href={spriteHref(id)} />
        ))}
      </g>
    </svg>
  </div>
  <div class="card origami">
    {card.map(({ id, facets }) => (
      <div class={`o-model o-${id}`}>
        <p class="name">{t.figures[id]}</p>
        <dl class="counts">
          <div>
            <dd>{facets}</dd>
            <dt>{t.facets}</dt>
          </div>
          <div>
            <dd>{facets - 1}</dd>
            <dt>{t.hinges}</dt>
          </div>
          <div>
            <dd>1</dd>
            <dt>{t.sheet}</dt>
          </div>
        </dl>
      </div>
    ))}
    <div class="key">
      <p class="legend" aria-hidden="true">
        <span class="mountain">{t.mountain}</span>
        <span class="valley">{t.valley}</span>
      </p>
      <p class="drag">{t.drag}</p>
    </div>
  </div>
  <div class="scale" hidden data-scale>
    <span class="end on" data-end="interface">
      {t.interface}
    </span>
    <div
      class="track"
      role="slider"
      tabindex="0"
      aria-label={t.label}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext={t.folded}
    >
      <span class="knob"></span>
    </div>
    <span class="end" data-end="architecture">
      {t.architecture}
    </span>
  </div>
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  @property --t {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .hero-fold {
    --t: var(--fold, 0);
    margin: 0;
  }
  /* Inspecting unfolds every figure on the page, this one included. */
  :global(.inspecting) .hero-fold {
    --t: 1;
  }
  .stage {
    position: relative;
    aspect-ratio: 1;
    touch-action: pan-y;
    cursor: ew-resize;
  }
  /* The 3D scene (src/components/inspector/scene3d.ts) takes over this square once its first frame
     is drawn; the SVG, its first frame, steps back and returns when the scene leaves. */
  .stage svg {
    transition: opacity 300ms ease-out;
  }
  .hero-fold.scene-3d .stage svg {
    opacity: 0;
  }
  .stage svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .flat,
  .folded,
  .knob {
    transition:
      opacity var(--motion-stage) var(--motion-ease-in-out),
      transform var(--motion-stage) var(--motion-ease-in-out),
      left var(--motion-stage) var(--motion-ease-in-out);
  }
  .scrubbing :is(.flat, .folded),
  .scrubbing ~ .scale .knob {
    transition: none;
  }
  /* The figure steps back as its crease pattern comes forward on the same square. */
  .flat,
  .folded {
    transform-box: view-box;
    transform-origin: center;
  }
  .folded {
    opacity: calc(1 - var(--t));
    transform: scale(calc(1 - var(--t) * 0.12));
  }
  .flat {
    opacity: var(--t);
    transform: scale(calc(0.9 + var(--t) * 0.1));
  }
  /* The figure's card: its name, its real numbers and how to read its folds. */
  .card {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .name {
    margin: 0;
    font-weight: 600;
    font-size: var(--size-md);
    color: var(--color-ink);
  }
  .counts {
    display: flex;
    gap: var(--space-6);
    margin: var(--space-1) 0 0;
  }
  .counts div {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }
  .counts dd {
    margin: 0;
    font: 600 var(--size-md) var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .counts dt {
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .legend {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .legend span::before {
    content: '';
    display: inline-block;
    width: 18px;
    margin-right: var(--space-1);
    vertical-align: middle;
    border-top: 2px solid var(--color-accent-ui);
  }
  .legend .valley::before {
    border-top-style: dashed;
  }
  /* The legend and the drag hint share a row, so the hint appearing never moves the slider. */
  .key {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  /* Only once the figure is 3D can it be turned. */
  .drag {
    visibility: hidden;
    opacity: 0;
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
    transition: opacity var(--motion-base) ease-out;
  }
  .scene-3d .drag {
    visibility: visible;
    opacity: 1;
  }

  .scale {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .scale[hidden] {
    display: none;
  }
  .end {
    font-weight: 500;
    transition: color var(--motion-base);
  }
  .end.on {
    color: var(--color-ink);
  }
  .track {
    position: relative;
    height: var(--space-6);
    cursor: pointer;
    touch-action: none;
  }
  .track::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: var(--stroke-crease) dashed var(--color-rule);
  }
  .knob {
    position: absolute;
    top: 50%;
    left: calc(var(--t) * 100%);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: var(--stroke-crease) solid var(--color-accent-ui);
  }
  figcaption {
    max-width: 44ch;
    margin: var(--space-3) 0 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }

  /* First visit: the flat sheet folds into the figure once. */
  :global(.intro) .hero-fold {
    animation: sheet-to-figure calc(var(--motion-stage) * 2) var(--motion-ease-in-out) both;
  }
  @keyframes sheet-to-figure {
    from {
      --t: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flat,
    .folded,
    .knob {
      transition: none;
    }
    :global(.intro) .hero-fold {
      animation: none;
    }
  }
</style>

<script>
  // Self-contained on purpose (ENGINEERING.md, "Browser scripts"): Astro inlines it, so the home
  // page requests nothing extra for it.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-hero-fold]')) {
    const stage = figure.querySelector<HTMLElement>('[data-stage]');
    const scale = figure.querySelector<HTMLElement>('[data-scale]');
    const track = figure.querySelector<HTMLElement>('[role="slider"]');
    const ends = figure.querySelectorAll<HTMLElement>('[data-end]');
    const strings = JSON.parse(figure.dataset.strings ?? '{}') as { folded: string; unfolded: string };
    if (!stage || !scale || !track) continue;

    // The slider only works with JavaScript, so it only appears with it.
    scale.hidden = false;

    const current = () => Number(track.getAttribute('aria-valuenow')) / 100;
    const set = (value: number) => {
      const t = Math.min(1, Math.max(0, value));
      figure.style.setProperty('--fold', t.toFixed(3));
      // The 3D figure, once it's up, folds to the same value (src/components/inspector/scene3d.ts).
      figure.dispatchEvent(new CustomEvent('hero-fold', { detail: t }));
      const unfolded = t >= 0.5;
      track.setAttribute('aria-valuenow', String(Math.round(t * 100)));
      track.setAttribute('aria-valuetext', unfolded ? strings.unfolded : strings.folded);
      ends[0]?.classList.toggle('on', !unfolded);
      ends[1]?.classList.toggle('on', unfolded);
    };
    const fromPointer = (e: PointerEvent, el: HTMLElement) => {
      const box = el.getBoundingClientRect();
      return (e.clientX - box.left) / box.width;
    };

    // In 3D the figure itself is for turning: only the slider folds it.
    const in3d = () => figure.classList.contains('scene-3d');
    // Dragging across the figure or along the slider scrubs the fold; letting go settles it.
    for (const el of [stage, track]) {
      el.addEventListener('pointerdown', (e) => {
        if (el === stage && (e.pointerType !== 'mouse' || in3d())) return; // touch scrolls the page instead
        el.setPointerCapture(e.pointerId);
        figure.classList.add('scrubbing');
        set(fromPointer(e, el));
      });
      el.addEventListener('pointermove', (e) => {
        if (el.hasPointerCapture(e.pointerId)) set(fromPointer(e, el));
      });
      el.addEventListener('pointerup', () => {
        if (!figure.classList.contains('scrubbing')) return; // a drag that turned the 3D figure
        figure.classList.remove('scrubbing');
        // The SVG settles on one end; in 3D the fold stays wherever the hand left it.
        if (!in3d()) set(current() >= 0.5 ? 1 : 0);
      });
    }
    // A mouse resting on the figure previews the unfold; leaving folds it back.
    stage.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse' && !e.buttons && !in3d()) set(1);
    });
    stage.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !e.buttons && !in3d()) set(0);
    });
    track.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 0.1, ArrowUp: 0.1, ArrowLeft: -0.1, ArrowDown: -0.1, Home: -1, End: 1 }[
        e.key
      ];
      if (step === undefined) return;
      e.preventDefault();
      set(current() + step);
    });
  }
</script>

<script>
  // The figure turns 3D at the visitor's first move (src/scripts/hero3d.ts). A script of its own,
  // on the home page only: in the masthead's, its imports put two more modules in front of every
  // page's first paint (About's LCP lost a round trip).
  import { initHero3d } from '../../scripts/hero3d';
  initHero3d();
  // The pointer effect behind the figure (src/scripts/hero-pointer.ts) downloads only when a mouse
  // really moves over the hero, so the first load doesn't carry it. A pointermove with no movement
  // is the page changing under a resting pointer, not the visitor.
  const hero = document.querySelector<HTMLElement>('.hero');
  const start = (e: PointerEvent) => {
    if (e.pointerType === 'touch' || (!e.movementX && !e.movementY)) return;
    hero?.removeEventListener('pointermove', start);
    void import('../../scripts/hero-pointer').then((m) => m.initHeroPointer()).catch(() => undefined);
  };
  if (!matchMedia('(pointer: coarse)').matches)
    hero?.addEventListener('pointermove', start, { passive: true });
</script>
