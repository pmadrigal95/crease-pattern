---
/**
 * The home hero's figure: the site's thesis made visible. The origami figure of the visitor's
 * identity is the interface; unfolded, it becomes the crease pattern that makes it, the
 * architecture (decision 50). Which figure shows is src/styles/origami.css's call.
 *
 * One value drives it, the fold `--t` from 0 (the folded figure) to 1 (its crease pattern):
 * - the pointer hovering or dragging across the figure, or the slider below it (arrow keys);
 * - opening the Inspector, which unfolds every figure on the page (`.inspecting` on the root);
 * - a first visit, where the sheet folds into the figure once (`.intro`).
 *
 * Without JavaScript the figure stays folded and the Inspector still unfolds it. This SVG is also
 * the first frame of the 3D scene (src/components/inspector/scene3d.ts), which takes over this same
 * square when it loads and folds the same geometry for real.
 */
import { MODEL_IDS } from '../../lib/origami/models';
import { VIEWBOX } from '../../lib/origami/marks';
import { copyFor } from '../../i18n/dictionary';
const copy = copyFor(Astro.currentLocale);

const t = copy.home.hero.fold;
const strings = JSON.stringify({ folded: t.folded, unfolded: t.unfolded });
---

<figure class="hero-fold" data-hero-fold data-strings={strings} data-inspect="HeroFold">
  <div class="stage" data-stage>
    <svg class="origami" viewBox={VIEWBOX} aria-hidden="true" focusable="false">
      <g class="flat">
        {MODEL_IDS.map((id) => (
          <use class={`o-model o-${id}`} href={`#origami-${id}-flat`} />
        ))}
      </g>
      <g class="folded">
        {MODEL_IDS.map((id) => (
          <use class={`o-model o-${id}`} href={`#origami-${id}`} />
        ))}
      </g>
      <g class="legend">
        <path class="mountain" d="M14 47.2h3.6"></path>
        <text x="18.6" y="47.8">
          {t.mountain}
        </text>
        <path class="valley" d="M27.6 47.2h3.6"></path>
        <text x="32.2" y="47.8">
          {t.valley}
        </text>
      </g>
    </svg>
  </div>
  <div class="scale" hidden data-scale>
    <span class="end on" data-end="interface">
      {t.interface}
    </span>
    <div
      class="track"
      role="slider"
      tabindex="0"
      aria-label={t.label}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext={t.folded}
    >
      <span class="knob"></span>
    </div>
    <span class="end" data-end="architecture">
      {t.architecture}
    </span>
  </div>
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  @property --t {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .hero-fold {
    --t: var(--fold, 0);
    margin: 0;
  }
  /* Inspecting unfolds every figure on the page, this one included. */
  :global(.inspecting) .hero-fold {
    --t: 1;
  }
  .stage {
    position: relative;
    aspect-ratio: 1;
    touch-action: pan-y;
    cursor: ew-resize;
  }
  /* The 3D scene (src/components/inspector/scene3d.ts) takes over this square once its first frame
     is drawn; the SVG, its first frame, steps back and returns when the scene leaves. */
  .stage svg {
    transition: opacity 300ms ease-out;
  }
  .hero-fold.scene-3d .stage svg {
    opacity: 0;
  }
  .stage svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .flat,
  .folded,
  .legend,
  .knob {
    transition:
      opacity var(--motion-stage) var(--motion-ease-in-out),
      transform var(--motion-stage) var(--motion-ease-in-out),
      left var(--motion-stage) var(--motion-ease-in-out);
  }
  .scrubbing :is(.flat, .folded, .legend),
  .scrubbing ~ .scale .knob {
    transition: none;
  }
  /* The figure steps back as its crease pattern comes forward on the same square. */
  .flat,
  .folded {
    transform-box: view-box;
    transform-origin: center;
  }
  .folded {
    opacity: calc(1 - var(--t));
    transform: scale(calc(1 - var(--t) * 0.12));
  }
  .flat {
    opacity: var(--t);
    transform: scale(calc(0.9 + var(--t) * 0.1));
  }
  .legend {
    opacity: calc(var(--t) * 2 - 1);
  }
  .legend text {
    font: 1.9px var(--font-mono);
    fill: var(--color-mute);
  }
  .legend path {
    stroke: var(--color-accent-ui);
    stroke-width: 0.5;
  }
  .legend .valley {
    stroke-dasharray: 1.2 0.8;
  }

  .scale {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .scale[hidden] {
    display: none;
  }
  .end {
    font-weight: 500;
    transition: color var(--motion-base);
  }
  .end.on {
    color: var(--color-ink);
  }
  .track {
    position: relative;
    height: var(--space-6);
    cursor: pointer;
    touch-action: none;
  }
  .track::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: var(--stroke-crease) dashed var(--color-rule);
  }
  .knob {
    position: absolute;
    top: 50%;
    left: calc(var(--t) * 100%);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: var(--stroke-crease) solid var(--color-accent-ui);
  }
  figcaption {
    max-width: 44ch;
    margin: var(--space-3) 0 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }

  /* First visit: the flat sheet folds into the figure once. */
  :global(.intro) .hero-fold {
    animation: sheet-to-figure calc(var(--motion-stage) * 2) var(--motion-ease-in-out) both;
  }
  @keyframes sheet-to-figure {
    from {
      --t: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flat,
    .folded,
    .legend,
    .knob {
      transition: none;
    }
    :global(.intro) .hero-fold {
      animation: none;
    }
  }
</style>

<script>
  // Self-contained on purpose (ENGINEERING.md, "Browser scripts"): Astro inlines it, so the home
  // page requests nothing extra for it.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-hero-fold]')) {
    const stage = figure.querySelector<HTMLElement>('[data-stage]');
    const scale = figure.querySelector<HTMLElement>('[data-scale]');
    const track = figure.querySelector<HTMLElement>('[role="slider"]');
    const ends = figure.querySelectorAll<HTMLElement>('[data-end]');
    const strings = JSON.parse(figure.dataset.strings ?? '{}') as { folded: string; unfolded: string };
    if (!stage || !scale || !track) continue;

    // The slider only works with JavaScript, so it only appears with it.
    scale.hidden = false;

    const current = () => Number(track.getAttribute('aria-valuenow')) / 100;
    const set = (value: number) => {
      const t = Math.min(1, Math.max(0, value));
      figure.style.setProperty('--fold', t.toFixed(3));
      const unfolded = t >= 0.5;
      track.setAttribute('aria-valuenow', String(Math.round(t * 100)));
      track.setAttribute('aria-valuetext', unfolded ? strings.unfolded : strings.folded);
      ends[0]?.classList.toggle('on', !unfolded);
      ends[1]?.classList.toggle('on', unfolded);
    };
    const fromPointer = (e: PointerEvent, el: HTMLElement) => {
      const box = el.getBoundingClientRect();
      return (e.clientX - box.left) / box.width;
    };

    // Dragging across the figure or along the slider scrubs the fold; letting go settles it.
    for (const el of [stage, track]) {
      el.addEventListener('pointerdown', (e) => {
        if (el === stage && e.pointerType !== 'mouse') return; // touch scrolls the page instead
        el.setPointerCapture(e.pointerId);
        figure.classList.add('scrubbing');
        set(fromPointer(e, el));
      });
      el.addEventListener('pointermove', (e) => {
        if (el.hasPointerCapture(e.pointerId)) set(fromPointer(e, el));
      });
      el.addEventListener('pointerup', () => {
        figure.classList.remove('scrubbing');
        set(current() >= 0.5 ? 1 : 0);
      });
    }
    // A mouse resting on the figure previews the unfold; leaving folds it back.
    stage.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse' && !e.buttons) set(1);
    });
    stage.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !e.buttons) set(0);
    });
    track.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 0.1, ArrowUp: 0.1, ArrowLeft: -0.1, ArrowDown: -0.1, Home: -1, End: 1 }[
        e.key
      ];
      if (step === undefined) return;
      e.preventDefault();
      set(current() + step);
    });
  }
</script>
