---
/**
 * The full career changelog as a vertical ascent (design debt phase 2): Unreleased at the top,
 * then each release from the current summit down to base camp. No boxes: a dashed trail runs
 * down the left with a node at each release, and each release's altitude stays pinned beside it
 * while its entries scroll past. Each release heading is a target of the map above
 * (#release-N).
 */
import { career, releasesNewestFirst } from '../../lib/career';
import { formatList, formatNumber, formatRange } from '../../lib/format';
import { copy, fill } from '../../lib/copy';

const releases = releasesNewestFirst();
const current = releases[0]?.major;
const t = copy.home.changelog;
const page = copy.changelogPage;
---

<div class="ascent" data-inspect="ReleaseNotes">
  <section class="camp next" aria-labelledby="release-unreleased">
    <p class="rail" aria-hidden="true">
      <span class="rail-label">{page.rail.next}</span>
    </p>
    <div class="content">
      <header class="head">
        <h2 id="release-unreleased">{t.unreleased}</h2>
      </header>
      <ul class="changes">
        {career.unreleased.map((line) => (
          <li class="add">
            <span class="sr-only">{t.sections.added}: </span>
            {line}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {releases.map((r) => (
    <section class={r.major === current ? 'camp current' : 'camp'} aria-labelledby={`release-${r.major}`}>
      <p class="rail">
        <span class="rail-value">{formatNumber(r.elevationM)}</span>
        <span class="rail-unit"> m</span>
        {r.major === current && <span class="rail-label">{page.rail.now}</span>}
      </p>
      <div class="content">
        <header class="head">
          <p class="major">v{r.major}</p>
          <h2 id={`release-${r.major}`}>{r.codename}</h2>
          <p class="theme">{r.theme}</p>
        </header>
        <ol class="entries">
          {r.entries.map((e) => (
            <li class="entry">
              <p class="meta">
                <code>{e.version}</code>
                <span>{formatRange(e.start, e.end, t.present)}</span>
              </p>
              <div class="body">
                <h3>
                  {e.title} <span class="org">· {e.org}</span>
                </h3>
                {e.stack && <p class="built">{fill(page.built, { stack: formatList(e.stack) })}</p>}
                {(e.added || e.changed) && (
                  <ul class="changes">
                    {e.added?.map((line) => (
                      <li class="add">
                        <span class="sr-only">{t.sections.added}: </span>
                        {line}
                      </li>
                    ))}
                    {e.changed?.map((line) => (
                      <li class="chg">
                        <span class="sr-only">{t.sections.changed}: </span>
                        {line}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</div>

<style>
  .ascent {
    --rail: 9rem;
  }
  .camp {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--space-8);
    padding-bottom: var(--space-16);
  }
  .camp:last-child {
    padding-bottom: 0;
  }
  /* The trail: a dashed crease from the next summit down to base camp. */
  .camp::before {
    content: '';
    position: absolute;
    left: var(--rail);
    top: 0.9rem;
    bottom: 0;
    border-left: var(--stroke-crease) dashed var(--color-rule);
  }
  .camp:last-child::before {
    display: none;
  }
  /* One node per release; the current one is filled with the accent, the next one is open. */
  .camp::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 5px);
    top: 0.55rem;
    width: 11px;
    height: 11px;
    border: var(--stroke-crease) solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-bg);
  }
  .camp.current::after {
    border-color: var(--color-accent-ui);
    background: var(--color-accent-ui);
    box-shadow: 0 0 0 4px var(--color-bg);
  }
  .camp.next::after {
    border-style: dashed;
  }

  .rail {
    position: sticky;
    top: calc(var(--sticky-offset) + var(--space-4));
    align-self: start;
    margin: 0;
    padding-right: var(--space-6);
    text-align: right;
    line-height: 1;
  }
  .rail-value {
    font-size: var(--size-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .rail-unit {
    font-size: var(--size-md);
    color: var(--color-mute);
  }
  .rail-label {
    display: block;
    margin-top: var(--space-2);
    font: 600 var(--size-xs) var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .next .rail-label {
    margin-top: var(--space-1);
    color: var(--color-mute);
  }

  .head {
    margin-bottom: var(--space-6);
  }
  .major {
    margin: 0;
    font: 600 var(--size-sm) var(--font-mono);
    color: var(--color-accent);
  }
  h2 {
    margin: var(--space-1) 0;
    font-size: var(--size-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .next h2 {
    margin-top: 0;
    font-size: var(--size-lg);
  }
  .theme {
    margin: 0;
    color: var(--color-mute);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-rule);
  }
  .meta {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    margin: 0;
    font: var(--size-xs) / 1.5 var(--font-mono);
    color: var(--color-mute);
  }
  .meta code {
    font: 600 var(--size-sm) var(--font-mono);
    color: var(--color-ink);
  }
  .body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  h3 {
    margin: 0;
    font-size: var(--size-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .org {
    font-weight: 400;
    color: var(--color-mute);
  }
  .built {
    margin: 0;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .changes li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    max-width: 66ch;
  }
  .changes li::before {
    font: 600 var(--size-sm) / 1.55 var(--font-mono);
  }
  .changes li.add::before {
    content: '+';
    color: var(--color-second);
  }
  .changes li.chg::before {
    content: '~';
    color: var(--color-accent);
  }

  /* Phones: the trail moves to the edge and the altitude sits above the release name. */
  @media (max-width: 720px) {
    .ascent {
      --rail: 0px;
    }
    .camp {
      grid-template-columns: minmax(0, 1fr);
      padding-left: var(--space-6);
    }
    .camp::before {
      left: 0;
    }
    .camp::after {
      left: -5px;
    }
    .rail {
      position: static;
      padding: 0 0 var(--space-2);
      text-align: left;
    }
    .rail-value {
      font-size: var(--size-lg);
    }
    .rail-label {
      display: inline;
      margin-left: var(--space-2);
    }
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
