---
/**
 * The full career changelog as a vertical ascent (design debt phase 2): Unreleased at the top,
 * then each release from the current summit down to base camp. No boxes: a dashed trail runs
 * down the left with a node at each release, and each release's altitude stays pinned beside it
 * while its entries scroll past. Each release heading is a target of the map above
 * (#release-N).
 *
 * An ascent log (doc 37): each release opens with a badge of its place in contour lines beside its
 * altitude (ReleaseBadge.astro); each change says its kind in words; the stack is a row of chips;
 * each entry says how long it lasted.
 */
import ReleaseBadge from './ReleaseBadge.astro';
import { howLong, monthsOf } from '../../lib/earlier-timeline';
import { careerFor, releasesNewestFirst } from '../../lib/career';
import { formatList, formatNumber, formatRange, padNumber } from '../../lib/format';
import { copyFor, fill } from '../../i18n/dictionary';
import { langOf } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(Astro.currentLocale);

const career = careerFor(lang);
const releases = releasesNewestFirst(career);
const current = releases[0]?.major;
const t = copy.home.changelog;
const page = copy.changelogPage;
const lengths = copy.cases.index.earlier;
/** "Built with", the words around the stack. */
const builtWith = page.built.replace('{stack}', '').trim();
const now = new Date();
const thisMonth = `${now.getUTCFullYear()}-${padNumber(now.getUTCMonth() + 1, 2)}`;
/** How long an entry lasted, when its dates are months; to now while it lasts. */
const lasted = (e: { start: string; end?: string | null | undefined }) =>
  e.start.includes('-') && (e.end ?? thisMonth).includes('-')
    ? howLong(monthsOf({ start: e.start, end: e.end ?? thisMonth }), lengths)
    : undefined;
---

<div class="ascent" data-inspect="ReleaseNotes">
  <section class="camp next" aria-labelledby="release-unreleased">
    <p class="rail" aria-hidden="true">
      <span class="rail-label">{page.rail.next}</span>
    </p>
    <div class="content">
      <header class="head">
        <h2 id="release-unreleased">{t.unreleased}</h2>
      </header>
      <ul class="changes">
        {career.unreleased.map((line) => (
          <li class="add">
            <span class="sr-only">{t.sections.added}: </span>
            {line}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {releases.map((r) => (
    <section class={r.major === current ? 'camp current' : 'camp'} aria-labelledby={`release-${r.major}`}>
      <p class="rail">
        <ReleaseBadge major={r.major} />
        <span class="rail-value">{formatNumber(r.elevationM, lang)}</span>
        <span class="rail-unit"> m</span>
        {r.major === current && <span class="rail-label">{page.rail.now}</span>}
      </p>
      <div class="content">
        <header class="head">
          <p class="major">v{r.major}</p>
          <h2 id={`release-${r.major}`}>{r.codename}</h2>
          <p class="theme">{r.theme}</p>
        </header>
        <ol class="entries">
          {r.entries.map((e) => (
            <li class="entry">
              <p class="meta">
                <code>{e.version}</code>
                <span>{formatRange(e.start, e.end, t.present, lang)}</span>
                {lasted(e) && <span class="lasted">{lasted(e)}</span>}
              </p>
              <div class="body">
                <h3>
                  {e.title} <span class="org">· {e.org}</span>
                </h3>
                {e.stack && (
                  <p class="built">
                    <span class="sr-only">{fill(page.built, { stack: formatList(e.stack, lang) })}</span>
                    <span class="with" aria-hidden="true">
                      {builtWith}
                    </span>
                    {e.stack.map((item) => (
                      <span class="chip" aria-hidden="true">
                        {item}
                      </span>
                    ))}
                  </p>
                )}
                {(e.added || e.changed) && (
                  <ul class="changes">
                    {e.added?.map((line) => (
                      <li class="add">
                        <span class="kind">{t.sections.added}</span> {line}
                      </li>
                    ))}
                    {e.changed?.map((line) => (
                      <li class="chg">
                        <span class="kind">{t.sections.changed}</span> {line}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</div>

<style>
  .ascent {
    --rail: 9rem;
  }
  .camp {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--space-8);
    padding-bottom: var(--space-16);
  }
  .camp:last-child {
    padding-bottom: 0;
  }
  /* The trail: a dashed crease from the next summit down to base camp. */
  .camp::before {
    content: '';
    position: absolute;
    left: var(--rail);
    top: 0.9rem;
    bottom: 0;
    border-left: var(--stroke-crease) dashed var(--color-rule);
  }
  .camp:last-child::before {
    display: none;
  }
  /* One node per release; the current one is filled with the accent, the next one is open. */
  .camp::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 5px);
    top: 0.55rem;
    width: 11px;
    height: 11px;
    border: var(--stroke-crease) solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-bg);
  }
  .camp.current::after {
    border-color: var(--color-accent-ui);
    background: var(--color-accent-ui);
    box-shadow: 0 0 0 4px var(--color-bg);
  }
  .camp.next::after {
    border-style: dashed;
  }

  .rail {
    position: sticky;
    top: calc(var(--sticky-offset) + var(--space-4));
    align-self: start;
    margin: 0;
    padding-right: var(--space-6);
    text-align: right;
    line-height: 1;
  }
  .rail-value {
    font-size: var(--size-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .rail-unit {
    font-size: var(--size-md);
    color: var(--color-mute);
  }
  .rail-label {
    display: block;
    margin-top: var(--space-2);
    font: 600 var(--size-xs) var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .next .rail-label {
    margin-top: var(--space-1);
    color: var(--color-mute);
  }

  .head {
    margin-bottom: var(--space-6);
  }
  .major {
    margin: 0;
    font: 600 var(--size-sm) var(--font-mono);
    color: var(--color-accent);
  }
  h2 {
    margin: var(--space-1) 0;
    font-size: var(--size-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .next h2 {
    margin-top: 0;
    font-size: var(--size-lg);
  }
  .theme {
    margin: 0;
    color: var(--color-mute);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-rule);
  }
  .meta {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    margin: 0;
    font: var(--size-xs) / 1.5 var(--font-mono);
    color: var(--color-mute);
  }
  .meta code {
    font: 600 var(--size-sm) var(--font-mono);
    color: var(--color-ink);
  }
  .body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  h3 {
    margin: 0;
    font-size: var(--size-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .org {
    font-weight: 400;
    color: var(--color-mute);
  }
  /* The stack, as chips. */
  .built {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
  }
  .with {
    margin-right: 2px;
    font: 500 11px var(--font-mono);
    color: var(--color-mute);
  }
  .chip {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font: 500 12px var(--font-sans);
    color: var(--color-ink);
  }
  .lasted {
    color: var(--color-accent);
  }
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  /* What's next is a plain list of what's coming. */
  .next .changes {
    padding-left: 1.1rem;
    list-style: disc;
  }
  .next .changes li::marker {
    color: var(--color-mute);
  }
  /* Each change says its kind in words, on a small tag above it. */
  .changes li {
    max-width: 66ch;
  }
  .kind {
    display: table;
    margin-bottom: 4px;
    padding: 1px 7px;
    border-radius: 4px;
    font: 600 10px / 1.6 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .add .kind {
    color: var(--color-second);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-second) 50%, transparent);
  }
  .chg .kind {
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-accent) 50%, transparent);
  }

  /* Phones: the trail moves to the edge and the altitude sits above the release name. */
  @media (max-width: 720px) {
    .ascent {
      --rail: 0px;
    }
    .camp {
      grid-template-columns: minmax(0, 1fr);
      padding-left: var(--space-6);
    }
    .camp::before {
      left: 0;
    }
    .camp::after {
      left: -5px;
    }
    .rail {
      position: static;
      padding: 0 0 var(--space-2);
      text-align: left;
    }
    .rail-value {
      font-size: var(--size-lg);
    }
    .rail-label {
      display: inline;
      margin-left: var(--space-2);
    }
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
