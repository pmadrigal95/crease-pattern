---
/**
 * The folded portrait (decision 41): the real photo as "the interface" and the same face as
 * contour lines, "the architecture", split by a diagonal valley fold the visitor can move.
 *
 * Assets come from crease-pattern-studio/tools/depth (photo cutout, silhouette mask, contour
 * SVG); the colophon explains how. The mask ships as WebP (4 KB instead of a 15 KB PNG; only its
 * alpha matters, with edge pixels off by at most 13 of 255). The duotone is CSS: the identity's colors blended over a
 * grayscale photo (cut to the silhouette in dark themes), so it works on every identity and theme.
 *
 * Drawn as paper (doc 35): the contour side is a flap, shaded along the fold; the fold casts its
 * shadow; the handle is a paper tab; each side is named at its corner, interface and architecture.
 *
 * Reading unfolds it: on About's wide layout the portrait stays beside the story, and as the
 * reader scrolls through it the fold sweeps from the photo to the contours (a CSS scroll timeline
 * on the story, `--story`, where supported; still with reduced motion). The caption reads the
 * split. Moving the handle hands the fold back to the visitor for the rest of the visit.
 *
 * Once in view it shows its second layer: on wide screens a sweep toward the contours and back
 * before reading takes over; elsewhere the original opening, top to bottom. Without JavaScript the
 * fold rests through the nose; with reduced motion it rests there too, and follows the handle:
 * pointer or arrow keys.
 */
import { Picture } from 'astro:assets';
import portrait from '../../assets/portrait/portrait.jpg';
import contours from '../../assets/portrait/contours.svg?raw';
import { copyFor, fill } from '../../i18n/dictionary';
const copy = copyFor(Astro.currentLocale);

const REST = 39; // the fold crosses the face through the nose
const t = copy.about.portrait;
const valueText = (fold: number) => fill(t.value, { photo: fold, contours: 100 - fold });
---

<figure class="figure" data-inspect="FoldedPortrait">
  <div class="portrait" data-folded-portrait data-value-template={t.value} data-arrive>
    <div class="photo">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[360, 720]}
        sizes="(max-width: 880px) 360px, 460px"
        alt={t.alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="contours" set:html={contours} />
    <div class="crease" aria-hidden="true"></div>
    <span class="side interface" aria-hidden="true">
      {t.interface}
    </span>
    <span class="side architecture" aria-hidden="true">
      {t.architecture}
    </span>
    <div
      class="handle"
      role="slider"
      tabindex="0"
      aria-label={t.handle}
      aria-valuemin="15"
      aria-valuemax="85"
      aria-valuenow={REST}
      aria-valuetext={valueText(REST)}
    ></div>
  </div>
  <figcaption aria-hidden="true" data-fold-value>
    {valueText(REST)}
  </figcaption>
</figure>

<style>
  @property --fold {
    syntax: '<number>';
    inherits: true;
    initial-value: 39;
  }

  .figure {
    margin: 0 0 var(--space-6);
  }
  .portrait {
    --duo-high: var(--color-surface);
    --duo-low: var(--color-accent-ui);
    --cx: calc(50 + (var(--fold) - 50) * 0.71);
    position: relative;
    aspect-ratio: 1;
    max-width: 460px;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 30px 50px -34px rgb(0 0 0 / 0.45);
    background: var(--color-surface);
    overflow: hidden;
    container-type: size;
    touch-action: none;
  }
  /* Dark themes invert the duotone, so the photo's white background would glow: cut it to the
     silhouette there. Light themes don't need the mask, which keeps it off the LCP path. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait {
      --duo-high: var(--color-accent-ui);
      --duo-low: var(--color-bg);
    }
    :global(:root:not([data-theme='light'])) .photo {
      mask: url('../../assets/portrait/silhouette.webp?no-inline') center / cover no-repeat;
    }
  }
  :global(:root[data-theme='dark']) .portrait {
    --duo-high: var(--color-accent-ui);
    --duo-low: var(--color-bg);
  }
  :global(:root[data-theme='dark']) .photo {
    mask: url('../../assets/portrait/silhouette.webp?no-inline') center / cover no-repeat;
  }

  /* Duotone: grayscale × highlight, then lightened by the shadow color, cut to the person. */
  .photo {
    position: absolute;
    inset: 0;
    isolation: isolate;
    background: var(--duo-high);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--duo-low);
    mix-blend-mode: lighten;
  }

  /* Architecture: everything on the far side of the fold line. */
  /* The flap: shaded where it turns at the fold, lighter as it lies flat. */
  .contours {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-ink) 10%, var(--color-surface)) calc(var(--cx) * 1%),
      var(--color-surface) calc(var(--cx) * 1% + 22%)
    );
    clip-path: polygon(
      calc((var(--cx) - 100) * 1%) calc((var(--cx) + 100) * 1%),
      calc((var(--cx) + 100) * 1%) calc((var(--cx) - 100) * 1%),
      300% 300%
    );
  }
  .contours :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .contours :global(path) {
    fill: none;
    stroke: var(--color-mute);
    stroke-opacity: 0.6;
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .contours :global(path.major) {
    stroke: var(--color-accent-ui);
    stroke-opacity: 1;
    stroke-width: 1.75;
  }

  .crease {
    position: absolute;
    left: 0;
    top: 0;
    width: 300cqw;
    border-top: 1.5px dashed var(--color-accent-ui);
    box-shadow: 0 8px 14px -8px rgb(0 0 0 / 0.35);
    pointer-events: none;
    transform: translate(calc(var(--cx) * 1cqw), calc(var(--cx) * 1cqh)) translate(-50%, -1px) rotate(-45deg);
  }

  /* The handle only appears once the script can drive it. */
  .handle {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 56px;
    height: 44px;
    margin: -22px -28px;
    border-radius: 6px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.1),
      0 8px 18px -8px rgb(0 0 0 / 0.35);
    cursor: grab;
    transform: translate(calc(var(--cx) * 1cqw), calc(var(--cx) * 1cqh)) rotate(-45deg);
  }
  /* The tab's mark: the fold's two kinds, a mountain over a valley. */
  .handle::before {
    content: '';
    position: absolute;
    inset: 15px 14px;
    border-top: 1.5px solid var(--color-accent-ui);
    border-bottom: 1.5px dashed var(--color-accent-ui);
  }
  .handle:active {
    cursor: grabbing;
  }
  .handle:focus-visible {
    outline: 2px solid var(--color-focus, var(--color-accent-ui));
    outline-offset: 3px;
  }
  .portrait:global(.is-interactive) .handle {
    display: block;
  }

  /* The hint on wide screens: once in view, the fold sweeps toward the contours and back, to show
     there is a second layer, before the story takes it over. */
  .portrait:global(.is-hinting) {
    animation: portrait-hint 1.6s var(--motion-ease-in-out) 200ms both;
  }
  @keyframes portrait-hint {
    0%,
    100% {
      --fold: 85;
    }
    50% {
      --fold: 40;
    }
  }
  .portrait:global(.is-opening) {
    animation: portrait-open var(--motion-portrait) var(--motion-ease-in-out) 250ms both;
  }
  @keyframes portrait-open {
    from {
      --fold: 125;
    }
    to {
      --fold: 39;
    }
  }

  /* Each side named at its corner. */
  .side {
    position: absolute;
    z-index: 1;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font: 600 10px / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    pointer-events: none;
  }
  .interface {
    top: var(--space-3);
    left: var(--space-3);
  }
  .architecture {
    right: var(--space-3);
    bottom: var(--space-3);
    color: var(--color-accent);
  }
  figcaption {
    margin-top: var(--space-3);
    font: 500 var(--type-caption);
    color: var(--color-mute);
    font-variant-numeric: tabular-nums;
  }

  /* Reading unfolds it: the story's scroll timeline drives the fold, photo to contours, between 85
     and 15 so the tab always stays inside the frame, within reach. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 881px) {
      .portrait:global(.is-reading) {
        --portrait-read-timeline: --story;
        animation-name: portrait-read;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--portrait-read-timeline);
        animation-range: contain 0% contain 100%;
      }
    }
  }
  @keyframes portrait-read {
    from {
      --fold: 85;
    }
    to {
      --fold: 15;
    }
  }
</style>

<script>
  // The tab, the reading fold and the hint (src/scripts/folded-portrait.ts). About's LCP is its title
  // since the story comes first on phones, so this no longer has to be inlined.
  import { initFoldedPortraits } from '../../scripts/folded-portrait';
  initFoldedPortraits();
</script>
