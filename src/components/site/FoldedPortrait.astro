---
/**
 * The folded portrait (decision 41): the real photo as "the interface" and the same face as
 * contour lines, "the architecture", split by a diagonal valley fold the visitor can move.
 *
 * Assets come from crease-pattern-studio/tools/depth (photo cutout, silhouette mask, contour
 * SVG); the colophon explains how. The duotone is CSS: the identity's colors blended over a
 * grayscale photo and cut to the silhouette, so it works on every identity and theme.
 *
 * Without JavaScript the fold rests through the nose. With it, the fold opens once per page
 * load (not under reduced motion) and then follows the handle: pointer or arrow keys.
 */
import { Picture } from 'astro:assets';
import portrait from '../../assets/portrait/portrait.jpg';
import contours from '../../assets/portrait/contours.svg?raw';
import { copy, fill } from '../../lib/copy';

const REST = 39; // the fold crosses the face through the nose
const t = copy.about.portrait;
const valueText = (fold: number) => fill(t.value, { photo: fold, contours: 100 - fold });
---

<figure class="figure">
  <div class="portrait" data-folded-portrait data-value-template={t.value}>
    <div class="photo">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[360, 720]}
        sizes="(max-width: 880px) 360px, 300px"
        alt={t.alt}
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="contours" set:html={contours} />
    <div class="crease" aria-hidden="true"></div>
    <div
      class="handle"
      role="slider"
      tabindex="0"
      aria-label={t.handle}
      aria-valuemin="8"
      aria-valuemax="92"
      aria-valuenow={REST}
      aria-valuetext={valueText(REST)}
    ></div>
  </div>
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  @property --fold {
    syntax: '<number>';
    inherits: true;
    initial-value: 39;
  }

  .figure {
    margin: 0 0 var(--space-6);
  }
  .portrait {
    --duo-high: var(--color-surface);
    --duo-low: var(--color-accent-ui);
    --cx: calc(50 + (var(--fold) - 50) * 0.71);
    position: relative;
    aspect-ratio: 1;
    max-width: 360px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    overflow: hidden;
    container-type: size;
    touch-action: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait {
      --duo-high: var(--color-accent-ui);
      --duo-low: var(--color-bg);
    }
  }
  :global(:root[data-theme='dark']) .portrait {
    --duo-high: var(--color-accent-ui);
    --duo-low: var(--color-bg);
  }

  /* Duotone: grayscale × highlight, then lightened by the shadow color, cut to the person. */
  .photo {
    position: absolute;
    inset: 0;
    isolation: isolate;
    background: var(--duo-high);
    -webkit-mask: url('../../assets/portrait/silhouette.png') center / cover no-repeat;
    mask: url('../../assets/portrait/silhouette.png') center / cover no-repeat;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--duo-low);
    mix-blend-mode: lighten;
  }

  /* Architecture: everything on the far side of the fold line. */
  .contours {
    position: absolute;
    inset: 0;
    background: var(--color-surface);
    clip-path: polygon(
      calc((var(--cx) - 100) * 1%) calc((var(--cx) + 100) * 1%),
      calc((var(--cx) + 100) * 1%) calc((var(--cx) - 100) * 1%),
      300% 300%
    );
  }
  .contours :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .contours :global(path) {
    fill: none;
    stroke: var(--color-mute);
    stroke-opacity: 0.6;
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .contours :global(path.major) {
    stroke: var(--color-accent-ui);
    stroke-opacity: 1;
    stroke-width: 1.75;
  }

  .crease {
    position: absolute;
    left: 0;
    top: 0;
    width: 300cqw;
    border-top: 2px dashed var(--color-ink);
    opacity: 0.7;
    pointer-events: none;
    transform: translate(calc(var(--cx) * 1cqw), calc(var(--cx) * 1cqh)) translate(-50%, -1px) rotate(-45deg);
  }

  /* The handle only appears once the script can drive it. */
  .handle {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin: -22px;
    border-radius: 50%;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
    cursor: grab;
    transform: translate(calc(var(--cx) * 1cqw), calc(var(--cx) * 1cqh));
  }
  .handle::before {
    content: '';
    position: absolute;
    inset: 15px;
    border-top: 2px solid var(--color-mute);
    border-bottom: 2px solid var(--color-mute);
    transform: rotate(45deg);
  }
  .handle:active {
    cursor: grabbing;
  }
  .handle:focus-visible {
    outline: 2px solid var(--color-focus, var(--color-accent-ui));
    outline-offset: 3px;
  }
  .portrait:global(.is-interactive) .handle {
    display: block;
  }

  .portrait:global(.is-opening) {
    animation: portrait-open 1600ms var(--motion-ease-in-out) 250ms both;
  }
  @keyframes portrait-open {
    from {
      --fold: 125;
    }
    to {
      --fold: 39;
    }
  }

  figcaption {
    margin-top: var(--space-2);
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
</style>

<script>
  const MIN = 8;
  const MAX = 92;
  const REST = 39;

  for (const el of document.querySelectorAll<HTMLElement>('[data-folded-portrait]')) {
    const handle = el.querySelector<HTMLElement>('.handle');
    const template = el.dataset.valueTemplate ?? '';
    if (!handle) continue;

    const set = (value: number) => {
      const fold = Math.round(Math.min(MAX, Math.max(MIN, value)));
      el.classList.remove('is-opening');
      el.style.setProperty('--fold', String(fold));
      handle.setAttribute('aria-valuenow', String(fold));
      handle.setAttribute(
        'aria-valuetext',
        template.replace('{photo}', String(fold)).replace('{contours}', String(100 - fold)),
      );
    };
    const current = () => Number(handle.getAttribute('aria-valuenow')) || REST;

    el.classList.add('is-interactive');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-opening');
      el.addEventListener('animationend', () => set(REST), { once: true });
    }

    let dragging = false;
    handle.addEventListener('pointerdown', (e) => {
      dragging = true;
      handle.setPointerCapture(e.pointerId);
    });
    handle.addEventListener('pointerup', () => (dragging = false));
    handle.addEventListener('pointercancel', () => (dragging = false));
    handle.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const r = el.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * 100 - 50;
      const y = ((e.clientY - r.top) / r.height) * 100 - 50;
      set(50 + (x + y) / 2 / 0.71);
    });
    handle.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 4, ArrowDown: 4, ArrowLeft: -4, ArrowUp: -4, PageDown: 12, PageUp: -12 }[
        e.key
      ];
      const edge = { Home: MIN, End: MAX }[e.key];
      if (step === undefined && edge === undefined) return;
      e.preventDefault();
      set(edge ?? current() + (step ?? 0));
    });
  }
</script>
