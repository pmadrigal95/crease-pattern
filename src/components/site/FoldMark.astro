---
/** Provisional mark: a sheet with one diagonal fold. The origami fox replaces it later. */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path class="sheet" d="M4 4h24v24H4z"></path>
  <path class="fold" d="M4 4h24L4 28z"></path>
  <path class="crease" d="M28 4 4 28" fill="none" stroke-width="1.5"></path>
</svg>

<style>
  .sheet {
    fill: var(--color-accent);
  }
  .fold {
    fill: var(--color-accent-ui);
  }
  .crease {
    stroke: var(--color-bg);
  }
  /* First visit (decision 42): the flap starts folded over the crease and opens into place. */
  :global(.intro) .fold {
    transform-box: view-box;
    transform-origin: 16px 16px;
    animation: mark-fold calc(var(--motion-intro) * 2) var(--motion-ease-out) both;
  }
  @keyframes mark-fold {
    from {
      transform: rotate3d(1, -1, 0, 180deg);
    }
  }
</style>
