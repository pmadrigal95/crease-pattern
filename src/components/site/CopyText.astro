---
/**
 * A value people copy (the contact email, a feed address): the value as a link, a copy button,
 * and a live region that confirms the copy. Without clipboard access it selects the text instead.
 */
interface Props {
  /** The text that gets copied and shown. */
  value: string;
  /** Where the value links to (mailto:, the feed). */
  href: string;
  copyLabel: string;
  copiedLabel: string;
}
const { value, href, copyLabel, copiedLabel } = Astro.props;
---

<div class="copy-text" data-inspect="CopyText">
  <a class="address" href={href}>
    {value}
  </a>
  <button type="button" class="btn" data-copy={value} data-done={copiedLabel}>
    {copyLabel}
  </button>
  <span class="status" role="status" aria-live="polite"></span>
</div>

<script>
  // Copies the value and confirms in a live region; falls back to selecting the text.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-text .btn')) {
    button.addEventListener('click', async () => {
      const root = button.closest('.copy-text');
      const status = root?.querySelector<HTMLElement>('.status');
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (status) status.textContent = button.dataset.done ?? '';
      } catch {
        const address = root?.querySelector('.address');
        if (address) window.getSelection()?.selectAllChildren(address);
      }
    });
  }
</script>

<style>
  .copy-text {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
  }
  .address {
    font-size: var(--size-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .btn {
    font: 600 var(--size-sm) var(--font-sans);
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    padding: 0 var(--space-4);
    min-height: 44px;
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--motion-ease-out);
  }
  .btn:hover {
    border-color: var(--color-accent-ui);
  }
  .status {
    font: 500 var(--type-caption);
    color: var(--color-second);
  }
</style>
