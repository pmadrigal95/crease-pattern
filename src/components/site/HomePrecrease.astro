---
/**
 * Precrease on the home page in the zine's own voice (design debt phase 4; cover, doc 32): the
 * wordmark over a rule, the latest Crease as a cover, and the two before it as cards.
 *
 * - The cover's sheet is the post's generated crease pattern (PostThumb), stamped with its number,
 *   labelled ("Crease No. 003"): the only number here. Lists say what a post is in words, its kind
 *   and its branch of the topic tree, as PostCard does; a bare number would read as a rank.
 * - The cover's motion, and what inspecting shows, live with it (PrecreaseCover.astro).
 * - Empty: no posts, the intro says the first is coming and nothing else shows; one, the cover.
 *
 * Newsreader, the zine's serif, is heavy as Precrease loads it (a variable font, 280 KB). Here
 * three static weights of the same family (about 70 KB) load only as the section approaches;
 * until then, and without JavaScript, a system serif stands in.
 */
import '../../styles/buttons-quiet.css';
import newsreader400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import newsreader600 from '@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url';
import newsreader300Italic from '@fontsource/newsreader/files/newsreader-latin-300-italic.woff2?url';
import PostThumb from '../precrease/PostThumb.astro';
import PrecreaseCover from './PrecreaseCover.astro';
import { copyFor, fill } from '../../i18n/dictionary';
import { formatDate } from '../../lib/format';
import { getPosts, postHref, postKind, type PostSummary } from '../../lib/precrease';
import { readingMinutes } from '../../lib/reading';
import { topicsFor } from '../../lib/taxonomy';
import { LOCALES, langOf, localize } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(Astro.currentLocale);

const t = copy.home.notes;
/** A post not yet in this page's language shows its original: its language, for lang="" and the label. */
const otherLang = (post: { lang: string }) =>
  post.lang === lang ? undefined : LOCALES[langOf(post.lang)].htmlLang;
const [latest, ...older] = (await getPosts(lang)).slice(0, 3);
const topics = topicsFor(lang);
/** A post's first topic with its parent in the tree: "Systems › Concurrency". */
const branch = (post: PostSummary) => {
  const own = topics.find((topic) => topic.id === post.entry.data.topics[0]);
  const parent = topics.find((topic) => topic.id === own?.parent);
  return [parent?.label, own?.label].filter(Boolean).join(' › ');
};
const minutes = (post: PostSummary) =>
  fill(copy.precrease.minutes, { minutes: readingMinutes(post.entry.body ?? '') });
const fonts = JSON.stringify([
  { url: newsreader400, weight: '400', style: 'normal' },
  { url: newsreader600, weight: '600', style: 'normal' },
  { url: newsreader300Italic, weight: '300', style: 'italic' },
]);
---

<section
  class="sec home-precrease"
  id="precrease"
  aria-labelledby="precrease-title"
  data-inspect="HomePrecrease"
  data-home-precrease
  data-fonts={fonts}
>
  <div class="wrap">
    <div class="head">
      <h2 id="precrease-title" class="word">
        <span class="pre">Pre</span>
        <span class="crease">crease</span>
      </h2>
      <p class="intro">{latest ? t.intro : t.empty}</p>
    </div>
    {latest && (
      <PrecreaseCover
        post={latest}
        branch={branch(latest)}
        minutes={minutes(latest)}
        otherLang={otherLang(latest)}
      />
    )}
    {older.length > 0 && (
      <div class="cards">
        {older.map((p) => (
          <article class="card">
            <span class="sheet" aria-hidden="true">
              <PostThumb slug={p.key} format={p.entry.data.format} />
            </span>
            <div>
              <p class="kind">{branch(p)}</p>
              <h3>
                <a href={postHref(p)} lang={otherLang(p)}>
                  {p.entry.data.title}
                </a>
              </h3>
              <p class="meta">
                {postKind(p.entry, lang)} · {formatDate(p.entry.data.date, lang)} · {minutes(p)}
                {otherLang(p) && <> · {copy.precrease.untranslated}</>}
              </p>
            </div>
          </article>
        ))}
      </div>
    )}
    {latest && (
      <p class="more">
        <a class="action" href={localize('/precrease', lang)}>
          {t.all}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    )}
  </div>
</section>

<script>
  // Self-contained (ENGINEERING.md, "Browser scripts"): loads the section's serif half a screen
  // before it comes into view, so the first load pays nothing for it.
  const section = document.querySelector<HTMLElement>('[data-home-precrease]');
  if (section && 'FontFace' in window)
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const fonts = JSON.parse(section.dataset.fonts ?? '[]') as {
          url: string;
          weight: string;
          style: string;
        }[];
        for (const f of fonts)
          new FontFace('Newsreader Home', `url(${f.url}) format('woff2')`, {
            weight: f.weight,
            style: f.style,
            display: 'swap',
          })
            .load()
            .then((face) => document.fonts.add(face))
            .catch(() => undefined); // the system serif stays
      },
      { rootMargin: '0px 0px 50% 0px' },
    ).observe(section);
</script>

<style>
  .home-precrease {
    --serif: 'Newsreader Home', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --lift: color-mix(in oklab, var(--color-ink) 55%, transparent);
    border-top: 1px solid var(--color-rule);
  }
  .home-precrease > .wrap {
    padding-block: var(--space-16);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-12);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-ink);
  }
  .word {
    margin: 0;
    font: 600 clamp(2.75rem, 5.6vw, 4.25rem) / 1 var(--serif);
    letter-spacing: -0.02em;
  }
  .pre {
    font-style: italic;
    font-weight: 300;
  }
  .crease {
    color: var(--color-accent);
  }
  .intro {
    max-width: 44ch;
    margin: 0;
    font-size: var(--size-sm);
    color: var(--color-mute);
  }
  .kind {
    margin: 0;
    font: 600 var(--size-xs) / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .meta {
    margin: 0;
    font-size: var(--size-xs);
    color: var(--color-mute);
  }
  .card h3 a {
    text-decoration: none;
  }
  .card h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--color-accent-ui);
  }

  /* The two before it. A card is one link: its title, stretched over the card. */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-rule);
  }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
  }
  .card + .card {
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-rule);
  }
  .card .sheet {
    display: block;
    box-shadow: 0 14px 22px -18px var(--lift);
    transition: transform 0.5s var(--ease);
  }
  .card:hover .sheet,
  .card:focus-within .sheet {
    transform: translateY(-4px) rotate(-2deg);
  }
  .card h3 {
    margin: var(--space-1) 0 var(--space-2);
    font: 500 var(--size-xl) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* Inspecting lays the sheets flat, as the cover's (PrecreaseCover.astro). */
  :global(.inspecting) .card .sheet {
    box-shadow: none;
    transform: none;
  }
  .more {
    margin: var(--space-8) 0 0;
  }

  @media (max-width: 860px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card + .card {
      padding-left: 0;
      border-top: 1px solid var(--color-rule);
      border-left: 0;
    }
  }
</style>
