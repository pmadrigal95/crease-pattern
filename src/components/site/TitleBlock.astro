---
/**
 * A title block: the box in a plan's corner that says what the sheet is (doc 40). The colophon's
 * is about the build, the privacy page's about what the site keeps. A value can be a placeholder
 * the build fills in afterwards (data-metric, scripts/stamp-site-metrics.ts).
 */
interface Row {
  label: string;
  value: string;
  /** Across the whole block. */
  wide?: boolean;
  /** Filled after the build: the value shows until then. */
  metric?: string;
}
interface Props {
  /** Read aloud: what the block is about. */
  label: string;
  rows: Row[];
}
const { label, rows } = Astro.props;
---

<section class="title-block" aria-label={label} data-inspect="TitleBlock">
  <dl>
    {rows.map((r) => (
      <div class:list={{ wide: r.wide }}>
        <dt>{r.label}</dt>
        <dd>{r.metric ? <span data-metric={r.metric}>{r.value}</span> : r.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .title-block {
    border: 1px solid color-mix(in oklab, var(--color-ink) 40%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
    font: 12px/1.4 var(--font-mono);
  }
  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }
  dl > div {
    padding: 8px 12px;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 18%, transparent);
    border-left: 1px solid color-mix(in oklab, var(--color-ink) 18%, transparent);
  }
  dl > div:nth-child(-n + 2) {
    border-top: 0;
  }
  dl > div:nth-child(odd) {
    border-left: 0;
  }
  dl > .wide {
    grid-column: 1 / -1;
    border-left: 0;
  }
  dt {
    font-size: 10px;
    color: var(--color-mute);
  }
  dd {
    margin: 0;
    color: var(--color-ink);
  }
</style>
