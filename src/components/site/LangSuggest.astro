---
/**
 * The suggestion to read a page in the other language (M5, decision 2), written in that language.
 * Rendered hidden on pages that have a pair; src/scripts/lang.ts shows it when the browser's
 * languages prefer the other one and the visitor hasn't chosen a language or dismissed it yet.
 * Fixed at the bottom of the window, so showing it never moves the page.
 */
import { copyFor } from '../../lib/copy';
import { langOf, otherLang, type Translations } from '../../lib/i18n';

interface Props {
  translations: Translations;
}
const other = otherLang(langOf(Astro.currentLocale));
const href = Astro.props.translations[other];
const t = copyFor(other).lang;
---

{href && (
  <aside class="suggest" lang={other} aria-label={t.name} data-lang-suggest={other} hidden>
    <p>{t.suggest}</p>
    <a href={href} hreflang={other} data-lang-switch={other}>
      {t.suggestAction}
    </a>
    <button type="button" data-lang-dismiss>
      {t.dismiss}
    </button>
  </aside>
)}

<style>
  .suggest {
    position: fixed;
    left: max(var(--space-4), env(safe-area-inset-left));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: 25;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: min(440px, calc(100vw - 2 * var(--space-4)));
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--size-sm);
    box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--color-ink) 35%, transparent);
  }
  .suggest[hidden] {
    display: none;
  }
  p {
    margin: 0;
    flex-basis: 100%;
  }
  a,
  button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font: inherit;
  }
  a {
    font-weight: 600;
    text-decoration-color: var(--color-accent-ui);
    text-underline-offset: 4px;
  }
  button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-mute);
    cursor: pointer;
  }
  button:hover {
    color: var(--color-ink);
  }
  /* Phones: clear of the floating ⌘K button in the other corner. */
  @media (max-width: 720px) {
    .suggest {
      max-width: calc(100vw - 2 * var(--space-4) - 52px - var(--space-3));
    }
  }
  :global(.inspecting) .suggest {
    display: none;
  }
</style>
