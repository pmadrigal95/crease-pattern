---
/**
 * The home page's close as a postcard from Costa Rica (doc 33, direction C). Its back is the message:
 * the line, the signature, the address to write to (CopyText) and a postmark with the hero's
 * coordinates and the local time there (Postmark.astro). Its front is the Irazú in contour lines
 * (PostcardFront.astro).
 *
 * - It lands on the table as it scrolls in (CSS scroll timeline, where supported).
 * - A button turns it over to its front and back; with reduced motion it crossfades instead. The
 *   hidden face is inert, so focus and screen readers stay on the one shown. Without JavaScript
 *   the back stays, the button stays hidden, and the address and its copy button still work.
 * - Copying the address stamps it "Copied" (the copy button's own outcome, CopyText.astro).
 * - While inspecting it comes apart into its print layers, each named: paper, ink, stamp,
 *   postmark. Transforms only, so nothing on the page moves.
 */
import CopyText from './CopyText.astro';
import OrigamiMark from './OrigamiMark.astro';
import PostcardFront from './PostcardFront.astro';
import Postmark from './Postmark.astro';
import { copyFor } from '../../i18n/dictionary';
import { coordsText } from '../../lib/coords';
import { getProfile } from '../../lib/profile';
const copy = copyFor(Astro.currentLocale);
const profile = await getProfile(Astro.currentLocale);

const t = copy.home.contact;
const p = t.postcard;
const coords = coordsText(profile.city.lat, profile.city.lon, copy.home.hero.coords);
---

<div class="postcard" data-inspect="ContactPostcard" data-postcard>
  <div class="faces">
    <div class="face back">
      <div class="ink message">
        <h2 id="contact-title">{t.heading}</h2>
        <p class="line">{t.intro}</p>
        <p class="sig">{profile.name}</p>
      </div>
      <div class="divider" aria-hidden="true"></div>
      <div class="side">
        <div class="top">
          <Postmark ring={`${p.place} · ${coords} ·`.toUpperCase()} />
          <span class="stamp" aria-hidden="true">
            <OrigamiMark size={52} />
          </span>
        </div>
        <div class="ink address">
          <p class="to">{p.to}</p>
          <CopyText
            value={profile.contact.email}
            href={`mailto:${profile.contact.email}`}
            copyLabel={t.copy}
            copiedLabel={t.copied}
            failedLabel={t.copyFailed}
          />
        </div>
      </div>
      <span class="cancel" aria-hidden="true">
        {t.copied}
      </span>
      <span class="layer l-paper" aria-hidden="true">
        {p.layers.paper}
      </span>
      <span class="layer l-ink" aria-hidden="true">
        {p.layers.ink}
      </span>
      <span class="layer l-stamp" aria-hidden="true">
        {p.layers.stamp}
      </span>
      <span class="layer l-postmark" aria-hidden="true">
        {p.layers.postmark}
      </span>
    </div>
    <div class="face front" role="img" aria-label={p.label} inert>
      <PostcardFront />
    </div>
  </div>
</div>
<p class="turn">
  <button type="button" class="action" data-turn hidden>
    <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5v2.6h-2.6"></path>
    </svg>
    <span data-front={p.front} data-back={p.back}>
      {p.front}
    </span>
  </button>
</p>

<script>
  // The postmark's clock, turning the card over, and the stamp when the address is copied.
  import { formatOwnerTime } from '../../lib/format';
  import { langOf } from '../../i18n/routing';

  for (const card of document.querySelectorAll<HTMLElement>('[data-postcard]')) {
    const clock = card.querySelector('[data-clock]');
    const lang = langOf(document.documentElement.lang);
    const tick = () => clock && (clock.textContent = formatOwnerTime(new Date(), lang));
    tick();
    setInterval(tick, 20_000);

    const [back, front] = [...card.querySelectorAll<HTMLElement>('.face')];
    const turn = card.parentElement?.querySelector<HTMLButtonElement>('[data-turn]');
    if (turn && back && front) {
      turn.hidden = false;
      turn.addEventListener('click', () => {
        const flipped = card.classList.toggle('flipped');
        front.inert = !flipped;
        back.inert = flipped;
        const label = turn.querySelector<HTMLElement>('[data-front]');
        if (label) label.textContent = (flipped ? label.dataset.back : label.dataset.front) ?? '';
      });
    }

    const copyButton = card.querySelector<HTMLButtonElement>('.copy-text .btn');
    if (copyButton)
      new MutationObserver(() => {
        if (copyButton.dataset.outcome !== 'done') return;
        card.classList.remove('stamped');
        void card.offsetWidth; // restarts the stamp's animation
        card.classList.add('stamped');
      }).observe(copyButton, { attributes: true, attributeFilter: ['data-outcome'] });
  }
</script>

<style>
  .postcard {
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --serif: 'Newsreader Home', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    max-width: 820px;
    perspective: 1600px;
  }
  .faces {
    display: grid;
    transform-style: preserve-3d;
    transform: rotate(-1.2deg);
    transition: transform 0.9s var(--ease);
  }
  .postcard:hover .faces {
    transform: rotate(0deg);
  }
  .face {
    grid-area: 1 / 1;
    position: relative;
    min-height: 420px;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    /* Paper on the table: black shadows only (the ink token is light in the dark theme). */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 1px 2px rgb(0 0 0 / 0.1),
      0 12px 24px -14px rgb(0 0 0 / 0.22),
      0 40px 56px -36px rgb(0 0 0 / 0.4);
    backface-visibility: hidden;
  }
  .back {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-8);
  }
  .front {
    overflow: hidden;
    transform: rotateY(180deg);
    pointer-events: none;
  }
  .flipped .back {
    pointer-events: none;
  }
  .flipped .faces {
    transform: rotateY(180deg);
  }

  /* The back: message, divider, postmark and stamp, address. */
  .message {
    align-self: end;
  }
  h2 {
    margin: 0 0 var(--space-2);
    font: 500 var(--size-xs) var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-mute);
  }
  .line {
    max-width: 18ch;
    margin: 0;
    font: italic 300 clamp(1.75rem, 3.4vw, 2.75rem) / 1.15 var(--serif);
  }
  .sig {
    margin: var(--space-4) 0 0;
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
  .divider {
    background: var(--color-rule);
  }
  .side {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .stamp {
    display: grid;
    place-items: center;
    width: 84px;
    aspect-ratio: 0.82;
    background: var(--color-bg);
    outline: 2px dashed var(--color-rule);
    outline-offset: -1px;
  }
  .address {
    align-self: end;
  }
  .to {
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
  .address :global(.address) {
    font: 500 clamp(1rem, 1.9vw, 1.375rem) var(--serif);
  }
  .cancel {
    position: absolute;
    top: 38%;
    right: 12%;
    padding: 8px 14px;
    border: 2px solid var(--color-accent-ui);
    border-radius: 6px;
    color: var(--color-accent-ui);
    font: 700 var(--size-sm) var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    rotate: -12deg;
  }
  .stamped .cancel {
    animation: stamp 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .stamped .back {
    animation: press 0.3s ease-out;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      scale: 1.6;
    }
    to {
      opacity: 0.9;
      scale: 1;
    }
  }
  @keyframes press {
    50% {
      translate: 0 2px;
    }
  }

  /* Turning it over: a quiet text action under the card's right edge, so it never competes with
     the copy button on the card. */
  .turn {
    max-width: 820px;
    margin: var(--space-8) 0 0;
    text-align: right;
  }
  .turn .action {
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .glyph {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition: rotate 0.6s var(--ease);
  }
  .turn .action:hover .glyph {
    rotate: 90deg;
  }

  /* Inspecting: the back comes apart into its print layers, each named. Transforms only. */
  .layer {
    display: none;
    position: absolute;
    padding: 2px 6px;
    border: 1px dashed var(--color-accent);
    background: var(--color-bg);
    color: var(--color-accent);
    font: 500 10px / 1.3 var(--font-mono);
  }
  .l-paper {
    top: var(--space-3);
    left: var(--space-3);
  }
  .l-ink {
    bottom: var(--space-3);
    left: var(--space-8);
  }
  /* The postmark's and the stamp's names, stacked under the row they share. */
  .l-postmark {
    top: 176px;
    left: calc(50% + var(--space-4));
  }
  .l-stamp {
    top: 200px;
    left: calc(50% + var(--space-4));
  }
  :global(.inspecting) .layer {
    display: block;
  }
  :global(.inspecting) .faces {
    transform: none;
  }
  :global(.inspecting) .front {
    visibility: hidden;
  }
  :global(.inspecting) .back {
    visibility: visible;
  }
  :global(.inspecting) .ink,
  :global(.inspecting) .stamp,
  :global(.inspecting) .top :global(.postmark) {
    outline: 1px dashed color-mix(in oklab, var(--color-accent) 60%, transparent);
    outline-offset: 4px;
    transition: translate 0.6s var(--ease);
  }
  :global(.inspecting) .ink {
    translate: -10px -10px;
  }
  :global(.inspecting) .top :global(.postmark) {
    translate: -20px -20px;
  }
  :global(.inspecting) .stamp {
    translate: -30px -30px;
  }

  /* It lands on the table as it scrolls in. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .postcard {
        view-timeline-name: --postcard;
      }
      .face {
        --land-timeline: --postcard;
        animation-name: land;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--land-timeline);
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes land {
    from {
      translate: 0 40px;
      rotate: -5deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faces,
    .flipped .faces,
    .front {
      transform: none;
      transition: none;
    }
    .face {
      transition: opacity 0.3s ease-out;
    }
    .front,
    .flipped .back {
      opacity: 0;
    }
    .flipped .front {
      opacity: 1;
    }
  }
  @media (max-width: 760px) {
    .back {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding: var(--space-6);
    }
    .divider {
      display: none;
    }
    .face {
      min-height: 0;
    }
  }
</style>
