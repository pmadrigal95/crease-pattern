---
import FoxMark from './FoxMark.astro';
import { copyFor, fill } from '../../i18n/dictionary';
import { publicPath } from '../../lib/url';
import { LOCALES, languageLinks, langOf, localize, unlocalize, type Translations } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang);

interface Props {
  name: string;
  /** For the command menu's "Copy email address". */
  email: string;
  /** Where this page lives in each language (src/i18n/routing.ts), for the language switch. */
  translations: Translations;
}
const { name, email, translations } = Astro.props;
const path = publicPath(Astro.url.pathname);
// Every other language: this page in it (or the closest page that is), its code and its name.
const otherLanguages = languageLinks(path, translations, lang).filter((l) => !l.current);
// The command menu's strings, read by command-menu.ts when the menu first opens. Each language's
// action is worded in that language.
const commandStrings = JSON.stringify({
  ...copy.commands,
  languages: otherLanguages.map((l) => ({ lang: l.lang, label: copyFor(l.lang).lang.switch })),
  number: copy.precrease.number,
  email,
  identities: copy.identities,
});
// The Inspector's strings, in the page's language, read by the panel when it first opens.
const inspectorStrings = JSON.stringify({ ...copy.inspector, identities: copy.identities });

const home = localize('/', lang);
const links = [
  { href: `${home}#work`, label: copy.nav.work, match: null },
  { href: localize('/changelog', lang), label: copy.nav.changelog, match: '/changelog' },
  { href: localize('/precrease', lang), label: copy.nav.precrease, match: '/precrease' },
  { href: localize('/about', lang), label: copy.nav.about, match: '/about' },
];
const here = unlocalize(path);
---

<header class="mast" data-inspect="Masthead">
  <div class="wrap">
    <a class="me" href={home} aria-label={fill(copy.labels.home, { name })}>
      <FoxMark />
      <span>{name}</span>
    </a>
    <nav aria-label={copy.labels.main}>
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.match && (here === l.match || here.startsWith(`${l.match}/`)) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <!-- The language switch (M5): each other language's code; its name, in that language, for
         screen readers. Choosing one is remembered (src/scripts/lang.ts). -->
    {otherLanguages.map((l) => (
      <a class="lang" href={l.href} hreflang={l.lang} lang={l.lang} data-lang-switch={l.lang}>
        {LOCALES[l.lang].code}
        <span class="sr-only"> · {LOCALES[l.lang].name}</span>
      </a>
    ))}
    <button
      type="button"
      class="inspect"
      aria-expanded="false"
      aria-keyshortcuts="Shift+I"
      data-inspector-toggle
      data-strings={inspectorStrings}
    >
      <svg class="icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M3 7h10v10H3z" />
        <path d="M7 3h10v10" />
      </svg>
      <span class="label">{copy.inspector.open}</span>
      <kbd aria-hidden="true">{copy.inspector.shortcut}</kbd>
    </button>
    <!-- The command menu (M4.7). Phones: the same button, floating in the bottom corner. -->
    <button
      type="button"
      class="commands"
      aria-label={copy.commands.open}
      aria-keyshortcuts="Control+K Meta+K"
      data-command-open
      data-strings={commandStrings}
    >
      <svg class="glass" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m13 13 4.5 4.5"></path>
      </svg>
      <kbd aria-hidden="true" data-shortcut>
        {copy.commands.shortcut}
      </kbd>
    </button>
  </div>
</header>

<script>
  // The language switch, here and in the footer, and the suggestion to read in the other
  // language (M5). Imported only here, so it joins this script instead of adding a request.
  import { initLanguage } from '../../scripts/lang';
  initLanguage();
  // Opens the Inspector (decision 44): the button, any [data-inspector-open], Shift+I or ?inspect. Vue and the
  // panel download only now, on first use; hovering the button starts that download early.
  type Handle = { close(): void };
  // Same rule as isTypingTarget in src/lib/keyboard.ts, kept local: this script runs on every page,
  // and importing a helper shared with Precrease search would add a chained request to each one.
  const isTypingTarget = (el: EventTarget | null) =>
    el instanceof HTMLElement &&
    (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName));
  const button = document.querySelector<HTMLButtonElement>('[data-inspector-toggle]');
  let handle: Handle | null = null;
  let loading = false;
  const load = () => import('../inspector/mount');

  async function open(trigger: HTMLElement | null) {
    if (handle || loading) return;
    loading = true;
    try {
      const { openInspector } = await load();
      handle = await openInspector(trigger, () => {
        handle = null;
        button?.setAttribute('aria-expanded', 'false');
      });
      button?.setAttribute('aria-expanded', 'true');
    } catch (error) {
      // Offline, or the manifest didn't arrive: the page stays as it was, and the next try retries.
      console.warn('Inspector could not open', error);
    } finally {
      loading = false;
    }
  }
  const toggle = (trigger: HTMLElement | null) => (handle ? handle.close() : open(trigger));

  button?.addEventListener('click', () => toggle(button));
  // Other openers on the page (the home hero's "See how this page is built") share the same panel.
  for (const opener of document.querySelectorAll<HTMLElement>('[data-inspector-open]')) {
    opener.addEventListener('click', () => toggle(opener));
    opener.addEventListener('pointerenter', () => void load(), { once: true });
  }
  button?.addEventListener('pointerenter', () => void load(), { once: true });
  // A pointer resting on the hero's fox preloads too: loading the Inspector also starts M4's 3D
  // scene on devices that can run it (decision 50), so it's ready if the visitor opens it.
  document
    .querySelector('[data-hero-fold] [data-stage]')
    ?.addEventListener('pointerenter', () => void load(), { once: true });
  // The command menu (M4.7): one menu for every page, loaded on first use; hovering its button
  // starts the download early. Ctrl+K everywhere, Cmd+K on Apple devices.
  const commandButton = document.querySelector<HTMLButtonElement>('[data-command-open]');
  const commandMenu = () => import('./command-menu');
  const openCommands = (from: HTMLElement | null) => {
    const strings = commandButton?.dataset.strings;
    if (!strings) return;
    void commandMenu()
      .then((m) => m.openCommandMenu(JSON.parse(strings) as Parameters<typeof m.openCommandMenu>[0], from))
      .catch((error: unknown) => console.warn('Commands could not open', error));
  };
  commandButton?.addEventListener('click', () => openCommands(commandButton));
  commandButton?.addEventListener('pointerenter', () => void commandMenu(), { once: true });
  const shortcut = commandButton?.querySelector('[data-shortcut]');
  if (shortcut && /Mac|iPhone|iPad/.test(navigator.platform)) shortcut.textContent = '⌘ K';
  addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 'k' || !(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey) return;
    e.preventDefault();
    const active = document.activeElement;
    openCommands(active instanceof HTMLElement && active !== document.body ? active : commandButton);
  });
  addEventListener('keydown', (e) => {
    if (
      !e.shiftKey ||
      e.ctrlKey ||
      e.metaKey ||
      e.altKey ||
      e.key.toLowerCase() !== 'i' ||
      isTypingTarget(e.target)
    )
      return;
    e.preventDefault();
    // Focus goes back where it was on close; with nothing focused, to the Inspect button.
    const active = document.activeElement;
    toggle(active instanceof HTMLElement && active !== document.body ? active : button);
  });
  if (new URLSearchParams(location.search).has('inspect')) void open(button);
</script>

<style>
  .mast {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
  }
  .mast .wrap {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
  }
  .me {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-1);
  }
  nav a {
    font-size: var(--size-sm);
    color: var(--color-mute);
    text-decoration: none;
    padding: 0 var(--space-2);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-ui);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .lang {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 44px;
    font: 500 var(--type-caption);
    letter-spacing: 0.04em;
    color: var(--color-mute);
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }
  .lang:hover {
    color: var(--color-ink);
  }
  .inspect {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    margin-left: var(--space-2);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--size-sm);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--motion-ease-out);
  }
  .inspect:hover,
  .inspect[aria-expanded='true'] {
    border-color: var(--color-accent-ui);
  }
  .inspect .icon {
    display: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .inspect kbd {
    font: 500 var(--type-caption);
    color: var(--color-mute);
  }
  @media (pointer: coarse) {
    .inspect kbd {
      display: none;
    }
  }
  .commands {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--size-sm);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--motion-ease-out);
  }
  .commands:hover {
    border-color: var(--color-accent-ui);
  }
  .commands .glass {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .commands kbd {
    font: 500 var(--type-caption);
    color: var(--color-mute);
  }
  /* Phones: a round button in the bottom corner, clear of the home indicator and the notch. */
  @media (max-width: 720px) {
    .commands {
      position: fixed;
      right: max(var(--space-4), env(safe-area-inset-right));
      bottom: max(var(--space-4), env(safe-area-inset-bottom));
      z-index: 30;
      width: 52px;
      height: 52px;
      justify-content: center;
      padding: 0;
      background: var(--color-surface);
      box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--color-ink) 45%, transparent);
    }
    .commands .glass {
      width: 20px;
      height: 20px;
    }
    .commands kbd {
      display: none;
    }
    :global(.inspecting) .commands {
      display: none;
    }
  }
  /* Narrow screens: the button keeps its name for assistive tech but shows only the layers icon. */
  @media (max-width: 560px) {
    .inspect {
      flex-shrink: 0;
      width: 40px;
      min-height: 40px;
      padding: 0;
      justify-content: center;
    }
    .inspect .icon {
      display: block;
    }
    .inspect .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .inspect kbd {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .me span {
      display: none;
    }
    nav a {
      padding: 0 var(--space-1);
    }
  }
  /* The narrowest phones (320 px): smaller links so the logo, the menu and Inspect share one row. */
  @media (max-width: 380px) {
    .mast .wrap {
      gap: var(--space-2);
    }
    nav a {
      font-size: var(--size-xs);
    }
  }
</style>
