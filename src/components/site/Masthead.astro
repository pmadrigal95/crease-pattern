---
import FoxMark from './FoxMark.astro';
import { copy } from '../../lib/copy';
import { publicPath } from '../../lib/url';

interface Props {
  name: string;
}
const { name } = Astro.props;

const links = [
  { href: '/#work', label: copy.nav.work, match: null },
  { href: '/changelog', label: copy.nav.changelog, match: '/changelog' },
  { href: '/precrease', label: copy.nav.precrease, match: '/precrease' },
  { href: '/about', label: copy.nav.about, match: '/about' },
];
const path = publicPath(Astro.url.pathname);
---

<header class="mast" data-inspect="Masthead">
  <div class="wrap">
    <a class="me" href="/" aria-label={`${name}, home`}>
      <FoxMark />
      <span>{name}</span>
    </a>
    <nav aria-label={copy.labels.main}>
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.match && (path === l.match || path.startsWith(`${l.match}/`)) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="inspect"
      aria-expanded="false"
      aria-keyshortcuts="Shift+I"
      data-inspector-toggle
    >
      <svg class="icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M3 7h10v10H3z" />
        <path d="M7 3h10v10" />
      </svg>
      <span class="label">{copy.inspector.open}</span>
      <kbd aria-hidden="true">{copy.inspector.shortcut}</kbd>
    </button>
  </div>
</header>

<script>
  // Opens the Inspector (decision 44): the button, any [data-inspector-open], Shift+I or ?inspect. Vue and the
  // panel download only now, on first use; hovering the button starts that download early.
  type Handle = { close(): void };
  // Same rule as isTypingTarget in src/lib/keyboard.ts, kept local: this script runs on every page,
  // and importing a helper shared with Precrease search would add a chained request to each one.
  const isTypingTarget = (el: EventTarget | null) =>
    el instanceof HTMLElement &&
    (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName));
  const button = document.querySelector<HTMLButtonElement>('[data-inspector-toggle]');
  let handle: Handle | null = null;
  let loading = false;
  const load = () => import('../inspector/mount');

  async function open(trigger: HTMLElement | null) {
    if (handle || loading) return;
    loading = true;
    try {
      const { openInspector } = await load();
      handle = await openInspector(trigger, () => {
        handle = null;
        button?.setAttribute('aria-expanded', 'false');
      });
      button?.setAttribute('aria-expanded', 'true');
    } catch (error) {
      // Offline, or the manifest didn't arrive: the page stays as it was, and the next try retries.
      console.warn('Inspector could not open', error);
    } finally {
      loading = false;
    }
  }
  const toggle = (trigger: HTMLElement | null) => (handle ? handle.close() : open(trigger));

  button?.addEventListener('click', () => toggle(button));
  // Other openers on the page (the home hero's "See how this page is built") share the same panel.
  for (const opener of document.querySelectorAll<HTMLElement>('[data-inspector-open]')) {
    opener.addEventListener('click', () => toggle(opener));
    opener.addEventListener('pointerenter', () => void load(), { once: true });
  }
  button?.addEventListener('pointerenter', () => void load(), { once: true });
  addEventListener('keydown', (e) => {
    if (
      !e.shiftKey ||
      e.ctrlKey ||
      e.metaKey ||
      e.altKey ||
      e.key.toLowerCase() !== 'i' ||
      isTypingTarget(e.target)
    )
      return;
    e.preventDefault();
    // Focus goes back where it was on close; with nothing focused, to the Inspect button.
    const active = document.activeElement;
    toggle(active instanceof HTMLElement && active !== document.body ? active : button);
  });
  if (new URLSearchParams(location.search).has('inspect')) void open(button);
</script>

<style>
  .mast {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
  }
  .mast .wrap {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
  }
  .me {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-1);
  }
  nav a {
    font-size: var(--size-sm);
    color: var(--color-mute);
    text-decoration: none;
    padding: 0 var(--space-2);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-ui);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .inspect {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    margin-left: var(--space-2);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--size-sm);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--motion-ease-out);
  }
  .inspect:hover,
  .inspect[aria-expanded='true'] {
    border-color: var(--color-accent-ui);
  }
  .inspect .icon {
    display: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .inspect kbd {
    font: 500 var(--type-caption);
    color: var(--color-mute);
  }
  @media (pointer: coarse) {
    .inspect kbd {
      display: none;
    }
  }
  /* Narrow screens: the button keeps its name for assistive tech but shows only the layers icon. */
  @media (max-width: 560px) {
    .inspect {
      flex-shrink: 0;
      width: 40px;
      min-height: 40px;
      padding: 0;
      justify-content: center;
    }
    .inspect .icon {
      display: block;
    }
    .inspect .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .inspect kbd {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .me span {
      display: none;
    }
    nav a {
      padding: 0 var(--space-1);
    }
  }
  /* The narrowest phones (320 px): smaller links so the logo, the menu and Inspect share one row. */
  @media (max-width: 380px) {
    .mast .wrap {
      gap: var(--space-2);
    }
    nav a {
      font-size: var(--size-xs);
    }
  }
</style>
