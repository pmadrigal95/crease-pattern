---
/**
 * The footer, on every page (design debt phase 4, option A): it hangs from a valley fold, a dashed
 * crease across the page with the fox folded on it, the site's thesis one last time. Below it,
 * who this is and where else to find them, then the licences.
 */
import site from '../../../site.config';
import FoxMark from './FoxMark.astro';
import { copyFor } from '../../i18n/dictionary';
import { publicPath } from '../../lib/url';
import { LOCALES, languageLinks, langOf, localize, type Translations } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const copy = copyFor(lang);

interface Props {
  name: string;
  role: string;
  location: string;
  contact: { email: string; linkedin: string; github: string };
  /** Where this page lives in each language (src/i18n/routing.ts), for the language switch. */
  translations: Translations;
}
const { name, role, location, contact, translations } = Astro.props;
const path = publicPath(Astro.url.pathname);
// Each language by its own name, the current one marked (M5).
const languages = languageLinks(path, translations, lang).map((l) => ({ ...l, name: LOCALES[l.lang].name }));
const year = new Date().getFullYear();
---

<footer class="foot" data-inspect="SiteFooter">
  <div class="wrap">
    <div class="crease" aria-hidden="true">
      <span class="mark">
        <FoxMark size={40} />
      </span>
    </div>
    <div class="grid">
      <p class="who">
        <strong>{name}</strong>
        <span>
          {role} · {location}
        </span>
      </p>
      <ul class="links" aria-label={copy.labels.elsewhere}>
        <li>
          <a href={`mailto:${contact.email}`}>{copy.footer.email}</a>
        </li>
        <li>
          <a href={contact.linkedin}>LinkedIn</a>
        </li>
        <li>
          <a href={contact.github}>GitHub</a>
        </li>
        <li>
          <a href={localize('/colophon', lang)}>{copy.footer.colophon}</a>
        </li>
        <li>
          <a href={localize('/privacy', lang)}>{copy.footer.privacy}</a>
        </li>
        <li>
          <a href={site.repository}>{copy.footer.source}</a>
        </li>
      </ul>
    </div>
    <ul class="langs" aria-label={copy.lang.label}>
      {languages.map((l) => (
        <li>
          {l.current ? (
            <a href={l.href} lang={l.lang} aria-current="true">
              {l.name}
            </a>
          ) : (
            <a href={l.href} lang={l.lang} hreflang={l.lang} data-lang-switch={l.lang}>
              {l.name}
            </a>
          )}
        </li>
      ))}
    </ul>
    <p class="legal">
      <span>
        © {year} {name}
      </span>
      <span aria-hidden="true"> · </span>
      <a href={`${site.repository}/blob/main/LICENSE.md`}>{copy.footer.license}</a>
    </p>
  </div>
</footer>

<style>
  .wrap {
    padding-block: var(--space-12) var(--space-12);
    font-size: var(--size-sm);
    color: var(--color-mute);
  }
  /* The valley fold: dashed, in the fold colour, with the fox sitting on it. */
  .crease {
    position: relative;
    height: 1px;
    margin-bottom: var(--space-12);
    background: repeating-linear-gradient(90deg, var(--color-accent-ui) 0 7px, transparent 7px 13px);
  }
  .mark {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    padding-inline: var(--space-2);
    background: var(--color-bg);
    transform: translate(-50%, -50%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6) var(--space-12);
    align-items: start;
  }
  .who {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }
  .who strong {
    color: var(--color-ink);
    font-weight: 600;
    font-size: var(--size-md);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0 var(--space-8);
  }
  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .links a:hover,
  .legal a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .langs {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
  }
  .langs a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .langs a:hover {
    color: var(--color-ink);
  }
  .langs a[aria-current] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-ui);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .legal {
    margin: var(--space-2) 0 0;
    font: var(--size-xs) var(--font-mono);
  }
  .legal a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .links {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
    }
  }
</style>
