---
/**
 * The career as a paper ridge (portfolio-discovery/31-changelog-plan.md), on the home page. Each
 * release is its volcano, folded paper at its real height, placed along time; the route walks
 * the skyline they make and ends on the last summit, now. Moving along it (pointer, finger or the
 * arrow keys) shows that release above the drawing: its version, height, theme, years and the
 * releases inside it. The identity picks the paper: plates (Basalt & glacier), washi fibers
 * (Washi & asagi), contour lines every 250 m (Contour lines). Geometry: src/lib/ridge.ts.
 *
 * Without JavaScript it's complete: the current release is shown, and the drawing is still.
 * Two drawings, wide and narrow, because SVG text doesn't scale down gracefully; CSS shows one.
 * Screen readers get one sentence that says the whole climb, and each release as it's reached.
 * Positions are SVG attributes, never inline styles, so the CSP stays strict.
 */
import { careerFor, climbs, currentVersion, releasesNewestFirst } from '../../lib/career';
import { ridge, type RidgeFrame } from '../../lib/ridge';
import RidgeDrawing from './RidgeDrawing.astro';
import { copyFor, fill } from '../../i18n/dictionary';
import { formatList, formatNumber } from '../../lib/format';
import { langOf } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const t = copyFor(Astro.currentLocale).home.changelog;

const career = careerFor(lang);
const data = climbs(career);
const version = currentVersion(career);
const current = data.at(-1)!.major;
const releases = new Map(releasesNewestFirst(career).map((r) => [r.major, r]));
const frames = {
  wide: { width: 1000, height: 340, baseline: 300, top: 24, floorM: 900, ceilingM: 3600 },
  narrow: { width: 400, height: 280, baseline: 244, top: 20, floorM: 900, ceilingM: 3600 },
} satisfies Record<string, RidgeFrame>;
const drawings = (['wide', 'narrow'] as const).map((name) => ({
  name,
  frame: frames[name],
  r: ridge(data, frames[name]),
}));
const names = new Map(data.map((c) => [c.major, c.codename]));
const heights = new Map(
  data.map((c) => [c.major, fill(t.elevation, { elevation: formatNumber(c.elevationM, lang) })]),
);
const metres = (m: number) => fill(t.elevation, { elevation: formatNumber(m, lang) });
/** "3.2.0" → "v3.2"; "0.0.1" stays whole. */
const short = (v: string) => `v${v.replace(/\.0$/, '')}`;
const eras = data.map((c) => {
  const entries = releases.get(c.major)!.entries;
  const end = c.major === current ? t.present : Math.floor(c.end);
  return {
    ...c,
    entries,
    tag:
      c.major === current
        ? fill(t.profile.now, { version, codename: c.codename })
        : `v${entries[0]!.version.split('.').slice(0, 2).join('.')} · ${c.codename}`,
    span: `${Math.floor(c.start)} – ${end}`,
    // What a screen reader hears when the route reaches it.
    said: `${c.codename}, ${fill(t.elevation, { elevation: formatNumber(c.elevationM, lang) })}, ${c.theme}, ${Math.floor(c.start)} – ${end}`,
  };
});
const summary = fill(t.profile.summary, {
  from: Math.floor(data[0]!.start),
  releases: formatList(
    data.map((c) =>
      fill(t.profile.release, {
        major: c.major,
        codename: c.codename,
        elevation: fill(t.elevation, { elevation: formatNumber(c.elevationM, lang) }),
        theme: c.theme,
      }),
    ),
    lang,
  ),
  version,
});
---

<figure class="altitude" data-inspect="AltitudeProfile" data-ridge data-label={t.profile.label}>
  <div class="heads">
    {eras.map((e) => (
      <div class:list={['head', { away: e.major !== current }]} data-era={e.major} data-said={e.said}>
        <div>
          <p class="tag">{e.tag}</p>
          <p class="alt">
            {formatNumber(e.elevationM, lang)}
            <span class="unit">m</span>
          </p>
          <p class="theme">
            {e.theme} · {e.span}
          </p>
        </div>
        <ul class="releases">
          {e.entries.slice(0, 4).map((en) => (
            <li>
              <span class="v">{short(en.version)}</span>
              <span>
                <span class="title">{en.title}</span> · <span class="org">{en.org}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="stage" data-stage>
    <p class="hint" data-hint hidden>
      ← {t.profile.walk} →
    </p>
    {drawings.map(({ name, frame, r }) => (
      <RidgeDrawing
        name={name}
        frame={frame}
        ridge={r}
        names={names}
        heights={heights}
        metres={metres}
        current={current}
      />
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
  <figcaption class="sr-only">{summary}</figcaption>
</figure>

<script>
  // Walking the route (src/components/site/AltitudeProfile.astro). Self-contained (ENGINEERING.md,
  // "Browser scripts"): Astro inlines it on the home page.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-ridge]')) {
    const stage = figure.querySelector<HTMLElement>('[data-stage]')!;
    const heads = [...figure.querySelectorAll<HTMLElement>('[data-era]')];
    const said = figure.querySelector<HTMLElement>('[data-live]')!;
    const label = figure.querySelector<HTMLElement>('[data-hint]');
    // The drawing on screen: wide or narrow, as CSS decides.
    const drawing = () =>
      [...figure.querySelectorAll<SVGSVGElement>('svg.drawing')].find((s) => s.getClientRects().length);
    let at = -1;
    const show = (x: number) => {
      const svg = drawing();
      if (!svg) return;
      const route = svg.querySelector<SVGPathElement>('[data-route]')!;
      const end = Number(svg.dataset.end);
      x = Math.max(0, Math.min(end, x));
      // The marker's height on the route: x only grows along it, so halve the length until it's there.
      const length = route.getTotalLength();
      let lo = 0;
      let hi = length;
      for (let k = 0; k < 18; k++) {
        const mid = (lo + hi) / 2;
        if (route.getPointAtLength(mid).x < x) lo = mid;
        else hi = mid;
      }
      const y = route.getPointAtLength(hi).y;
      const marker = svg.querySelector('[data-marker]')!;
      const line = marker.querySelector('line')!;
      const dot = marker.querySelector('circle')!;
      line.setAttribute('x1', x.toFixed(1));
      line.setAttribute('x2', x.toFixed(1));
      line.setAttribute('y1', y.toFixed(1));
      dot.setAttribute('cx', x.toFixed(1));
      dot.setAttribute('cy', y.toFixed(1));
      svg.querySelector('[data-walked]')!.setAttribute('width', x.toFixed(1));
      const peaks = [...svg.querySelectorAll<SVGGElement>('.peak')];
      const index = Math.max(
        0,
        peaks.findLastIndex((p) => x >= Number(p.dataset.x0)),
      );
      if (index === at) return;
      at = index;
      peaks.forEach((p, i) => p.classList.toggle('on', i === index));
      heads.forEach((h, i) => h.classList.toggle('away', i !== index));
      said.textContent = heads[index]!.dataset.said ?? '';
    };
    const summitOf = (i: number) =>
      Number(drawing()?.querySelectorAll<SVGGElement>('.peak')[i]?.dataset.summit);
    const toNow = () => show(Number(drawing()?.dataset.end));
    const xOf = (e: PointerEvent) => {
      const svg = drawing()!;
      const box = svg.getBoundingClientRect();
      return ((e.clientX - box.left) / box.width) * svg.viewBox.baseVal.width;
    };

    stage.tabIndex = 0;
    stage.setAttribute('role', 'group');
    stage.setAttribute('aria-label', figure.dataset.label ?? '');
    stage.classList.add('walkable');
    if (label) label.hidden = false;
    stage.addEventListener('pointermove', (e) => show(xOf(e)));
    stage.addEventListener('pointerdown', (e) => {
      stage.setPointerCapture(e.pointerId);
      show(xOf(e));
    });
    stage.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') toNow();
    });
    stage.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowLeft: -1, Home: -heads.length, End: heads.length }[e.key];
      if (step === undefined) return;
      e.preventDefault();
      const i = Math.max(0, Math.min(heads.length - 1, at + step));
      show(summitOf(i));
    });
    // The route starts at now, where the page was drawn.
    toNow();
    // Wide or narrow can change under the visitor: start again at now.
    matchMedia('(max-width: 719px)').addEventListener('change', () => {
      at = -1;
      toNow();
    });
  }
</script>

<style>
  .altitude {
    margin: var(--space-8) 0 0;
  }
  /* Above the drawing: the release the route is on. */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: end;
    gap: var(--space-4) var(--space-12);
    min-height: 168px;
  }
  /* Every release's head in the same place, as tall as the tallest: walking never moves the page.
     The one the route is on fades in; the others stay laid out but unseen and unheard (visibility
     hides them from assistive tech too). */
  .heads {
    display: grid;
  }
  .heads > .head {
    grid-area: 1 / 1;
    transition: opacity var(--motion-fast) var(--motion-ease-out);
  }
  .head.away {
    visibility: hidden;
    opacity: 0;
  }
  .tag {
    margin: 0;
    font: 600 var(--size-xs) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .alt {
    margin: var(--space-2) 0 0;
    font: 600 clamp(3rem, 7vw, 5.25rem) / 0.9 var(--font-sans);
    letter-spacing: -0.045em;
  }
  .unit {
    margin-left: 0.12em;
    font-size: 0.32em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-mute);
  }
  .theme {
    margin: var(--space-3) 0 0;
    color: var(--color-mute);
  }
  .releases {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .releases li {
    display: grid;
    grid-template-columns: 4.2em minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--color-rule);
  }
  .releases .v {
    font: 600 var(--size-xs) / 1.4 var(--font-mono);
    color: var(--color-accent);
  }
  .releases .title {
    font-weight: 600;
  }
  .releases .org {
    color: var(--color-mute);
  }

  /* The drawing. */
  .stage {
    position: relative;
    margin-top: var(--space-6);
    border-radius: 4px;
    outline-offset: 6px;
  }
  .stage.walkable {
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .stage:focus-visible {
    outline: 2px solid var(--color-accent-ui);
  }
  .hint {
    position: absolute;
    top: -4px;
    right: 0;
    margin: 0;
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
  @media (prefers-reduced-motion: reduce) {
    .heads > .head {
      transition: none;
    }
  }
  @media (max-width: 719px) {
    .head {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hint {
      display: none;
    }
  }
</style>
