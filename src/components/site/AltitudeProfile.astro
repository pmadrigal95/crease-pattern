---
/**
 * The career as an elevation chart (design debt phase 2), on the home page. It reads like the
 * elevation chart of a workout: one smooth line in the identity's accent with a fill that fades
 * to the baseline, three quiet altitude guides, the release names along the axis, and one large
 * readout. The readout shows the current release; pointing at a stretch shows that one instead.
 * Geometry comes from src/lib/altitude.ts; this file only draws it.
 *
 * Two drawings, wide and narrow, because SVG text doesn't scale down gracefully. CSS shows one;
 * the other is display: none, so it's hidden from screen readers too. Screen readers get one
 * sentence that says the whole chart, so the drawing itself is aria-hidden.
 *
 * Static SVG, no JavaScript: the pointer readout is CSS (:hover and :has). Positions are SVG
 * attributes, never inline styles, so the CSP stays strict.
 */
import { climbs, currentVersion } from '../../lib/career';
import { profile, type Frame } from '../../lib/altitude';
import { copy, fill } from '../../lib/copy';
import { formatList, formatNumber } from '../../lib/format';

const t = copy.home.changelog;
const data = climbs();
const version = currentVersion();
const frames = {
  wide: {
    width: 1000,
    height: 360,
    top: 120,
    bottom: 44,
    right: 64,
    floorM: 900,
    ceilingM: 3600,
    axisFont: 13,
  },
  narrow: {
    width: 360,
    height: 300,
    top: 104,
    bottom: 38,
    right: 44,
    floorM: 900,
    ceilingM: 3600,
    axisFont: 11,
  },
} satisfies Record<string, Frame>;
const drawings = (['wide', 'narrow'] as const).map((name) => ({
  name,
  frame: frames[name],
  p: profile(data, frames[name]),
}));
const byMajor = new Map(data.map((c) => [c.major, c]));
const current = data[data.length - 1]!.major;
const span = (major: number) => {
  const c = byMajor.get(major)!;
  return `${Math.floor(c.start)} – ${major === current ? t.present : Math.floor(c.end)}`;
};
const summary = fill(t.profile.summary, {
  from: Math.floor(data[0]!.start),
  releases: formatList(
    data.map((c) =>
      fill(t.profile.release, {
        major: c.major,
        codename: c.codename,
        elevation: fill(t.elevation, { elevation: formatNumber(c.elevationM) }),
        theme: c.theme,
      }),
    ),
  ),
  version,
});
---

<figure class="altitude" data-inspect="AltitudeProfile">
  {drawings.map(({ name, frame, p }) => (
    <svg
      class={`drawing ${name}`}
      viewBox={`0 0 ${frame.width} ${frame.height}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id={`altitude-fill-${name}`} x1="0" y1="0" x2="0" y2="1">
          <stop class="fill-top" offset="0" />
          <stop class="fill-bottom" offset="1" />
        </linearGradient>
      </defs>

      {p.guides.map((g) => (
        <g>
          <line class="guide" x1="0" x2={p.plotRight} y1={g.y} y2={g.y} />
          <text class="guide-label" x={p.plotRight + 8} y={g.y} dy="0.35em">
            {fill(t.elevation, { elevation: formatNumber(g.m) })}
          </text>
        </g>
      ))}
      {p.stretches.slice(1).map((s) => (
        <line class="crease" x1={s.x0} x2={s.x0} y1={frame.top - 16} y2={p.baseline} />
      ))}
      <line class="axis" x1="0" x2={p.plotRight} y1={p.baseline} y2={p.baseline} />

      <path class="area" d={p.area} fill={`url(#altitude-fill-${name})`} />
      <path class="line" d={p.line} pathLength="1" />

      {p.stretches.map((s) => {
        const c = byMajor.get(s.major)!;
        const isCurrent = s.major === current;
        const mark = isCurrent ? p.here : s.peak;
        return (
          <g class={isCurrent ? 'stretch current' : 'stretch'}>
            <rect class="zone" x={s.x0} y="0" width={s.x1 - s.x0} height={frame.height} />
            <text
              class="axis-name"
              text-anchor="middle"
              x={s.labelX}
              y={p.baseline + (name === 'wide' ? 26 : 22)}
            >
              {s.fullName ? c.codename : `v${c.major}`}
            </text>
            <g class="marker">
              <line class="marker-rule" x1={mark.x} x2={mark.x} y1={mark.y} y2={p.baseline} />
              <circle class="marker-halo" cx={mark.x} cy={mark.y} r="8" />
              <circle class="marker-dot" cx={mark.x} cy={mark.y} r="4.5" />
            </g>
            <g class="readout">
              <text class="readout-caption" x="0" y={name === 'wide' ? 18 : 16}>
                {isCurrent
                  ? fill(t.profile.now, { version, codename: c.codename.toUpperCase() })
                  : `v${c.major} · ${c.codename.toUpperCase()}`}
              </text>
              <text x="0" y={name === 'wide' ? 66 : 56}>
                <tspan class="readout-value">{formatNumber(c.elevationM)}</tspan>
                <tspan class="readout-unit"> m</tspan>
              </text>
              <text class="readout-detail" x="0" y={name === 'wide' ? 92 : 80}>
                {c.theme} · {span(c.major)}
              </text>
            </g>
          </g>
        );
      })}
    </svg>
  ))}
  <figcaption class="sr-only">{summary}</figcaption>
</figure>

<style>
  .altitude {
    margin: 0;
  }
  .drawing {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .narrow {
    display: none;
  }
  @media (max-width: 719px) {
    .wide {
      display: none;
    }
    .narrow {
      display: block;
    }
  }

  /* The fill fades from the accent to nothing, so the line carries the shape. */
  .fill-top {
    stop-color: var(--color-accent-ui);
    stop-opacity: 0.32;
  }
  .fill-bottom {
    stop-color: var(--color-accent-ui);
    stop-opacity: 0;
  }
  .line {
    fill: none;
    stroke: var(--color-accent-ui);
    stroke-width: 2.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .guide,
  .axis {
    stroke: var(--color-rule);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .axis {
    stroke: var(--color-mute);
    opacity: 0.5;
  }
  /* Where each release starts: a crease, dashed like a valley fold, barely there. */
  .crease {
    stroke: var(--color-rule);
    stroke-width: var(--stroke-crease);
    stroke-dasharray: 4 5;
    vector-effect: non-scaling-stroke;
  }
  text {
    font-family: var(--font-sans);
    fill: var(--color-mute);
    font-variant-numeric: tabular-nums;
  }
  .guide-label {
    font: 11px var(--font-mono);
  }
  .axis-name {
    font-size: 13px;
    font-weight: 500;
  }
  .narrow .axis-name {
    font-size: 11px;
  }

  /* The readout and the marker belong to one stretch at a time: the current release, or the one
     under the pointer. */
  .zone {
    fill: transparent;
  }
  .marker,
  .readout {
    opacity: 0;
    transition: opacity var(--motion-fast) var(--motion-ease-out);
    pointer-events: none;
  }
  .stretch.current .marker,
  .stretch.current .readout,
  .stretch:hover .marker,
  .stretch:hover .readout {
    opacity: 1;
  }
  .drawing:has(.stretch:not(.current):hover) .stretch.current .marker,
  .drawing:has(.stretch:not(.current):hover) .stretch.current .readout {
    opacity: 0;
  }
  .stretch.current .axis-name,
  .stretch:hover .axis-name {
    fill: var(--color-ink);
    font-weight: 600;
  }
  .drawing:has(.stretch:not(.current):hover) .stretch.current .axis-name {
    fill: var(--color-mute);
    font-weight: 500;
  }
  .marker-rule {
    stroke: var(--color-accent-ui);
    stroke-width: var(--stroke-crease);
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }
  .marker-halo {
    fill: var(--color-bg);
  }
  .marker-dot {
    fill: var(--color-accent-ui);
  }
  .readout-caption {
    font: 600 12px var(--font-mono);
    letter-spacing: 0.06em;
    fill: var(--color-accent);
  }
  /* Proportional figures for the big number: tabular ones leave gaps around the comma. */
  .readout-value {
    font-variant-numeric: proportional-nums;
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.03em;
    fill: var(--color-ink);
  }
  .readout-unit {
    font-size: 22px;
    font-weight: 500;
  }
  .readout-detail {
    font-size: 14px;
  }
  .narrow .readout-caption {
    font-size: 11px;
  }
  .narrow .readout-value {
    font-size: 40px;
  }
  .narrow .readout-unit {
    font-size: 18px;
  }
  .narrow .readout-detail {
    font-size: 13px;
  }

  /* The one moment of motion on the home page: the line draws itself as the chart scrolls in
     (decision 42). Longhands, with the timeline through a variable: the CSS minifier otherwise
     folds animation-timeline into the shorthand, which browsers reject. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .altitude {
        view-timeline-name: --altitude;
      }
      .line {
        --altitude-timeline: --altitude;
        stroke-dasharray: 1;
        animation-name: line-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--altitude-timeline);
        animation-range: entry 10% cover 40%;
      }
    }
  }
  @keyframes line-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
