---
/**
 * The contact postcard's picture side (ContactPostcard.astro): the Irazú in contour lines, from the
 * same Copernicus grid as the 404's map and the 3D scenes (src/lib/irazu-map.ts), with the
 * greeting printed over it. Drawn at build time; the postcard names it for screen readers.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { copyFor, fill } from '../../i18n/dictionary';
import { formatNumber } from '../../lib/format';
import { IRAZU } from '../../lib/identity-scenes';
import { irazuMap } from '../../lib/irazu-map';
import { langOf } from '../../i18n/routing';
const lang = langOf(Astro.currentLocale);
const p = copyFor(Astro.currentLocale).home.contact.postcard;
const file = readFileSync(join(process.cwd(), 'src/assets/scenes/irazu-dem.bin'));
const map = irazuMap(new Uint16Array(file.buffer, file.byteOffset, file.byteLength / 2));
---

<svg
  class="irazu"
  viewBox={`0 0 ${map.size} ${map.size}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  data-inspect="PostcardFront"
>
  {map.lines.map((l) => (
    <path class:list={['contour', { major: l.major }]} d={l.d} />
  ))}
  <circle class="summit" cx={map.summit.x} cy={map.summit.y} r="5"></circle>
</svg>
<p class="greetings" aria-hidden="true">
  {p.greetings}
</p>
<p class="caption" aria-hidden="true">
  {fill(p.picture, { elevation: formatNumber(IRAZU.summit, lang) })}
</p>

<style>
  .irazu {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .contour {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.7;
    opacity: 0.55;
  }
  .contour.major {
    stroke-width: 1.3;
    opacity: 0.9;
  }
  .summit {
    fill: var(--color-accent-ui);
  }
  .greetings,
  .caption {
    position: absolute;
    left: var(--space-8);
    margin: 0;
    padding: 4px 10px;
    background: var(--color-surface);
  }
  .greetings {
    bottom: calc(var(--space-8) + 2.4rem);
    font:
      italic 300 clamp(1.75rem, 3.4vw, 2.75rem) / 1.1 'Newsreader Home',
      'Iowan Old Style',
      'Palatino Linotype',
      Georgia,
      serif;
  }
  .caption {
    bottom: var(--space-8);
    font: 500 var(--size-xs) var(--font-mono);
    color: var(--color-mute);
  }
</style>
