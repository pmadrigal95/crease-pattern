---
/**
 * The Threads essay's timeline (Crease No. 002, section 2): one lane per worker for one run of
 * the chosen model, each task a block, copies in their own colour, and the wait before a worker
 * starts as a faint bar. Drawn from the spans the workers record (protocol.ts, `Span`) on one
 * shared clock, so what you see is what happened.
 */
import { copy } from '../../lib/copy';
import { MODELS } from '../../lib/threads/protocol';

const t = copy.precrease.threads;
---

<figure
  class="timeline"
  data-threads-timeline
  data-strings={JSON.stringify(t)}
  data-inspect="ThreadsTimeline"
>
  <fieldset class="models">
    <legend class="sr-only">{t.modelLabel}</legend>
    {MODELS.map((model, i) => (
      <label>
        <input type="radio" name="timeline-model" value={model} checked={i === 3} />
        <span>{t.models[model]}</span>
      </label>
    ))}
  </fieldset>
  <svg class="lanes" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true" data-lanes></svg>
  <ol class="names" data-names aria-hidden="true"></ol>
  <p class="summary" data-summary aria-live="polite"></p>
  <ul class="legend" aria-hidden="true">
    <li>
      <span class="swatch work"></span>
      {t.legendWork}
    </li>
    <li>
      <span class="swatch copy"></span>
      {t.legendCopy}
    </li>
    <li>
      <span class="swatch start"></span>
      {t.legendStart}
    </li>
  </ul>
  <button type="button" class="run" data-run>
    {t.run}
  </button>
  <noscript>
    <p class="summary">{t.needsJs}</p>
  </noscript>
</figure>

<style>
  .timeline {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-family: var(--font-sans);
  }
  .models {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .models label {
    position: relative;
  }
  .models input {
    position: absolute;
    opacity: 0;
  }
  .models span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-size: var(--size-sm);
    cursor: pointer;
  }
  .models input:checked + span {
    background: var(--color-ink);
    color: var(--color-bg);
    box-shadow: none;
  }
  .models input:focus-visible + span {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 2px;
  }
  .lanes {
    display: block;
    width: 100%;
    height: auto;
    min-height: 3rem;
  }
  .names {
    display: none;
  }
  .summary {
    margin: 0;
    font-size: var(--size-sm);
    color: var(--color-mute);
  }
  .summary:empty {
    display: none;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font: var(--type-caption);
    color: var(--color-mute);
  }
  .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 6px;
    border-radius: 3px;
    vertical-align: -1px;
  }
  .swatch.work {
    background: var(--color-accent-ui);
  }
  .swatch.copy {
    background: var(--color-earth);
  }
  .swatch.start {
    background: var(--color-rule);
  }
  .lanes :global(.work) {
    fill: var(--color-accent-ui);
  }
  .lanes :global(.copy) {
    fill: var(--color-earth);
  }
  .lanes :global(.start) {
    fill: var(--color-rule);
  }
  .lanes :global(.lane-label) {
    font: 11px var(--font-mono);
    fill: var(--color-mute);
  }
  .run {
    justify-self: start;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-bg);
    font: 600 var(--size-md) var(--font-sans);
    cursor: pointer;
  }
  .run:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .run:focus-visible {
    outline: 2px solid var(--color-accent-ui);
    outline-offset: 2px;
  }
</style>

<script>
  import { formatDecimal } from '../../lib/format';
  import { fill } from '../../lib/template';
  // Type only: erased from the bundle, so the copy file still never reaches the browser.
  type ThreadsCopy = (typeof import('../../content/copy/en.json'))['precrease']['threads'];
  import { canRun, essayDepth, exclusive, getPool } from '../../lib/threads/client';
  import { essayProblem } from '../../lib/threads/essay';
  import type { Model } from '../../lib/threads/protocol';

  const NS = 'http://www.w3.org/2000/svg';

  for (const root of document.querySelectorAll<HTMLElement>('[data-threads-timeline]')) {
    const t = JSON.parse(root.dataset.strings ?? '{}') as ThreadsCopy;
    const svg = root.querySelector<SVGSVGElement>('[data-lanes]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-run]')!;
    for (const input of root.querySelectorAll<HTMLInputElement>('input[name="timeline-model"]'))
      if (!canRun(input.value as Model)) {
        input.disabled = true;
        input.parentElement!.title = t.unavailable;
        if (input.checked) root.querySelector<HTMLInputElement>('input[value="messages"]')!.checked = true;
      }

    const draw = async () => {
      const model = (root.querySelector<HTMLInputElement>('input[name="timeline-model"]:checked')?.value ??
        'messages') as Model;
      button.disabled = true;
      const report = await exclusive(async () => {
        const pool = getPool();
        await pool.run(model, essayProblem(essayDepth()));
        return pool.run(model, essayProblem(essayDepth()));
      });
      const span = report.endedAt - report.startedAt || 1;
      const lane = 24;
      const gap = 8;
      const label = 72;
      const width = 600;
      svg.setAttribute('viewBox', `0 0 ${width} ${report.spans.length * (lane + gap)}`);
      svg.replaceChildren();
      report.spans.forEach((spans, w) => {
        const y = w * (lane + gap);
        const text = document.createElementNS(NS, 'text');
        text.setAttribute('class', 'lane-label');
        text.setAttribute('x', '0');
        text.setAttribute('y', String(y + lane / 2 + 4));
        text.textContent = fill(t.worker, { n: w + 1 });
        svg.append(text);
        for (const s of spans) {
          const x = label + ((s.from - report.startedAt) / span) * (width - label);
          const w2 = Math.max(1, ((s.to - s.from) / span) * (width - label));
          const rect = document.createElementNS(NS, 'rect');
          rect.setAttribute('class', s.kind === 'work' ? 'work' : s.kind === 'copy' ? 'copy' : 'start');
          rect.setAttribute('x', String(Math.max(label, x)));
          rect.setAttribute('y', String(y + (s.kind === 'start' ? lane / 2 - 2 : 0)));
          rect.setAttribute('width', String(w2));
          rect.setAttribute('height', String(s.kind === 'start' ? 4 : lane));
          rect.setAttribute('rx', '2');
          svg.append(rect);
        }
      });
      const tasks = report.spans.map((s) => s.filter((x) => x.kind === 'work').length);
      summary.textContent = fill(t.summary, {
        model: t.models[model],
        ms: formatDecimal(span),
        tasks: tasks.join(' / '),
      });
      button.disabled = false;
      button.textContent = t.runAgain;
    };
    button.addEventListener('click', () => void draw());
    root
      .querySelectorAll('input[name="timeline-model"]')
      .forEach((i) => i.addEventListener('change', () => void draw()));
  }
</script>
