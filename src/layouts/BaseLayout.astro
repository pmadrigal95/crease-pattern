---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/origami.css';
import '../styles/buttons.css';
import site from '../../site.config';
import { getProfile } from '../lib/profile';
import { publicPath } from '../lib/url';
import { copyFor } from '../i18n/dictionary';
import { DEFAULT_LANG, LOCALES, langOf, type Lang, type Translations } from '../i18n/routing';
import WebAnalytics from '../components/site/WebAnalytics.astro';
// Written in TypeScript, inlined as the JavaScript type stripping leaves (scripts/inline-script.ts):
// the same output scripts/csp-hashes.ts hashes for the CSP.
import restoreIdentitySource from '../scripts/restore-identity.ts?raw';
import pageRevealSource from '../scripts/page-reveal.ts?raw';
import { toInlineScript } from '../../scripts/inline-script.ts';
import { speculationRules } from '../scripts/speculation-rules';
// Preloaded so text renders in its final font on first paint (no layout shift on swap).
import sansLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const restoreIdentityScript = toInlineScript(restoreIdentitySource);
const pageRevealScript = toInlineScript(pageRevealSource);

interface Props {
  title: string;
  description: string;
  /** Where this page lives in each language it exists in (PageLayout, src/i18n/routing.ts). */
  translations: Translations;
  /**
   * Absolute or root-relative URL of the social preview image (1200 × 630 PNG). Pages without one
   * of their own share the home page's card (src/pages/og/[page].png.ts), so every link shows one.
   */
  image?: string | undefined;
  /** Open Graph type: Precrease posts are articles, everything else a website. */
  type?: 'website' | 'article' | undefined;
}

const { title, description, translations, image = '/og/home.png', type = 'website' } = Astro.props;
const lang = langOf(Astro.currentLocale);
const canonical = new URL(publicPath(Astro.url.pathname), site.url);
// hreflang only for pages that exist in more than one language; x-default is the English one.
const alternates = Object.entries(translations) as [Lang, string][];
const profile = await getProfile(Astro.currentLocale);
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang} data-direction={site.visualDirection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Light and dark from the first paint, before any stylesheet: no white flash on a dark system. */}
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 &&
      alternates.map(([l, href]) => (
        <link rel="alternate" hreflang={LOCALES[l].htmlLang} href={new URL(href, site.url)} />
      ))}
    {alternates.length > 1 && translations[DEFAULT_LANG] && (
      <link rel="alternate" hreflang="x-default" href={new URL(translations[DEFAULT_LANG], site.url)} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The page-to-page fold waits until the main content is parsed, so it never unfolds onto a
         half-built page (no effect where cross-document view transitions aren't supported). */}
    <link rel="expect" href="#main" blocking="render" />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALES[lang].ogLocale} />
    <meta property="og:image" content={new URL(image, site.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The next page prerenders when a link shows intent (src/scripts/speculation-rules.ts). */}
    <script type="speculationrules" is:inline set:html={speculationRules} />
    {/* Page-specific hints, such as a preload for the page's first image. */}
    <slot name="head" />
  </head>
  <body>
    {/*
      First thing in <body>, not in <head>: Astro appends the CSP meta tag at the end of
      <head>, and a script placed before it would run unprotected. It still runs before
      any content is parsed, so there is no flash of the default identity.
    */}
    {/* Restores the visitor's identity and theme. Its CSP hash comes from scripts/csp-hashes.ts. */}
    <script is:inline set:html={restoreIdentityScript} />
    {/* Runs before first render: the page-to-page fold or the first-load entrance (decision 42). */}
    <script is:inline set:html={pageRevealScript} />
    <a class="skip-link" href="#main">
      {copyFor(lang).nav.skip}
    </a>
    <slot />
    <div class="vt-crease" aria-hidden="true"></div>
    <WebAnalytics />
  </body>
</html>
