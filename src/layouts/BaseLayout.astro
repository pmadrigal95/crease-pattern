---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import site from '../../site.config';
import { getProfile } from '../lib/profile';
// Same file scripts/csp-hashes.mjs hashes for the CSP; ?raw inlines it at build time.
import restoreIdentitySource from '../scripts/restore-identity.js?raw';
// Preloaded so text renders in its final font on first paint (no layout shift on swap).
import sansLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const restoreIdentityScript = restoreIdentitySource.trim();

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
}

const { title, description, lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const profile = await getProfile();
---

<!doctype html>
<html lang={lang} data-direction={site.visualDirection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <!--
      First thing in <body>, not in <head>: Astro appends the CSP meta tag at the end of
      <head>, and a script placed before it would run unprotected. It still runs before
      any content is parsed, so there is no flash of the default identity.
    -->
    <!-- Restores the visitor's identity and theme. Its CSP hash comes from scripts/csp-hashes.mjs. -->
    <script is:inline set:html={restoreIdentityScript} />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
