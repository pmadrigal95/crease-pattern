---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import site from '../../site.config';
import { getProfile } from '../lib/profile';
import { publicPath } from '../lib/url';
import WebAnalytics from '../components/site/WebAnalytics.astro';
// Same file scripts/csp-hashes.mjs hashes for the CSP; ?raw inlines it at build time.
import restoreIdentitySource from '../scripts/restore-identity.js?raw';
import pageRevealSource from '../scripts/page-reveal.js?raw';
// Preloaded so text renders in its final font on first paint (no layout shift on swap).
import sansLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const restoreIdentityScript = restoreIdentitySource.trim();
const pageRevealScript = pageRevealSource.trim();

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  /** Absolute or root-relative URL of the social preview image (1200 × 630 PNG). */
  image?: string | undefined;
  /** Open Graph type: Precrease posts are articles, everything else a website. */
  type?: 'website' | 'article' | undefined;
}

const { title, description, lang = 'en', image, type = 'website' } = Astro.props;
const canonical = new URL(publicPath(Astro.url.pathname), site.url);
const profile = await getProfile();
---

<!doctype html>
<html lang={lang} data-direction={site.visualDirection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, site.url)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <!-- Page-specific hints, such as a preload for the page's first image. -->
    <slot name="head" />
  </head>
  <body>
    <!--
      First thing in <body>, not in <head>: Astro appends the CSP meta tag at the end of
      <head>, and a script placed before it would run unprotected. It still runs before
      any content is parsed, so there is no flash of the default identity.
    -->
    <!-- Restores the visitor's identity and theme. Its CSP hash comes from scripts/csp-hashes.mjs. -->
    <script is:inline set:html={restoreIdentityScript} />
    <!-- Runs before first render: the page-to-page fold or the first-load entrance (decision 42). -->
    <script is:inline set:html={pageRevealScript} />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <div class="vt-crease" aria-hidden="true"></div>
    <WebAnalytics />
  </body>
</html>
