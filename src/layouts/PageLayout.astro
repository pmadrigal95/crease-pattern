---
import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/site/Masthead.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { getProfile } from '../lib/profile';

interface Props {
  /** Page title; the owner's name is appended unless `standalone` is set. */
  title: string;
  description: string;
  standalone?: boolean;
  image?: string | undefined;
  type?: 'website' | 'article' | undefined;
}
const { title, description, standalone = false, image, type } = Astro.props;
const profile = await getProfile();
const fullTitle = standalone ? title : `${title} · ${profile.name}`;
---

<BaseLayout title={fullTitle} description={description} image={image} type={type}>
  <slot name="head" slot="head" />
  <Masthead name={profile.name} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter name={profile.name} contact={profile.contact} />
</BaseLayout>
