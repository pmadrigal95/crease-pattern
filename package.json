{
  "name": "crease-pattern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal site of Pablo Madrigal: an inspectable design system with three identities.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "generate": "node scripts/build-tokens.mjs && node scripts/build-inspector-manifest.mjs && node scripts/component-usage.mjs",
    "predev": "node scripts/build-tokens.mjs && node scripts/build-inspector-manifest.mjs && node scripts/component-usage.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs && node scripts/build-inspector-manifest.mjs && node scripts/component-usage.mjs",
    "build": "astro build && node scripts/sync-inline-style-hashes.mjs && node scripts/build-search-index.mjs && node scripts/stamp-site-metrics.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:budgets": "node scripts/check-bundle-budgets.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:essay": "playwright test --config playwright.essay.config.ts",
    "lighthouse": "lhci autorun",
    "lighthouse:essay": "lhci autorun --config=lighthouserc.essay.json",
    "changeset": "changeset",
    "deploy": "pnpm build && wrangler deploy",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "bench:threads": "vitest run --config vitest.bench.config.ts",
    "preview:upload": "node scripts/preview-upload.mjs"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "^7.4.7",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
